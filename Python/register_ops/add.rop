// Add: ordinary addition (Appendix A, batch P2).

family Add(dst:Dst, x:Src, y:Src, fb:Fb<Binary>)
  exits(next, miss, again, raise, redirect) generic(Generic) ops(BINARY_OP);

point Add.BoxFailed(current, site, pending) keep(x, y) spent() defs();
point Add.OpFailed(current, site, pending) keep() spent(y, x) defs();
point Add.Done(current, next_head, clear) keep() spent(y, x) defs(dst);

// Integer rows

extern primitive both_inline_int(a:B, b:B) -> Bool
  effects()
  test(inline_int(a), inline_int(b))
  c PyValue_BothInlineInt as bool
  evidence(
    review: "Reviewed G0c2. pycore_value.h: (a & b) >= Py_INT_BASE on the two words.",
    contract: "No memory, no failure, no callback; true exactly when both words are"
              "inline ints (the AND has the top Py_INT_SHIFT bits set only if both do).",
    lowering: "jit_lower.c LOWERING(PyValue_BothInlineInt)",
    test: "test_ir_leaf CASES[PyValue_BothInlineInt]");

extern primitive int_scaled(v:B) -> Scaled51
  effects()
  requires(inline_int(v))
  c _PyValue_IntScaled as scalar
  evidence(
    review: "Reviewed G0c2. pycore_value.h: the word shifted left by Py_INT_SHIFT.",
    contract: "Inline int required (asserted); pure bit arithmetic.",
    lowering: "jit_lower.c LOWERING(_PyValue_IntScaled)",
    test: "test_ir_leaf CASES");

extern primitive from_int_scaled(s:Scaled51) -> O
  effects()
  ensures(result.inline_int(result))
  c _PyValue_FromIntScaled as value
  evidence(
    review: "Reviewed G0c2. pycore_value.h: ((uint64_t)s >> Py_INT_SHIFT) | Py_INT_BASE.",
    contract: "s is a multiple of 2**Py_INT_SHIFT (asserted). Never NULL, owns no"
              "count, no memory.",
    lowering: "jit_lower.c LOWERING(_PyValue_FromIntScaled)",
    test: "test_ir_leaf CASES[_PyValue_FromIntScaled]");

// The scaled sum: fits(s) when a + b does not overflow 64 bits; else
// overflow(w) with w the unscaled sum of the two int51s, which fits in 64
// bits and lies outside the int51 range.  The case carries the value its
// fact is about, so the fact stays unary.
extern primitive add_checked_scaled(a:Scaled51, b:Scaled51)
  cases(fits(s:Scaled51), overflow(w:I64))
  effects()
  ensures(overflow.outside_i51(w))
  c _PyValue_AddCheckedScaled as bool_out
  evidence(
    review: "F2. pycore_value.h: __builtin_add_overflow on the scaled words; the"
            "overflow case arithmetic-shifts each word back by Py_INT_SHIFT and adds.",
    contract: "Pure: no memory, no failure. false: *out is the scaled sum. true: *out"
              "is the exact sum of the two int51 values, which lies outside int51.",
    lowering: "jit_lower.c LOWERING(_PyValue_AddCheckedScaled): the add and a branch"
              "on overflow; the cold path leaves with the exact sum",
    test: "test_ir_leaf CASES[_PyValue_AddCheckedScaled] and test_jit_template"
          "test_add_checked_scaled, at the int51 boundaries");

extern helper box_i64(v:I64)
  cases(ok(z:O), err(e:Err))
  effects(allocates, raises)
  requires(outside_i51(v))
  ensures(ok.exact<int>(z))
  c _PyValue_BoxInt64 as value_or_null
  evidence(
    review: "Reviewed G0c2. Python/pyvalue.c: PyLong_FromLongLong then"
            "_PyValue_PointerSteal.",
    contract: "NULL with MemoryError set only if the allocation fails. The argument"
              "is outside the inline range (asserted), so the result is a new boxed"
              "int. No finalizer, no Python.");

extern helper value_binary_op(op:Enum<Numeric>, a:B, b:B)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  c value_binary_op as value_or_null
  evidence(
    review: "Reviewed G0c2 (Python/ceval.c): _PyValue_BinaryOps[op](lhs, rhs) ->"
            "PyNumber_* -> an nb_* slot -> any __add__ or the __r*__ fallback.",
    contract: "Both operands borrowed on every path; the result owned, or NULL with"
              "an exception set. Callbacks: arbitrary Python.");

// Calls value_binary_op once on the anchored operands.  A redirect that
// won while Python ran discharges the result that was not committed and
// hands the route back.
macro binary_at_origin(op:Enum<Numeric>, a:Anchors)
  cases(ok(z:O), err(e:Err), redirected(r:Route))
  effects(runs_python, raises, releases)
  feedback()
  borrows(a)
{
  entry():
    call value_binary_op(op, arg(a, 0), arg(a, 1)) {
      ok -> Check();
      err -> Failed();
    }
  Check(value:O):
    call redirect_status(frame) {
      running -> Done(value);
      redirected -> Moved(value);
    }
  Done(kept:O):
    exit ok(kept);
  Moved(r:Route, dropped:O):
    let _:Unit = discard_result(dropped);
    exit redirected(r);
  Failed(e:Err):
    exit err(e);
}

// Float rows (the admitted pair is two inline floats, or an inline float and
// an inline int)

extern helper float_operands(a:B, b:B) -> Bool
  effects()
  c _PyRop_FloatOperands as bool inline
  evidence(
    review: "Reviewed P2. pycore_value.h PyValue_FloatOperandsCheck.",
    contract: "A comparison of the two words: no memory, no failure, no callback.");

// The sum of an admitted pair: a double, boxed only when it is NaN
extern helper add_floats(a:B, b:B)
  cases(ok(z:O), err(e:Err))
  effects(allocates, raises)
  ensures(ok.exact<float>(z))
  c _PyRop_AddFloats as value_or_null inline
  evidence(
    review: "Reviewed P2. pycore_rop_rows.h: PyValue_FloatOperandValues, then"
            "PyValue_FromDouble, which allocates only for NaN.",
    contract: "The pair is admitted (asserted). NULL with MemoryError only if the"
              "NaN box fails. No finalizer, no Python.");

// Text rows

extern primitive both_exact_str(a:B, b:B) -> Bool
  effects()
  test(exact<str>(a), exact<str>(b))
  c _PyRop_BothExactStr as bool
  evidence(
    review: "Reviewed P2. pycore_rop_rows.h: both words are objects of exact type str.",
    contract: "Reads the two type words: no memory, no failure, no callback.",
    lowering: "none: the arm that uses it is shared and is not compiled inline",
    test: "test_rop_add");

extern helper concat_text(a:B, b:B)
  cases(ok(z:O), err(e:Err))
  effects(allocates, raises)
  requires(exact<str>(a), exact<str>(b))
  ensures(ok.exact<str>(z))
  c _PyRop_ConcatText as value_or_null
  evidence(
    review: "Reviewed P2. pycore_rop_rows.h: PyUnicode_Concat, then"
            "PyValue_FromNonNumberSteal.",
    contract: "Both operands exact str, borrowed. NULL with the exception set if the"
              "allocation fails or the result is too long. No finalizer, no Python.");

// Extended rows: a descriptor of two exact types and an action, in the entry

extern helper extension_applies(f:Fb<Binary>, a:B, b:B) -> Bool
  effects(reads)
  feedback(read(entry.descr))
  c _PyRop_ExtensionApplies as bool
  evidence(
    review: "Reviewed P2. pycore_rop_rows.h: the old _BINARY_OP_EXTEND guards.",
    contract: "True when both operands are objects of the descriptor's two exact"
              "types. Reads only. A descriptor is present on an entry that selected"
              "this arm; none gives false.");

extern helper run_extension(f:Fb<Binary>, a:B, b:B)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  feedback(read(entry.descr))
  c _PyRop_RunExtension as value_or_null
  evidence(
    review: "Reviewed P2. pycore_rop_rows.h: the descriptor's action on the two"
            "operand objects, the result as a value.",
    contract: "The operands are borrowed on every path; the result is owned, or NULL"
              "with an exception set. The action is a concatenation: it may allocate"
              "and run a collector's finalizers.");

// Records the descriptor's action once on the anchored operands, as
// binary_at_origin does for the generic operation.
macro extension_at_origin(f:Fb<Binary>, a:Anchors)
  cases(ok(z:O), err(e:Err), redirected(r:Route))
  effects(runs_python, raises, releases)
  feedback(read(entry.descr))
  borrows(a)
{
  entry():
    call run_extension(f, arg(a, 0), arg(a, 1)) {
      ok -> Check();
      err -> Failed();
    }
  Check(value:O):
    call redirect_status(frame) {
      running -> Done(value);
      redirected -> Moved(value);
    }
  Done(kept:O):
    exit ok(kept);
  Moved(r:Route, dropped:O):
    let _:Unit = discard_result(dropped);
    exit redirected(r);
  Failed(e:Err):
    exit err(e);
}

// Adaptation policy (addendum section 2)
// Finds the registered descriptor for two exact types and stores it in the
// entry: hit when one matches.
extern helper find_extension(f:Fb<Binary>, a:B, b:B)
  cases(hit(), absent())
  effects(reads, writes)
  feedback(write(entry.descr))
  c _PyRop_FindAddExtension as bool_cases
  evidence(
    review: "Reviewed P2. specialize.c binary_op_extended_specialization for NB_ADD.",
    contract: "No memory, no Python, no failure. Writes the entry's descriptor, or"
              "clears it when none matches.");

macro adapt_before_use_add(f:Fb<Binary>, x:Src, y:Src)
  cases(run(), changed(t:Ticket<Binary>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    branch both_inline_int(use(x), use(y)) -> Chosen(), Other();
  Chosen():
    let c:Candidate<Binary> = candidate(Add.Int);
    call install(site, f, c) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    branch float_operands(use(x), use(y)) -> ChosenFloat(), TryText();
  ChosenFloat():
    let cf:Candidate<Binary> = candidate(Add.Float);
    call install(site, f, cf) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryText():
    branch both_exact_str(use(x), use(y)) -> ChosenText(), TryExtended();
  ChosenText():
    let ct:Candidate<Binary> = candidate(Add.Text);
    call install(site, f, ct) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryExtended():
    call find_extension(f, use(x), use(y)) {
      hit -> ChosenExtended();
      absent -> NoArm();
    }
  ChosenExtended():
    let ce:Candidate<Binary> = candidate(Add.Extended);
    call install(site, f, ce) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoArm():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Binary>):
    exit changed(t);
  Run():
    exit run();
}

arm Add.Int inline
  effects(writes, allocates, raises, releases on (dst))
  feedback()
  exits(next, miss, raise)
  ensures(next.exact<int>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_inline_int(l, r) else miss;
    let a:Scaled51 = int_scaled(l);
    let b:Scaled51 = int_scaled(r);
    call add_checked_scaled(a, b) {
      fits -> Fits();
      overflow -> Overflow();
    }
  Fits(s:Scaled51):
    goto Finish(from_int_scaled(s));
  Overflow(full:I64):
    call box_i64(full) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Add.BoxFailed, e);
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Add.Done;
    exit next();
}

// Two admitted float or inline numbers: the sum is a float
arm Add.Float shared
  effects(writes, allocates, raises, releases on (dst))
  feedback()
  exits(next, miss, raise)
  ensures(next.exact<float>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard float_operands(l, r) else miss;
    call add_floats(l, r) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Add.BoxFailed, e);
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Add.Done;
    exit next();
}

// Two exact strings
arm Add.Text shared
  effects(writes, allocates, raises, releases on (dst))
  feedback()
  exits(next, miss, raise)
  ensures(next.exact<str>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_exact_str(l, r) else miss;
    call concat_text(l, r) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Add.BoxFailed, e);
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Add.Done;
    exit next();
}

// The operand types of the entry's registered descriptor
arm Add.Extended shared
  effects(runs_python, writes, allocates, raises, releases on (dst))
  feedback(read(entry.descr))
  exits(next, miss, raise, redirect)
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard extension_applies(fb, l, r) else miss;
    let a:Anchors = anchor_for_call([x, y]);
    call extension_at_origin(fb, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(y), spent(x), old(dst)] at Add.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(Add.OpFailed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

arm Add.Generic shared
  effects(runs_python, raises, releases on (dst))
  feedback(read(entry), write(entry), write(handler))
  exits(next, again, raise, redirect)
{
  entry():
    call adapt_before_use_add(fb, x, y) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Binary>):
    exit again(t);
  Run():
    let a:Anchors = anchor_for_call([x, y]);
    call binary_at_origin(NB_ADD, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(y), spent(x), old(dst)] at Add.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(Add.OpFailed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}
