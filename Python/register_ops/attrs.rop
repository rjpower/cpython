  Result(f:O, s:Maybe<O>):
    publish [callable = f, self_dst = s] retire [old(callable), old(self_dst)] at SuperMethod.Done;
    exit next();
  Failed(e:Err):
    exit raise(SuperMethod.Failed, e);
}

