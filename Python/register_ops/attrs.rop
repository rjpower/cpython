// SpecialLookup: the method of a special name on an object's type, for
// `with` and `async with` (enter and exit).  An unbound method comes with
// the receiver as its first argument; a bound one with no receiver.
family SpecialLookup(fn:Dst, self_dst:Maybe<Dst>, obj:Src, which:Enum<Special>)
  exits(next, raise, redirect);

point SpecialLookup.Done(current, next_head, clear) keep() spent(obj) defs(fn, self_dst);
point SpecialLookup.Failed(current, site, pending) keep() spent(obj) defs();

// The method and the receiver as an owner when the method is unbound.  A
// missing method raises the protocol's TypeError, with the suggestion of the
// asynchronous protocol when the type has that one.
extern helper value_lookup_special(o:B, which:Enum<Special>)
  cases(ok(f:O, s:Maybe<O>), err(e:Err))
  effects(runs_python, raises)
  c _PyRop_LookupSpecial as value_out_or_null
  evidence(
    review: "ceval.c _PyRop_LookupSpecial: _PyObject_LookupSpecialMethod on a counted copy of the receiver, then the error of _LOAD_SPECIAL: _PyEval_SpecialMethodCanSuggest picks error_suggestion or error.",
    contract: "The receiver is borrowed; the method owned and the self owned or absent, or NULL with an exception set. Callbacks: a descriptor's __get__.");

macro special_at_origin(which:Enum<Special>, a:Anchors)
  cases(ok(f:O, s:Maybe<O>), err(e:Err), redirected(r:Route))
  effects(runs_python, raises, releases)
  feedback()
  borrows(a)
{
  entry():
    call value_lookup_special(arg(a, 0), which) {
      ok -> Check();
      err -> Failed();
    }
  Check(callable:O, receiver:Maybe<O>):
    call redirect_status(frame) {
      running -> Done(callable, receiver);
      redirected -> Moved(callable, receiver);
    }
  Done(kept:O, self_kept:Maybe<O>):
    exit ok(kept, self_kept);
  Moved(r:Route, dropped:O, self_dropped:Maybe<O>):
    let _:Unit = discard_result(dropped);
    let _:Unit = discard_maybe_result(self_dropped);
    exit redirected(r);
  Failed(e:Err):
    exit err(e);
}

arm SpecialLookup.Generic shared
  effects(runs_python, raises, releases on (fn, self_dst))
  feedback()
  exits(next, raise, redirect)
{
  entry():
    let a:Anchors = anchor_for_call([obj]);
    call special_at_origin(which, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(f:O, s:Maybe<O>):
    publish [fn = f, self_dst = s]
      retire [roots(a), spent(obj), old(fn), old(self_dst)] at SpecialLookup.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [obj], e);
    exit raise(SpecialLookup.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}
