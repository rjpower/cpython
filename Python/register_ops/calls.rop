}

// The callable of a CallEx is a function with the standard vectorcall
extern helper py_callable_ex(fn:B) -> Bool
  effects(reads)
  c _PyRop_PyCallableEx as bool inline
  evidence(
    review: "2A. bytecodes.c: _CHECK_IS_PY_CALLABLE_EX.",
    contract: "Reads the word, the type and the vectorcall; no memory, no failure.");

extern helper not_py_callable_ex(fn:B) -> Bool
  effects(reads)
  c _PyRop_NotPyCallableEx as bool inline
  evidence(
    review: "2A. bytecodes.c: _CHECK_IS_NOT_PY_CALLABLE_EX.",
    contract: "Reads the word, the type and the vectorcall; no memory, no failure.");

// Adaptation evidence (specialize.c): the arm that the expanded call of fn
// stands for, with the binding plan of the arity and the code that the site
// sees in the site's entry
extern helper classify_call_ex(at:Site, f:Fb<Call>, fn:B, a:Args)
  cases(py(), nonpy(), other())
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry))
  c _PyRop_ClassifyCallEx as case_index
  evidence(
    review: "2A. specialize.c: the old _Py_Specialize_CallFunctionEx: a function"
            "with the standard vectorcall is py (CALL_EX_PY), any other object"
            "nonpy (CALL_EX_NON_PY_GENERAL).",
    contract: "Writes the site's entry (callable_type_version, func_version, plan)"
              "and sets no handler.  No Python runs.");

macro adapt_before_use_call_ex(f:Fb<Call>, fn:Src, a:Args)
  cases(run(), changed(t:Ticket<Call>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    call classify_call_ex(site, f, use(fn), a) {
      py -> Planned();
      nonpy -> Native();
      other -> Other();
    }
  Planned():
    let cp:Candidate<Call> = candidate(CallEx.Py);
    call install(site, f, cp) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Native():
    let cn:Candidate<Call> = candidate(CallEx.NonPy);
    call install(site, f, cn) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Call>):
    exit changed(t);
  Run():
    exit run();
}

arm CallEx.Generic split
  effects(runs_python, allocates, raises, polls, switches_frame, releases on (dst))
  feedback(read(entry), write(entry), write(handler), read(entry.func_version), read(entry.plan))
  exits(next, enter, raise, again, redirect)
{
  entry():
    call adapt_before_use_call_ex(fb, fn, args) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Call>):
    exit again(t);
  Run():
    let fo:O = dup(use(fn));
    let ko:O = hold_kwargs(frame, args);
    call star_tuple(thread, frame, fn, args) {
      ok -> Prepared(fo, ko);
      err -> TupleFailed(fo, ko);
    }
  TupleFailed(te:Err, tfo:O, tko:O):
    let tsaved:Err = retire_failed_held_ex(frame, fn, tfo, tko, args, te);
    exit raise(CallEx.Failed, tsaved);
  Prepared(tup:O, pfo:O, pko:O):
    branch python_target_held(thread, frame, pfo, args) -> Python(tup, pfo, pko), Native(tup, pfo, pko);
  Python(ptup:O, qfo:O, qko:O):
    call push_python_ex(thread, frame, fn, qfo, qko, ptup, args, fb) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume CallEx.Returned;
  Failed(e:Err):
    exit raise(CallEx.Failed, e);
  Native(ntup:O, nfo:O, nko:O):
    call call_native_ex(thread, frame, nfo, nko, ntup, args) {
      ok -> Result();
      err -> NativeFailed();
    }
  Result(z:O):
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at CallEx.Done;
    call end_poll(thread, frame, next_head) {
      ok -> Next();
      moved -> PollSwitched();
      err -> PollFailed();
    }
  Next():
    exit next();
  PollFailed(pe:Err):
    exit raise(CallEx.PollFailed, pe);
  NativeFailed(ne:Err):
    let saved:Err = retire_failed_args(frame, fn, args, ne);
    exit raise(CallEx.Failed, saved);
  PollSwitched(ps:Route):
    exit redirect(ps);
}


