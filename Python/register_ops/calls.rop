arm Call.Len split
  effects(writes, reads, runs_python, raises, allocates, releases on (dst))
  feedback()
  exits(next, raise, miss)
{
  entry():
    guard self_absent(frame, args) else miss;
    guard callee_is_len(thread, use(fn)) else miss;
    call call_len(frame, args) {
      ok -> Result();
      err -> Failed();
    }
  Result(z:O):
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_args(frame, fn, args, e);
