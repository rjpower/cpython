    guard default_eval_frame(thread) else miss;
    guard self_absent(frame, args) else miss;
    guard method_version(use(fn), fb) else miss;
    call push_python(thread, frame, fn, args) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume CallKw.Returned;
  Failed(e:Err):
    exit raise(CallKw.Failed, e);
}

