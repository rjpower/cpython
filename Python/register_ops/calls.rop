// Family interfaces of Appendix A, "Calls, frames, iteration, suspension,
// and observation".  Arms come with their batches.  Observation is a
// generated wrapper bound to a family and arm, not a family.

// A call word's poll: a flag of the word, set by the translator on the call
// that follows a special-method lookup, which `with` relies on to enter the
// body without a pending signal or collection running first.
enum Interrupt(INTERRUPTIBLE, UNINTERRUPTED);

// P4: positional calls, init cleanup, return

family Call(dst:Dst, fn:Src, args:Args, fb:Fb<Call>, interrupt:Enum<Interrupt>)
  exits(next, enter, raise, redirect, miss, again) generic(Generic)
  events(CALL, C_RETURN, C_RAISE) hot;

family InitResult(value:Src)
  exits(next, raise);

family Return(value:Src)
  exits(return, exit, raise, redirect)
  events(PY_RETURN) hot;

// The caller goes on here when the child returns: the child's value is dst
point Call.Returned(caller, next_head, clear) keep() spent(fn, args) defs(dst);
// A native call's result, or the end poll's failure after it was published
point Call.Done(current, next_head, clear) keep() spent(fn, args) defs(dst);
point Call.PollFailed(current, site, pending) keep() spent(fn, args) defs(dst);
// The call failed before it entered a frame or returned
point Call.Failed(current, site, pending) keep() spent(fn, args) defs();
// The PY_RETURN callback raised: the value was taken and is closed
point Return.EventFailed(current, site, pending) keep() spent(value) defs();
// The value has gone to the caller's return slot
point Return.Delivered(caller, resume_head, clear) keep() spent(value) defs();
// The generator's consumer raised as it completed: the error is the
// consumer's, at its origin
point Return.ConsumerFailed(consumer, saved_origin, pending) keep() spent(value) defs();
// __init__ returned None, or something else
point InitResult.Done(current, next_head, clear) keep() spent(value) defs();
point InitResult.Wrong(current, site, pending) keep(value) spent() defs();

// Admission of a call that enters its callee's frame

extern helper default_eval_frame(t:Thread) -> Bool
  effects(reads)
  c _PyRop_DefaultEvalFrame as bool
  evidence(
    review: "P4. ceval.c: !IS_PEP523_HOOKED(tstate), the guard of _CHECK_PEP_523.",
    contract: "Reads the interpreter's eval_frame hook; no memory, no failure.");

extern helper function_version(fn:B, f:Fb<Call>) -> Bool
  effects(reads)
  feedback(read(entry.func_version))
  test(exact<function>(fn))
  c _PyRop_FunctionVersion as bool
  evidence(
    review: "P4. ceval.c: fn is an object, exactly a function, whose func_version"
            "is the site's (_CHECK_FUNCTION_VERSION).",
    contract: "Reads the word, the type and func_version; no memory, no failure.");

// The callee's facts (`entry.callee`) follow from the code that the version
// guard pins: classification checked co_argcount against the site's
// operands, with the self operand present or not, and cached the frame's
// size, the code's executing copy and whether it has free variables
extern helper exact_positional(f:Frame, a:Args, fb:Fb<Call>) -> Bool
  effects(reads)
  feedback(read(entry.callee))
  c _PyRop_ExactPositional as bool inline
  evidence(
    review: "P4. ceval.c: co_argcount equals the arguments of the call, counting a"
            "self that is present at run time (_CHECK_FUNCTION_EXACT_ARGS);"
            "CR: classification compared the count, so only the self's presence"
            "is tested.",
    contract: "Reads the self operand's home and the entry; no memory, no failure.");

extern helper frame_space(t:Thread, fb:Fb<Call>) -> Bool
  effects(reads)
  feedback(read(entry.callee))
  c _PyRop_FrameSpace as bool
  evidence(
    review: "P4. ceval.c: _PyThreadState_HasStackSpace for co_framesize"
            "(_CHECK_STACK_SPACE), cached in the entry.",
    contract: "Reads the arena bounds; no memory, no failure.");

extern helper recursion_budget(t:Thread) -> Bool
  effects(reads)
  c _PyRop_RecursionBudget as bool
  evidence(
    review: "P4. ceval.c: py_recursion_remaining > 1 (_CHECK_RECURSION_REMAINING).",
    contract: "Reads the thread's budget; no memory, no failure.");

// The child frame of an exact call: the function and the arguments move
// to it (a temporary moves, a local is counted), at the arena top, whose
// space frame_space checked
extern helper push_exact(t:Thread, f:Frame, fn:Src, a:Args, fb:Fb<Call>) -> NewFrame
  effects(reads, writes, releases)
  feedback(read(entry.callee))
  spends(fn, a)
  requires(exact<function>(fn))
  c _PyRop_PushExact as pointer inline
  evidence(
    review: "P4. ceval.c: call_push_exact without expansion; the operand homes of"
            "temporaries are cleared.",
    contract: "Infallible: the guards checked the space and the argument count. No"
              "callback: moves and counts only (releases is the spend of the operands).");

// A bound method call: the method's function, with its receiver first

extern helper self_absent(f:Frame, a:Args) -> Bool
  effects(reads)
  c _PyRop_SelfAbsent as bool
  evidence(
    review: "P4. ceval.c: the call has no self operand, or its home is NULL at run"
            "time (the CALL_SELF_PRESENT tests of _CHECK_CALL_BOUND_METHOD_EXACT_ARGS"
            "and _CHECK_OBJECT).",
    contract: "Reads the self operand's home; no memory, no failure.");

extern helper method_version(fn:B, f:Fb<Call>) -> Bool
  effects(reads)
  feedback(read(entry.func_version))
  test(exact<method>(fn))
  c _PyRop_MethodVersion as bool
  evidence(
    review: "P4. ceval.c: fn is exactly a bound method whose im_func is a function"
            "with the site's func_version (_CHECK_METHOD_VERSION).",
    contract: "Reads the word, the method and its function; no memory, no failure.");

extern helper no_weakrefs(fn:B) -> Bool
  effects(reads)
  requires(exact<method>(fn))
  c _PyRop_NoWeakrefs as bool
  evidence(
    review: "P4. ceval.c: im_weakreflist is NULL (_CHECK_CALL_BOUND_METHOD_EXACT_ARGS):"
            "releasing the method then runs no callback before the frame is filled.",
    contract: "One read; no memory, no failure.");

// The child takes the receiver and the function, counted, and the arguments
// (a temporary moves, a local is counted); the method is released, which
// runs no callback (no_weakrefs) and no finalizer: the child counts both
// of its parts
extern helper push_bound_exact(t:Thread, f:Frame, fn:Src, a:Args, fb:Fb<Call>) -> NewFrame
  effects(reads, writes, releases)
  feedback(read(entry.callee))
  spends(fn, a)
  requires(exact<method>(fn))
  c _PyRop_PushBoundExact as pointer inline
  evidence(
    review: "P4. ceval.c: call_push_exact with CALL_EXPANDED, as"
            "_INIT_CALL_BOUND_METHOD_EXACT_ARGS and _INIT_CALL_PY_EXACT_ARGS.",
    contract: "Infallible: the guards checked the space and the argument count.");

// A class call that runs the class's cached __init__ in a frame

extern helper class_version(fn:B, f:Fb<Call>) -> Bool
  effects(reads)
  feedback(read(entry.type_version))
  c _PyRop_ClassVersion as bool
  evidence(
    review: "P4. ceval.c: fn is a type whose tp_version_tag is the site's"
            "type_version, which is not 0 (_CHECK_OBJECT).",
    contract: "Reads the word and the type; no memory, no failure.");

extern helper init_frame_ready(t:Thread, fn:B) -> Bool
  effects(reads)
  c _PyRop_InitFrameReady as bool
  evidence(
    review: "P4. ceval.c: the cached __init__ runs through _PyFunction_Vectorcall"
            "and the arena holds its frame and the cleanup frame"
            "(_CHECK_INIT_FUNCTION).  class_version guards the cache.",
    contract: "Reads the type's cache, the function and the arena; no failure.");

// The instance, then the cleanup frame (InitResult.Check, Return) and the
// __init__ frame above it; the class operand is released.  On failure the
// operands still in their homes are closed with the exception set aside.
extern helper push_init(t:Thread, f:Frame, fn:Src, a:Args)
  cases(entered(c:NewFrame), err(e:Err))
  effects(reads, writes, allocates, releases, raises)
  spends(fn, a)
  c _PyRop_PushInit as pointer_or_raised
  evidence(
    review: "P4. ceval.c: _PyEval_CreateInitFrame (_CREATE_INIT_FRAME), then the"
            "operands it left in their homes on failure (_PyEval_call_release_rest).",
    contract: "The allocation may collect, and a finalizer may run Python before"
              "anything moves; the cache was counted first.  The child is current"
              "on return: its previous frame is the cleanup frame.");

// The generator that a call of a generator function creates, with no frame of
// the thread: the operands fill the generator's frame, and the code's prologue
// that the first send does not run (cells, a generator expression's iterator)
// runs here.  On failure the operands left in their homes are closed with the
// exception set aside.
extern helper new_generator(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, writes, allocates, releases, raises)
  spends(fn, a)
  requires(exact<function>(fn))
  c _PyRop_NewGenerator as value_or_null
  evidence(
    review: "P4. ceval.c: call_new_generator, the old CALL_PY_GENERATOR's"
            "_CALL_PY_GENERATOR; the operands the call did not move are closed.",
    contract: "Moves the function and the operands into the new object's frame; the"
              "result is a new owner.  A prologue's iter() may run Python.");

// Any callable

// A Python function, or a bound method of one with no self operand, whose
// frame the call pushes: PEP 523 is not hooked, the function is called
// through _PyFunction_Vectorcall and its code does not create a generator
// (a generator function is called through vectorcall)
extern helper python_target(t:Thread, f:Frame, fn:Src, a:Args) -> Bool
  effects(reads)
  c _PyRop_PythonTarget as bool
  evidence(
    review: "P4. ceval.c: call_expand_method and call_is_python_function, as"
            "call_run decides, and code_creates_generator.",
    contract: "Reads the callable and the code; no memory, no failure.");

// The child frame of a Python call, bound by the call's plan or generally
// (defaults, *args, **kwargs); the operands move or are counted
extern helper push_python(t:Thread, f:Frame, fn:Src, a:Args)
  cases(entered(c:NewFrame), err(e:Err))
  effects(reads, writes, allocates, releases, raises)
  spends(fn, a)
  c _PyRop_PushPython as pointer_or_raised
  evidence(
    review: "P4. ceval.c: call_run's Python path: _PyEval_call_bind_positional with a plan"
            "of the call, else _PyEval_call_push_python; on failure the operands left in"
            "their homes are closed with the exception set aside.",
    contract: "The child is current on return and the method operand of an expanded"
              "bound method was released with it current, as the old call did; a"
              "finalizer may run then.  A binding error raises.");

// The vectorcall of a native callee (or of anything call_native is given) on
// the operands in their homes, which it borrows: a temporary cannot change,
// and a local's old value lives on in f_overwritten_fast_locals
extern helper call_native(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  c _PyRop_CallNative as value_or_null inline
  evidence(
    review: "P4. ceval.c: call_vector_impl after call_expand_method, as call_run's"
            "native path.",
    contract: "Borrows every operand for the call; the result is a new owner.");

extern helper retire_failed_args(f:Frame, fn:Src, a:Args, e:Err) -> Err
  effects(writes, releases)
  spends(fn, a)
  c _PyRop_RetireFailedArgs as handle
  evidence(
    review: "P4. ceval.c: _PyEval_call_release_rest over every operand and the callable,"
            "with the pending exception set aside.",
    contract: "Closes each temporary operand and the callable; a finalizer may run"
              "Python.  The exception is pending again on return.");

// Whether the word polls after its call: a flag of the word, folded where the
// word is compiled
extern primitive polls(i:Enum<Interrupt>) -> Bool
  effects()
  c _PyRop_Polls as bool
  evidence(
    review: "ceval.c: the word's interrupt flag is INTERRUPTIBLE, as `with` skips the poll after its __enter__ and __exit__ lookups' call.",
    contract: "A comparison of an immediate: no memory, no failure.");

// The poll after a call returns (CALL_PERIODIC): signals and the GC.  After
// a monitoring change the frame may move to the other evaluator, where it
// goes on at the next word (the route is the switch word).
extern helper end_poll(t:Thread, f:Frame, to:Head)
  cases(ok(), moved(r:Route), err(e:Err))
  effects(runs_python, raises, polls)
  c _PyRop_EndPoll as int_redirect
  evidence(
    review: "P4. ceval_macros.h: check_periodics_at_end (_CHECK_PERIODIC_AT_END).",
    contract: "A signal handler or a finalizer may run Python and raise.");

// Observation (the observed wrappers Call.Observed and Return.Observed)

// The CALL event, with the callable and the first argument (self first),
// before the call runs
extern helper call_event(t:Thread, f:Frame, at:Site, fn:Src, a:Args)
  cases(ok(), err(e:Err))
  effects(runs_python, raises)
  requires(instrumented(at))
  c _PyRop_CallEvent as int_zero_ok
  evidence(
    review: "P4. ceval.c: _PyEval_call_monitor with call_first_argument, as call_run does"
            "for CALL_INSTRUMENTED.",
    contract: "The callback may run Python and raise; the operands stay in their"
              "homes.");

// call_native, then for a callee that is not a Python function its C_RETURN
// or C_RAISE event; a callback that raises in C_RETURN fails the call
extern helper call_native_observed(t:Thread, f:Frame, at:Site, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  c _PyRop_CallNativeObserved as value_or_null
  evidence(
    review: "P4. ceval.c: call_vector_impl, then _PyEval_call_run_instrumented_result's"
            "events (call_monitor_result); a generator function, a Python"
            "function, fires none, as the old Python path did not.",
    contract: "Borrows every operand; the result is a new owner, closed if a"
              "callback raises.");

// The PY_RETURN event with the value held
extern helper return_event(t:Thread, f:Frame, at:Site, v:O)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises, releases)
  requires(instrumented(at))
  c _PyRop_ReturnEvent as value_or_null
  evidence(
    review: "P4. bytecodes.c: _RETURN_VALUE_EVENT.",
    contract: "Takes the value and gives it back; if the callback raises the value"
              "is closed.");

extern helper generator_frame(f:Frame) -> Bool
  effects(reads)
  c _PyRop_GeneratorFrame as bool
  evidence(
    review: "P4. ceval.c: frame->owner == FRAME_OWNED_BY_GENERATOR, what"
            "_RETURN_VALUE tests.",
    contract: "Reads the frame; no memory, no failure.");

// Adaptation evidence (specialize.c): the call specializer in collecting
// mode fills the site's entry and answers with the arm the call stands for
extern helper classify_call(at:Site, f:Fb<Call>, fn:B, a:Args)
  cases(exact(), bound_exact(), init(), generator(), plan(), plan_generator(), bound_general(),
        type_1(), str_1(), tuple_1(), builtin_class(), builtin_o(), builtin_fast(), builtin_fast_keywords(), len(), isinstance(), list_append(), descriptor_o(), descriptor_fast(), descriptor_fast_keywords(), descriptor_noargs(), other())
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry))
  c _PyRop_ClassifyCall as case_index
  evidence(
    review: "P4. specialize.c: the old _Py_Specialize_Call's handler choice"
            "collected (as attr_classify): CALL_PY_EXACT_ARGS,"
            "CALL_BOUND_METHOD_EXACT_ARGS, CALL_ALLOC_AND_ENTER_INIT,"
            "CALL_PY_GENERATOR and CALL_PY_GENERAL are the first five cases, the"
            "native specializations follow (CALL_TYPE_1 to"
            "CALL_METHOD_DESCRIPTOR_FAST), anything else is other.",
    contract: "Writes the site's entry (func_version, type_version, the type's init"
              "cache, the binding plan) and sets no handler.  No Python runs.");

// The native callees (bytecodes.c of golden87 684a98eb30e, CALL_TYPE_1 to
// CALL_METHOD_DESCRIPTOR_FAST): guards that read the callable and the call's
// operands, and the calls that borrow the operands in their homes

extern helper self_present(f:Frame, a:Args) -> Bool
  effects(reads)
  c _PyRop_SelfPresent as bool
  evidence(
    review: "Item 4. ceval.c: the call has a self operand whose home is not NULL at run time (the CALL_SELF_PRESENT test of _GUARD_CALL_SELF_PRESENT).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper recursion_clear(t:Thread) -> Bool
  effects(reads)
  c _PyRop_RecursionClear as bool
  evidence(
    review: "Item 4. ceval.c: the C recursion depth is below its soft limit (_CHECK_RECURSION_LIMIT, which exits when _Py_ReachedRecursionLimit).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper callee_is_type(fn:B) -> Bool
  effects(reads)
  c _PyRop_CalleeIsType as bool
  evidence(
    review: "Item 4. ceval.c: the callable is the type `type` (_GUARD_CALLABLE_TYPE_1).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper callee_is_str(fn:B) -> Bool
  effects(reads)
  c _PyRop_CalleeIsStr as bool
  evidence(
    review: "Item 4. ceval.c: the callable is the type `str` (_GUARD_CALLABLE_STR_1).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper callee_is_tuple(fn:B) -> Bool
  effects(reads)
  c _PyRop_CalleeIsTuple as bool
  evidence(
    review: "Item 4. ceval.c: the callable is the type `tuple` (_GUARD_CALLABLE_TUPLE_1).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper callee_is_len(t:Thread, fn:B) -> Bool
  effects(reads)
  c _PyRop_CalleeIsLen as bool
  evidence(
    review: "Item 4. ceval.c: the callable is the interpreter's cached `len` (_GUARD_CALLABLE_LEN).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper callee_is_isinstance(t:Thread, fn:B) -> Bool
  effects(reads)
  c _PyRop_CalleeIsIsinstance as bool
  evidence(
    review: "Item 4. ceval.c: the callable is the interpreter's cached `isinstance` (_GUARD_CALLABLE_ISINSTANCE).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper callee_is_list_append(t:Thread, fn:B) -> Bool
  effects(reads)
  c _PyRop_CalleeIsListAppend as bool
  evidence(
    review: "Item 4. ceval.c: _GUARD_CALLABLE_LIST_APPEND: the callable is the interpreter's cached list.append.",
    contract: "Reads the callable and the cache; no memory, no failure.");

extern helper builtin_class(fn:B) -> Bool
  effects(reads)
  c _PyRop_BuiltinClass as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a type with a vectorcall (_GUARD_CALLABLE_BUILTIN_CLASS).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper builtin_o(f:Frame, fn:B, a:Args) -> Bool
  effects(reads)
  c _PyRop_BuiltinOCallable as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a builtin METH_O function that the call gives one argument (_GUARD_CALLABLE_BUILTIN_O).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper builtin_fast(f:Frame, fn:B, a:Args) -> Bool
  effects(reads)
  c _PyRop_BuiltinFastCallable as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a builtin METH_FASTCALL, or METH_VALUE function, whose fixed arity the call fits (_GUARD_CALLABLE_BUILTIN_FAST).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper builtin_fast_keywords(fn:B) -> Bool
  effects(reads)
  c _PyRop_BuiltinFastKeywordsCallable as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a builtin METH_FASTCALL | METH_KEYWORDS, or METH_VALUE | METH_KEYWORDS function (_GUARD_CALLABLE_BUILTIN_FAST_WITH_KEYWORDS).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper descriptor_o(f:Frame, fn:B, a:Args) -> Bool
  effects(reads)
  c _PyRop_DescriptorOCallable as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a METH_O method descriptor, the call has its receiver and one argument, and the receiver is an exact instance of the descriptor's type (_GUARD_CALLABLE_METHOD_DESCRIPTOR_O).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper descriptor_noargs(f:Frame, fn:B, a:Args) -> Bool
  effects(reads)
  c _PyRop_DescriptorNoargsCallable as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a METH_NOARGS method descriptor, the call has only its receiver, and the receiver is an exact instance of the descriptor's type (_GUARD_CALLABLE_METHOD_DESCRIPTOR_NOARGS).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper descriptor_fast(f:Frame, fn:B, a:Args) -> Bool
  effects(reads)
  c _PyRop_DescriptorFastCallable as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a METH_FASTCALL, or METH_VALUE, method descriptor whose fixed arity the call fits, with a receiver of the descriptor's exact type (_GUARD_CALLABLE_METHOD_DESCRIPTOR_FAST).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

extern helper descriptor_fast_keywords(f:Frame, fn:B, a:Args) -> Bool
  effects(reads)
  c _PyRop_DescriptorFastKeywordsCallable as bool
  evidence(
    review: "Item 4. ceval.c: the callable is a METH_FASTCALL | METH_KEYWORDS, or METH_VALUE | METH_KEYWORDS, method descriptor with a receiver of its exact type (_GUARD_CALLABLE_METHOD_DESCRIPTOR_FAST_WITH_KEYWORDS).",
    contract: "Reads the callable, the type and the operand homes; no memory, no failure.");

// The receiver of list.append is an exact list (_GUARD_NOS_LIST)
extern helper list_receiver(f:Frame, a:Args) -> Bool
  effects(reads)
  c _PyRop_ListReceiver as bool
  evidence(
    review: "Item 4. ceval.c: _GUARD_NOS_LIST.",
    contract: "Reads the receiver's home and type; no memory, no failure.");

extern helper call_type_1(f:Frame, a:Args) -> O
  effects(allocates)
  c _PyRop_CallType1 as value
  evidence(
    review: "Item 4. ceval.c: _CALL_TYPE_1.",
    contract: "The result is a new owner of the argument's type. No Python, no failure.");

extern helper call_str_1(f:Frame, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallStr1 as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_STR_1.",
    contract: "The argument is borrowed; the result is a new owner. Callbacks: __str__, __repr__.");

extern helper call_tuple_1(f:Frame, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallTuple1 as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_TUPLE_1.",
    contract: "The argument is borrowed; the result is a new owner. Callbacks: __iter__, __next__.");

extern helper call_len(f:Frame, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallLen as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_LEN.",
    contract: "The argument is borrowed; the result is a new owner, inline when it fits."
              "Callbacks: __len__.");

extern helper call_isinstance(f:Frame, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  c _PyRop_CallIsinstance as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_ISINSTANCE.",
    contract: "The instance and the class are borrowed; the result is True or False."
              "Callbacks: __instancecheck__, __class__.");

extern helper call_list_append(f:Frame, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, writes, raises)
  c _PyRop_CallListAppend as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_LIST_APPEND.",
    contract: "The list takes a count of the argument, which stays the frame's until the call"
              "publishes its result; the list's lock is held across the append. The result is None.");

extern helper call_builtin_o(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallBuiltinO as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_BUILTIN_O, native_call_builtin_o: the one argument is read in place.",
    contract: "Borrows the argument for the call; the result is a new owner.");

extern helper call_builtin_values(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallBuiltinValues as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_BUILTIN_FAST and _CALL_BUILTIN_FAST_WITH_KEYWORDS, call_builtin_values.",
    contract: "Borrows every operand for the call; the result is a new owner.");

extern helper call_class_values(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallClassValues as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_BUILTIN_CLASS, call_class_values.",
    contract: "Borrows every operand for the call; the result is a new owner.");

extern helper call_descriptor_values(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallDescriptorValues as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_METHOD_DESCRIPTOR_FAST and _FAST_WITH_KEYWORDS, call_descriptor_values.",
    contract: "Borrows every operand for the call; the result is a new owner.");

extern helper call_descriptor_o(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallDescriptorO as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_METHOD_DESCRIPTOR_O.",
    contract: "Borrows the receiver and the argument; the result is a new owner.");

extern helper call_descriptor_noargs(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises)
  c _PyRop_CallDescriptorNoargs as value_or_null
  evidence(
    review: "Item 4. ceval.c: _CALL_METHOD_DESCRIPTOR_NOARGS.",
    contract: "Borrows the receiver; the result is a new owner.");


macro adapt_before_use_call(f:Fb<Call>, fn:Src, a:Args)
  cases(run(), changed(t:Ticket<Call>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    call classify_call(site, f, use(fn), a) {
      exact -> Exact();
      bound_exact -> Bound();
      init -> Init();
      generator -> Generator();
      plan -> Planned();
      plan_generator -> PlannedGenerator();
      bound_general -> BoundGeneral();
      type_1 -> NType1();
      str_1 -> NStr1();
      tuple_1 -> NTuple1();
      builtin_class -> NBuiltinClass();
      builtin_o -> NBuiltinO();
      builtin_fast -> NBuiltinFast();
      builtin_fast_keywords -> NBuiltinFastKeywords();
      len -> NLen();
      isinstance -> NIsinstance();
      list_append -> NListAppend();
      descriptor_o -> NDescriptorO();
      descriptor_fast -> NDescriptorFast();
      descriptor_fast_keywords -> NDescriptorFastKeywords();
      descriptor_noargs -> NDescriptorNoargs();
      other -> Other();
    }
  Exact():
    let ce:Candidate<Call> = candidate(Call.Exact);
    call install(site, f, ce) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Bound():
    let cb:Candidate<Call> = candidate(Call.BoundExact);
    call install(site, f, cb) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Init():
    let ci:Candidate<Call> = candidate(Call.Init);
    call install(site, f, ci) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Generator():
    let cg:Candidate<Call> = candidate(Call.Generator);
    call install(site, f, cg) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NType1():
    let ctype_1:Candidate<Call> = candidate(Call.Type1);
    call install(site, f, ctype_1) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NStr1():
    let cstr_1:Candidate<Call> = candidate(Call.Str1);
    call install(site, f, cstr_1) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NTuple1():
    let ctuple_1:Candidate<Call> = candidate(Call.Tuple1);
    call install(site, f, ctuple_1) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NBuiltinClass():
    let cbuiltin_class:Candidate<Call> = candidate(Call.BuiltinClass);
    call install(site, f, cbuiltin_class) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NBuiltinO():
    let cbuiltin_o:Candidate<Call> = candidate(Call.BuiltinO);
    call install(site, f, cbuiltin_o) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NBuiltinFast():
    let cbuiltin_fast:Candidate<Call> = candidate(Call.BuiltinFast);
    call install(site, f, cbuiltin_fast) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NBuiltinFastKeywords():
    let cbuiltin_fast_keywords:Candidate<Call> = candidate(Call.BuiltinFastKeywords);
    call install(site, f, cbuiltin_fast_keywords) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NLen():
    let clen:Candidate<Call> = candidate(Call.Len);
    call install(site, f, clen) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NIsinstance():
    let cisinstance:Candidate<Call> = candidate(Call.Isinstance);
    call install(site, f, cisinstance) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NListAppend():
    let clist_append:Candidate<Call> = candidate(Call.ListAppend);
    call install(site, f, clist_append) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NDescriptorO():
    let cdescriptor_o:Candidate<Call> = candidate(Call.DescriptorO);
    call install(site, f, cdescriptor_o) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NDescriptorFast():
    let cdescriptor_fast:Candidate<Call> = candidate(Call.DescriptorFast);
    call install(site, f, cdescriptor_fast) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NDescriptorFastKeywords():
    let cdescriptor_fast_keywords:Candidate<Call> = candidate(Call.DescriptorFastKeywords);
    call install(site, f, cdescriptor_fast_keywords) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NDescriptorNoargs():
    let cdescriptor_noargs:Candidate<Call> = candidate(Call.DescriptorNoargs);
    call install(site, f, cdescriptor_noargs) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Planned():
    let cp:Candidate<Call> = candidate(Call.PyGeneral);
    call install(site, f, cp) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  PlannedGenerator():
    let cpg:Candidate<Call> = candidate(Call.PlanGenerator);
    call install(site, f, cpg) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  BoundGeneral():
    let cbg:Candidate<Call> = candidate(Call.BoundGeneral);
    call install(site, f, cbg) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Call>):
    exit changed(t);
  Run():
    exit run();
}

// InitResult

extern helper is_none(v:B) -> Bool
  effects()
  c PyValue_IsNone as bool
  evidence(
    review: "P4. pycore_value.h: the word is None's.",
    contract: "A comparison of the word; no memory, no failure.");

extern helper init_result_error(v:B)
  cases(err(e:Err))
  effects(allocates, raises)
  c _PyRop_InitResultError as raised
  evidence(
    review: "P4. bytecodes.c EXIT_INIT_CHECK: the TypeError and its message.",
    contract: "Sets the exception; formats the type's name, runs no Python.");

// Return

// Compiled code may still run in the departing frame's unit after the frame
// drops its code: the mark keeps the unit until the thread's next frame
// switch (Python/jit.c, _PyJit_Reclaim())
extern helper mark_departure() -> Unit
  effects(writes)
  c IR_MARK_DEPARTURE as unit
  evidence(
    review: "J1. ceval_macros.h: nothing in the evaluator, which runs in no unit;"
            "the thread's jit_departing flag in the forms.",
    contract: "Sets the thread's departure flag: releases nothing, runs no Python.");

extern helper previous_frame(f:Frame) -> Frame
  effects(reads)
  c _PyRop_PreviousFrame as pointer
  evidence(
    review: "P4. ceval.c: frame->previous.",
    contract: "A read; no failure.");

// The frame leaves the recursion budget and the thread's frame chain
extern helper depart(t:Thread, f:Frame) -> DeadFrame
  effects(writes)
  c _PyRop_Depart as pointer
  evidence(
    review: "P4. ceval.c: DTRACE_FUNCTION_RETURN, _Py_LeaveRecursiveCallPy, then"
            "current_frame = previous (GH-99729: unlink before clearing).",
    contract: "Writes the thread state; no failure, no callback.");

extern helper retire_frame(t:Thread, d:DeadFrame) -> Unit
  effects(releases)
  c _PyRop_RetireFrame as unit inline
  evidence(
    review: "P4. ceval.c: _PyEval_FrameClearAndPopGeneralWithResult without a result.",
    contract: "Closes every owner of the frame in turn, then pops it; a finalizer may"
              "run Python, which sees a consistent frame.");

// Whether no frame object sees the returning frame and it is not the
// thread's last profiled frame; the other case, which retire_frame
// handles, is cold
extern primitive frame_unobserved(t:Thread, d:DeadFrame)
  cases(plain(), cold observed())
  effects(reads)
  borrows(d)
  c _PyRop_FrameUnobserved as bool_cases
  evidence(
    review: "J5. ceval_shared.h: the test that _PyRop_RetireFrameEmpty made"
            "before it retired the frame itself.",
    contract: "Reads the frame and the thread: no memory, no failure.");

// An unobserved frame (frame_unobserved) whose scratch is vacant: only the
// locals can own values
extern helper retire_frame_empty(t:Thread, d:DeadFrame) -> Unit
  effects(releases)
  c _PyRop_RetireFrameEmpty as unit inline
  evidence(
    review: "P4. ceval.c: _PyEval_RetireThreadFrameWithResult without a result.",
    contract: "As retire_frame, over the fixed slots only.");

// The value goes to the caller's return slot; the head where the caller
// goes on, which a pending redirect may have moved
extern helper deliver(c:Frame, v:O) -> Head
  effects(writes, releases)
  c _PyRop_Deliver as pointer inline
  evidence(
    review: "P4. ceval.c: _PyFrame_SetReturnValue, then the caller's return_pc.",
    contract: "The slot's old value is released after the write, as STORE_FAST"
              "does; a redirect completes first (_PyFrame_SetReturnValueRare).");

// A generator frame's return: the generator's consumer completes and goes
// on at its head, or a redirect moved it, or the completion raised in the
// consumer.  An interpreter-owned consumer goes on at its trampoline word.
// A transfer row: the callee performs the exit.
extern helper generator_return(c:Frame, v:O, d:DeadFrame)
  cases(return(f:Frame, h:Head), redirect(r:Route), raise(e:Err))
  effects(runs_python, writes, releases, raises, switches_frame)
  c ROP_GEN_RETURN as transfer
  evidence(
    review: "P4. ceval.c and ceval_routines.h: IR_GEN_RETURN(v, d, 0) with frame the"
            "resumer, as RETURN_VALUE does.",
    contract: "ir_gen_return: clears the generator frame and completes its consumer.");

// generator_return for a frame whose scratch is vacant (the lowering test of
// Return.Empty): only its locals can own values, and its retirement clears
// those (IR_GEN_RETURN's EMPTY), as golden87's RETURN_VALUE_EMPTY did
extern helper generator_return_empty(c:Frame, v:O, d:DeadFrame)
  cases(return(f:Frame, h:Head), redirect(r:Route), raise(e:Err))
  effects(runs_python, writes, releases, raises, switches_frame)
  c ROP_GEN_RETURN_EMPTY as transfer
  evidence(
    review: "ceval.c and ceval_routines.h: IR_GEN_RETURN(v, d, 1) with frame the"
            "resumer, as golden87's RETURN_VALUE_EMPTY in a generator did.",
    contract: "ir_gen_return: clears the generator frame's fixed slots and completes"
              "its consumer; the scratch is vacant.");

// The evaluator's entry frame: the value leaves the activation
extern helper leave_activation(t:Thread, f:Frame) -> Unit
  effects(writes)
  requires(entry_frame(f))
  c _PyRop_LeaveActivation as unit
  evidence(
    review: "P4. ceval.c: INTERPRETER_EXIT's current_frame = frame->previous.",
    contract: "Writes the thread state; no failure, no callback.");

// Arms

arm Call.Exact split
  effects(runs_python, reads, writes, releases, switches_frame)
  feedback(read(entry.func_version), read(entry.callee))
  exits(enter, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard function_version(use(fn), fb) else miss;
    guard exact_positional(frame, args, fb) else miss;
    guard frame_space(thread, fb) else miss;
    goto Callee();
  // The new frame and the switch into the callee: one function, which the
  // interpreter's arm and every compiled copy tail-call
  Callee() outline:
    let c:NewFrame = push_exact(thread, frame, fn, args, fb);
    exit enter(c) resume Call.Returned;
}

arm Call.BoundExact split
  effects(runs_python, reads, writes, releases, switches_frame)
  feedback(read(entry.func_version), read(entry.callee))
  exits(enter, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard self_absent(frame, args) else miss;
    guard method_version(use(fn), fb) else miss;
    guard no_weakrefs(use(fn)) else miss;
    // Classification admitted the receiver and these arguments, with the
    // self operand absent, which self_absent tests: the count holds
    guard frame_space(thread, fb) else miss;
    goto Callee();
  Callee() outline:
    let c:NewFrame = push_bound_exact(thread, frame, fn, args, fb);
    exit enter(c) resume Call.Returned;
}

arm Call.Init split
  effects(runs_python, reads, writes, allocates, releases, raises, switches_frame)
  feedback(read(entry.type_version))
  exits(enter, raise, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard self_absent(frame, args) else miss;
    guard class_version(use(fn), fb) else miss;
    guard init_frame_ready(thread, use(fn)) else miss;
    // The cleanup frame takes a unit of the budget before the __init__
    // frame's start takes its own: at the last unit the call deopts, so the
    // limit falls where the generic call puts it
    guard recursion_budget(thread) else miss;
    call push_init(thread, frame, fn, args) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume Call.Returned;
  Failed(e:Err):
    exit raise(Call.Failed, e);
}

arm Call.Generator split
  effects(runs_python, allocates, raises, releases on (dst))
  feedback(read(entry.func_version), read(entry.callee))
  exits(next, raise, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard function_version(use(fn), fb) else miss;
    guard exact_positional(frame, args, fb) else miss;
    call new_generator(thread, frame, fn, args) {
      ok -> Result();
      err -> Failed();
    }
  Result(z:O):
    publish [dst = z] retire [old(dst)] at Call.Done;
    exit next();
  Failed(e:Err):
    exit raise(Call.Failed, e);
}

arm Call.Generic split
  effects(runs_python, raises, polls, switches_frame, releases on (dst))
  feedback(read(entry), write(entry), write(handler))
  exits(next, enter, raise, again, redirect)
{
  entry():
    call adapt_before_use_call(fb, fn, args) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Call>):
    exit again(t);
  Run():
    branch python_target(thread, frame, fn, args) -> Python(), Native();
  // The new frame and the switch into a Python callee: one function, as
  // Call.Exact's
  Python() outline:
    call push_python(thread, frame, fn, args) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume Call.Returned;
  Failed(e:Err):
    exit raise(Call.Failed, e);
  Native():
    call call_native(thread, frame, fn, args) {
      ok -> Result();
      err -> NativeFailed();
    }
  Result(z:O):
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    branch polls(interrupt) -> Poll(), Next();
  Poll():
    call end_poll(thread, frame, next_head) {
      ok -> Next();
      moved -> PollSwitched();
      err -> PollFailed();
    }
  Next():
    exit next();
  PollFailed(pe:Err):
    exit raise(Call.PollFailed, pe);
  NativeFailed(ne:Err):
    let saved:Err = retire_failed_args(frame, fn, args, ne);
    exit raise(Call.Failed, saved);
  PollSwitched(ps:Route):
    exit redirect(ps);
}

arm InitResult.Check split
  effects(writes, allocates, raises, releases)
  feedback()
  exits(next, raise)
{
  entry():
    branch is_none(use(value)) -> Done(), Wrong();
  Done():
    publish [] retire [spent(value)] at InitResult.Done;
    exit next();
  Wrong():
    call init_result_error(use(value)) {
      err -> Raised();
    }
  Raised(e:Err):
    exit raise(InitResult.Wrong, e);
}

// The observed wrapper of every Call arm: the CALL event, then the call as
// Call.Generic makes it, without adaptation, with the C events of a native
// callee.  A Python callee's PY_START fires in its own RESUME.
arm Call.Observed split observes
  effects(runs_python, raises, polls, switches_frame, releases on (dst))
  feedback()
  exits(next, enter, raise, redirect)
{
  entry():
    let fo:O = dup(use(fn));
    call call_event(thread, frame, site, fn, args) {
      ok -> Run(fo);
      err -> EventFailed(fo);
    }
  EventFailed(ee:Err, efo:O):
    let esaved:Err = retire_failed_held(frame, fn, efo, args, ee);
    exit raise(Call.Failed, esaved);
  Run(rfo:O):
    branch python_target_held(thread, frame, rfo, args) -> Python(rfo), Native(rfo);
  Python(pfo:O):
    call push_python_held(thread, frame, fn, pfo, args) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume Call.Returned;
  Failed(e:Err):
    exit raise(Call.Failed, e);
  Native(nfo:O):
    call call_native_observed_held(thread, frame, site, fn, nfo, args) {
      ok -> Result();
      err -> NativeFailed();
    }
  Result(z:O):
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    branch polls(interrupt) -> Poll(), Next();
  Poll():
    call end_poll(thread, frame, next_head) {
      ok -> Next();
      moved -> PollSwitched();
      err -> PollFailed();
    }
  Next():
    exit next();
  PollFailed(pe:Err):
    exit raise(Call.PollFailed, pe);
  NativeFailed(ne:Err):
    let saved:Err = retire_failed_args(frame, fn, args, ne);
    exit raise(Call.Failed, saved);
  PollSwitched(ps:Route):
    exit redirect(ps);
}

arm Return.Ordinary split select(thread_frame, live_scratch)
  effects(runs_python, reads, writes, releases, switches_frame)
  feedback()
  exits(return)
{
  entry():
    let _:Unit = mark_departure();
    let r:O = acquire(value);
    let caller:Frame = previous_frame(frame);
    let dying:DeadFrame = depart(thread, frame);
    let _:Unit = retire_frame(thread, dying);
    let h:Head = deliver(caller, r);
    publish [] retire [] at Return.Delivered;
    exit return(caller, h);
}

arm Return.Empty split select(thread_frame, vacant_scratch)
  effects(runs_python, reads, writes, releases, switches_frame)
  feedback()
  exits(return)
{
  // The frame's retirement and the switch back to the caller: one
  // function, which the interpreter's arm and every compiled copy tail-call
  entry() outline:
    let _:Unit = mark_departure();
    let r:O = acquire(value);
    let caller:Frame = previous_frame(frame);
    let dying:DeadFrame = depart(thread, frame);
    call frame_unobserved(thread, dying) {
      plain -> Plain();
      observed -> Observed();
    }
  Plain():
    let _:Unit = retire_frame_empty(thread, dying);
    goto Deliver();
  Observed():
    let _:Unit = retire_frame(thread, dying);
    goto Deliver();
  Deliver():
    let h:Head = deliver(caller, r);
    publish [] retire [] at Return.Delivered;
    exit return(caller, h);
}

arm Return.Generator split select(generator_frame, live_scratch)
  effects(runs_python, reads, writes, releases, raises, switches_frame)
  feedback()
  exits(return, raise, redirect)
{
  entry():
    let _:Unit = mark_departure();
    let r:O = acquire(value);
    let caller:Frame = previous_frame(frame);
    let dying:DeadFrame = depart(thread, frame);
    call generator_return(caller, r, dying) {
      return -> Completed();
      redirect -> Moved();
      raise -> Failed();
    }
  Completed(f:Frame, h:Head):
    exit return(f, h);
  Moved(rt:Route):
    exit redirect(rt);
  Failed(e:Err):
    exit raise(Return.ConsumerFailed, e);
}

arm Return.GeneratorEmpty split select(generator_frame, vacant_scratch)
  effects(runs_python, reads, writes, releases, raises, switches_frame)
  feedback()
  exits(return, raise, redirect)
{
  entry():
    let _:Unit = mark_departure();
    let r:O = acquire(value);
    let caller:Frame = previous_frame(frame);
    let dying:DeadFrame = depart(thread, frame);
    call generator_return_empty(caller, r, dying) {
      return -> Completed();
      redirect -> Moved();
      raise -> Failed();
    }
  Completed(f:Frame, h:Head):
    exit return(f, h);
  Moved(rt:Route):
    exit redirect(rt);
  Failed(e:Err):
    exit raise(Return.ConsumerFailed, e);
}

// The observed wrapper of every Return arm: the PY_RETURN event, then the
// return of the frame the word runs in.  Return.External stands for
// INTERPRETER_EXIT, which has no event and is never instrumented.
arm Return.Observed split observes
  effects(reads, writes, releases, raises, runs_python, switches_frame)
  feedback()
  exits(return, raise, redirect)
{
  entry():
    let r:O = acquire(value);
    call return_event(thread, frame, site, r) {
      ok -> Observed();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Return.EventFailed, e);
  Observed(v:O):
    let _:Unit = mark_departure();
    branch generator_frame(frame) -> Generator(), Thread();
  Generator():
    let gcaller:Frame = previous_frame(frame);
    let gdying:DeadFrame = depart(thread, frame);
    call generator_return(gcaller, v, gdying) {
      return -> Completed();
      redirect -> Moved();
      raise -> ConsumerFailed();
    }
  Completed(gf:Frame, gh:Head):
    exit return(gf, gh);
  Moved(gr:Route):
    exit redirect(gr);
  ConsumerFailed(ge:Err):
    exit raise(Return.ConsumerFailed, ge);
  Thread():
    let caller:Frame = previous_frame(frame);
    let dying:DeadFrame = depart(thread, frame);
    let _:Unit = retire_frame(thread, dying);
    let h:Head = deliver(caller, v);
    publish [] retire [] at Return.Delivered;
    exit return(caller, h);
}

arm Return.External split select(entry_frame)
  effects(writes)
  feedback()
  exits(exit)
{
  entry():
    let r:O = acquire(value);
    let _:Unit = leave_activation(thread, frame);
    exit exit(r);
}

// 2A: keyword and expanded calls

// The operand block of a CallKw is Call's, with the constant tuple of the
// keyword names as its last operand (the elided LOAD_CONST); the arms share
// Call's rows, which read the keywords from the word.
family CallKw(dst:Dst, fn:Src, args:Args, fb:Fb<Call>)
  exits(next, enter, raise, redirect, miss, again) generic(Generic)
  events(CALL, C_RETURN, C_RAISE);

// `args` is the positional iterable or tuple and, unless the word says
// otherwise, the kwargs dict.  The tuple that the call makes of the iterable
// is an owner of the call, not a home.
family CallEx(dst:Dst, fn:Src, args:Args, fb:Fb<Call>)
  exits(next, enter, raise, redirect, miss, again) generic(Generic)
  events(CALL, C_RETURN, C_RAISE);

// The local's **kwargs dict, which the binding of a frame left pending
family MaterializeKwargs(local:Local)
  exits(next, raise);

point CallKw.Returned(caller, next_head, clear) keep() spent(fn, args) defs(dst);
point CallKw.Done(current, next_head, clear) keep() spent(fn, args) defs(dst);
point CallKw.PollFailed(current, site, pending) keep() spent(fn, args) defs(dst);
point CallKw.Failed(current, site, pending) keep() spent(fn, args) defs();
point CallEx.Returned(caller, next_head, clear) keep() spent(fn, args) defs(dst);
point CallEx.Done(current, next_head, clear) keep() spent(fn, args) defs(dst);
point CallEx.PollFailed(current, site, pending) keep() spent(fn, args) defs(dst);
point CallEx.Failed(current, site, pending) keep() spent(fn, args) defs();
point MaterializeKwargs.Done(current, next_head, clear) keep() spent(local) defs(local);
point MaterializeKwargs.Failed(current, site, pending) keep(local) spent() defs();

// The callable of a call that steps through Python before it runs (the CALL
// event, the iteration of *args) is held by an owner that the later rows take:
// evaluation order is the language's, and a callback may rebind the local that
// the callable was read from

extern helper python_target_held(t:Thread, f:Frame, fo:O, a:Args) -> Bool
  effects(reads)
  borrows(fo)
  c _PyRop_PythonTargetHeld as bool
  evidence(
    review: "2A. ceval.c: _PyRop_PythonTarget on the held callable.",
    contract: "Reads the callable and the code; no memory, no failure.");

extern helper push_python_held(t:Thread, f:Frame, fn:Src, fo:O, a:Args)
  cases(entered(c:NewFrame), err(e:Err))
  effects(reads, writes, allocates, releases, raises)
  spends(fn, a)
  c _PyRop_PushPythonHeld as pointer_or_raised
  evidence(
    review: "2A. ceval.c: _PyRop_PushPython on the held callable.",
    contract: "As push_python; takes the held callable on both cases.");

extern helper call_native_observed_held(t:Thread, f:Frame, at:Site, fn:Src, fo:O, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  c _PyRop_CallNativeObservedHeld as value_or_null
  evidence(
    review: "2A. ceval.c: _PyRop_CallNativeObserved on the held callable.",
    contract: "As call_native_observed; takes the held callable on both cases.");

extern helper retire_failed_held(f:Frame, fn:Src, fo:O, a:Args, e:Err) -> Err
  effects(writes, releases)
  spends(fn, a)
  c _PyRop_RetireFailedHeld as handle
  evidence(
    review: "2A. ceval.c: _PyRop_RetireFailedArgs, and the held callable closed.",
    contract: "As retire_failed_args; closes the held callable.");

extern helper hold_kwargs(f:Frame, a:Args) -> O
  effects(reads)
  c _PyRop_HoldKwargs as value
  evidence(
    review: "2A. ceval.c: the kwargs dict of the call, which call_run_ex read first.",
    contract: "A new owner of the dict, or none if the word has no kwargs operand; a count.");

extern helper retire_failed_held_ex(f:Frame, fn:Src, fo:O, ko:O, a:Args, e:Err) -> Err
  effects(writes, releases)
  spends(fn, a)
  c _PyRop_RetireFailedHeldEx as handle
  evidence(
    review: "2A. ceval.c: _PyRop_RetireFailedArgs, and the held callable and kwargs closed.",
    contract: "As retire_failed_args; closes the held callable and kwargs.");

// CallEx rows

// The positional arguments as an exact tuple, owned by the call: a count of
// the tuple the operand is, or a new tuple of the iterable
extern helper star_tuple(t:Thread, f:Frame, fn:Src, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, allocates, raises)
  c _PyRop_StarTuple as value_or_null
  evidence(
    review: "2A. ceval.c: call_args_tuple (_MAKE_CALLARGS_A_TUPLE), once per call.",
    contract: "Borrows the operands; may run __iter__ and __getitem__.");

// The child frame of a Python callee: the tuple and the kwargs dict bind in
// place; the operands and the tuple are released once it is current
extern helper push_python_ex(t:Thread, f:Frame, fn:Src, fo:O, ko:O, tup:O, a:Args, fb:Fb<Call>)
  cases(entered(c:NewFrame), err(e:Err))
  effects(reads, writes, allocates, releases, raises)
  feedback(read(entry.func_version), read(entry.plan))
  spends(fn, a)
  c _PyRop_PushPythonEx as pointer_or_raised
  evidence(
    review: "2A. ceval.c: call_run_ex's Python paths (call_bind_tuple, else"
            "eval_frame_push_and_init_ex_code with one code snapshot).",
    contract: "Takes the held callable, the held kwargs and the tuple on both cases;"
              "on failure the operands are closed with the exception set aside.  The"
              "operands stay in their homes while the binding runs.");

extern helper call_native_ex(t:Thread, f:Frame, fo:O, ko:O, tup:O, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises, releases)
  c _PyRop_CallNativeEx as value_or_null
  evidence(
    review: "2A. ceval.c: call_run_ex's _PyValue_Call.",
    contract: "Calls the held callable with the held kwargs; takes both and the tuple"
              "on both cases.");

// The CALL event of an expanded call: the callable and the first argument of
// the tuple.  Takes the tuple and gives it back; closes it if the callback raises.
extern helper call_event_ex(t:Thread, f:Frame, at:Site, fo:O, tup:O, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises, releases)
  borrows(fo)
  requires(instrumented(at))
  c _PyRop_CallEventEx as value_or_null
  evidence(
    review: "2A. ceval.c: call_run_ex's _PyEval_call_monitor.",
    contract: "The callback may run Python and raise; the held callable stays held.");

extern helper call_native_observed_ex(t:Thread, f:Frame, at:Site, fo:O, ko:O, tup:O, a:Args)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises, releases)
  requires(instrumented(at))
  c _PyRop_CallNativeObservedEx as value_or_null
  evidence(
    review: "2A. ceval.c: call_run_ex's _PyValue_Call and call_monitor_result;"
            "a function or method fires no C event.",
    contract: "Takes the held callable, the held kwargs and the tuple; the result is"
              "closed if a callback raises.");

// MaterializeKwargs rows

extern helper kwargs_pending(f:Frame, x:Local) -> Bool
  effects(reads)
  c _PyRop_KwargsPending as bool
  evidence(
    review: "2A. frame.c: frame->pending_kwargs is the local's slot.",
    contract: "A read of the frame; no memory, no failure.");

// The dict that the pending binding stands for; the pending state is cleared
extern helper new_kwargs(f:Frame, x:Local)
  cases(made(z:O), err(e:Err))
  effects(allocates, writes, raises)
  c _PyRop_NewKwargs as value_or_null
  evidence(
    review: "2A. frame.c: _PyFrame_MaterializeKwargs, without the store of the home.",
    contract: "PyDict_New runs no Python; the state is cleared only on success.");

arm MaterializeKwargs.Pending split
  effects(reads, writes, allocates, releases, raises, runs_python)
  feedback()
  exits(next, raise)
{
  entry():
    branch kwargs_pending(frame, local) -> Make(), Done();
  Done():
    exit next();
  Make():
    call new_kwargs(frame, local) {
      made -> Store();
      err -> Failed();
    }
  Store(z:O):
    publish [local = z] retire [old(local)] at MaterializeKwargs.Done;
    exit next();
  Failed(e:Err):
    exit raise(MaterializeKwargs.Failed, e);
}

// CallKw.Plan rows

// Adaptation evidence (specialize.c): whether the keyword names of the call
// have a binding plan for the function, which this writes in the site's entry
extern helper classify_call_kw(at:Site, f:Fb<Call>, fn:B, a:Args)
  cases(plan(), generator(), bound(), nonpy(), other())
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry))
  c _PyRop_ClassifyCallKw as case_index
  evidence(
    review: "2A. specialize.c: the old _Py_Specialize_CallKw: a function of the"
            "default call is plan (CALL_KW_PY) or generator (CALL_KW_PY of a"
            "generator function), a bound method of one is bound"
            "(CALL_KW_BOUND_METHOD), any other callable that is no function and no"
            "method is nonpy (CALL_KW_NON_PY); the rest is other.",
    contract: "Writes the site's entry (callable_type_version, func_version, plan)"
              "and sets no handler.  No Python runs.");

// Every test of the binding that precedes a change: the plan holds for this
// call's self slot, the arena has room, the function's defaults and
// keyword-only defaults are there
extern helper plan_fits(t:Thread, f:Frame, fn:B, a:Args, fb:Fb<Call>) -> Bool
  effects(reads)
  feedback(read(entry.plan))
  requires(exact<function>(fn))
  c _PyRop_PlanFits as bool inline
  evidence(
    review: "2A. ceval.c: the tests of call_bind_core before its first change.",
    contract: "Reads the function, its code and the self operand's home; no memory,"
              "no failure.");

// The child frame of a call that the plan binds: the function and the
// operands move to it (a temporary moves, a local is counted).  A call that
// the plan does not fit binds as push_python does.
extern helper push_plan(t:Thread, f:Frame, fn:Src, a:Args, fb:Fb<Call>)
  cases(entered(c:NewFrame), err(e:Err))
  effects(reads, writes, allocates, releases, raises)
  feedback(read(entry.plan))
  spends(fn, a)
  requires(exact<function>(fn))
  c _PyRop_PushPlan as pointer_or_raised
  evidence(
    review: "2A. ceval.c: _PyEval_call_bind_positional with the site's plan; on its"
            "decline, which precedes any change, _PyRop_PushPython.",
    contract: "The binder's tests decide: a decline changes nothing and the call binds"
              "generally.  The **kwargs dict and the *args tuple allocate, and a"
              "failure closes the operands with the exception set aside.");

// The callable is neither a function nor a bound method: CallKw.NonPy
extern helper not_python_callable(fn:B) -> Bool
  effects(reads)
  c _PyRop_NotPythonCallable as bool inline
  evidence(
    review: "2A. bytecodes.c: _CHECK_IS_NOT_PY_CALLABLE_KW.",
    contract: "Reads the word and the type; no memory, no failure.");

// The generator that a call of a generator function creates, its arguments
// bound by the site's plan and its prologue run; the operands are spent
extern helper plan_generator(t:Thread, f:Frame, fn:Src, a:Args, fb:Fb<Call>)
  cases(ok(z:O), err(e:Err))
  effects(reads, writes, allocates, releases, raises, runs_python)
  feedback(read(entry.plan))
  spends(fn, a)
  requires(exact<function>(fn))
  c _PyRop_PlanGenerator as value_or_null
  evidence(
    review: "2A. ceval.c: call_bind_core's generator branch (_PyGen_NewCall,"
            "the binding, gen_prologue), with the result handed back as an owner"
            "instead of published.",
    contract: "plan_fits proved every test.  The operands are closed on both cases;"
              "a failure leaves the destination as it was.");

macro adapt_before_use_call_kw(f:Fb<Call>, fn:Src, a:Args)
  cases(run(), changed(t:Ticket<Call>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    call classify_call_kw(site, f, use(fn), a) {
      plan -> Planned();
      generator -> Created();
      bound -> Bound();
      nonpy -> Native();
      other -> Other();
    }
  Planned():
    let cp:Candidate<Call> = candidate(CallKw.Plan);
    call install(site, f, cp) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Created():
    let cg:Candidate<Call> = candidate(CallKw.Generator);
    call install(site, f, cg) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Bound():
    let cb:Candidate<Call> = candidate(CallKw.BoundMethod);
    call install(site, f, cb) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Native():
    let cn:Candidate<Call> = candidate(CallKw.NonPy);
    call install(site, f, cn) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Call>):
    exit changed(t);
  Run():
    exit run();
}

// A function of the default call: the site's plan places the keywords, and
// a call that the plan does not fit binds generally, as the old CALL_KW_PY did
arm CallKw.Plan split
  effects(runs_python, reads, writes, allocates, releases, raises, switches_frame)
  feedback(read(entry.func_version), read(entry.plan))
  exits(enter, raise, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard function_version(use(fn), fb) else miss;
    call push_plan(thread, frame, fn, args, fb) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume CallKw.Returned;
  Failed(e:Err):
    exit raise(CallKw.Failed, e);
}

// CALL_PY_GENERAL: a function whose arguments the exact arms do not take
// (defaults, *args, **kwargs, keyword-only parameters), bound by the site's
// plan; a call that the plan does not fit binds generally
arm Call.PyGeneral split
  effects(runs_python, reads, writes, allocates, releases, raises, switches_frame)
  feedback(read(entry.func_version), read(entry.plan))
  exits(enter, raise, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard function_version(use(fn), fb) else miss;
    call push_plan(thread, frame, fn, args, fb) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume Call.Returned;
  Failed(e:Err):
    exit raise(Call.Failed, e);
}

// CALL_PY_GENERAL of a generator function: the call creates the generator
// from the site's plan; a call that the plan does not fit binds generally
// (the vectorcall)
arm Call.PlanGenerator split
  effects(runs_python, reads, writes, allocates, raises, switches_frame, releases on (dst))
  feedback(read(entry.func_version), read(entry.plan))
  exits(next, raise, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard function_version(use(fn), fb) else miss;
    guard recursion_budget(thread) else miss;
    branch plan_fits(thread, frame, use(fn), args, fb) -> Planned(), Vector();
  Planned():
    call plan_generator(thread, frame, fn, args, fb) {
      ok -> Made();
      err -> Failed();
    }
  Made(z:O):
    publish [dst = z] retire [old(dst)] at Call.Done;
    exit next();
  Failed(e:Err):
    exit raise(Call.Failed, e);
  Vector():
    call call_native(thread, frame, fn, args) {
      ok -> Result();
      err -> NativeFailed();
    }
  Result(r:O):
    publish [dst = r] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    exit next();
  NativeFailed(ne:Err):
    let saved:Err = retire_failed_args(frame, fn, args, ne);
    exit raise(Call.Failed, saved);
}

// CALL_BOUND_METHOD_GENERAL: a bound method of a function that the exact arm
// does not take (a generator function, or arguments that need defaults, *args or
// keyword-only parameters); the method is expanded, then the call pushes the
// frame or, for a generator function, creates the generator
arm Call.BoundGeneral split
  effects(runs_python, reads, writes, allocates, raises, switches_frame, releases on (dst))
  feedback(read(entry.func_version))
  exits(next, enter, raise, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard self_absent(frame, args) else miss;
    guard method_version(use(fn), fb) else miss;
    branch python_target(thread, frame, fn, args) -> Python(), Created();
  Python():
    call push_python(thread, frame, fn, args) {
      entered -> Enter();
      err -> Failed();
    }
  Enter(c:NewFrame):
    exit enter(c) resume Call.Returned;
  Failed(e:Err):
    exit raise(Call.Failed, e);
  Created():
    call call_native(thread, frame, fn, args) {
      ok -> Result();
      err -> NativeFailed();
    }
  Result(z:O):
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    exit next();
  NativeFailed(ne:Err):
    let saved:Err = retire_failed_args(frame, fn, args, ne);
    exit raise(Call.Failed, saved);
}

// The native specializations: each guards the callable (and the call's shape), calls
// the callee on the operands in their homes, and publishes the result

arm Call.Type1 split over(locals: LT; rest)
  effects(writes, reads, releases on (dst), allocates)
  feedback()
  exits(next, miss)
{
  entry():
    guard self_absent(frame, args) else miss;
    guard callee_is_type(use(fn)) else miss;
    let z:O = call_type_1(frame, args);
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    exit next();
}

arm Call.Str1 split
  effects(writes, reads, runs_python, raises, allocates, polls, releases on (dst))
  feedback()
  exits(next, raise, miss, redirect)
{
  entry():
    guard self_absent(frame, args) else miss;
    guard callee_is_str(use(fn)) else miss;
    call call_str_1(frame, args) {
      ok -> Result();
      err -> Failed();
    }
  Result(z:O):
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    branch polls(interrupt) -> Poll(), Next();
  Poll():
    call end_poll(thread, frame, next_head) {
      ok -> Next();
      moved -> PollSwitched();
      err -> PollFailed();
    }
  Next():
    exit next();
  PollFailed(pe:Err):
    exit raise(Call.PollFailed, pe);
  Failed(e:Err):
    let saved:Err = retire_failed_args(frame, fn, args, e);
    exit raise(Call.Failed, saved);
  PollSwitched(ps:Route):
    exit redirect(ps);
}

arm Call.Tuple1 split
  effects(writes, reads, runs_python, raises, allocates, polls, releases on (dst))
  feedback()
  exits(next, raise, miss, redirect)
{
  entry():
    guard self_absent(frame, args) else miss;
    guard callee_is_tuple(use(fn)) else miss;
    call call_tuple_1(frame, args) {
      ok -> Result();
      err -> Failed();
    }
  Result(z:O):
    publish [dst = z] retire [spent(args), spent(fn), old(dst)] at Call.Done;
    branch polls(interrupt) -> Poll(), Next();
  Poll():
    call end_poll(thread, frame, next_head) {
      ok -> Next();
      moved -> PollSwitched();
      err -> PollFailed();
    }
  Next():
    exit next();
  PollFailed(pe:Err):
    exit raise(Call.PollFailed, pe);
  Failed(e:Err):
    let saved:Err = retire_failed_args(frame, fn, args, e);
    exit raise(Call.Failed, saved);
  PollSwitched(ps:Route):
    exit redirect(ps);
}

arm Call.BuiltinClass split
  effects(writes, reads, runs_python, raises, allocates, polls, releases on (dst))
  feedback()
  exits(next, raise, miss, redirect)
{
  entry():
    guard builtin_class(use(fn)) else miss;
    guard recursion_clear(thread) else miss;
    call call_class_values(thread, frame, fn, args) {
      ok -> Result();
      err -> Failed();
    }
  Result(z:O):
