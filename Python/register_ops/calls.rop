    branch polls(interrupt) -> Poll(), Next();
  Poll():
    call end_poll(thread, frame, next_head) {
      ok -> Next();
      moved -> PollSwitched();
      err -> PollFailed();
    }
  Next():
    exit next();
  PollFailed(pe:Err):
    exit raise(Call.PollFailed, pe);
  Failed(e:Err):
    let saved:Err = retire_failed_args(frame, fn, args, e);
    exit raise(Call.Failed, saved);
  PollSwitched(ps:Route):
    exit redirect(ps);
}

