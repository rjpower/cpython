// A generator function of the default call: the call creates the generator
// from the plan, and the call that the plan does not fit is the vectorcall's
arm CallKw.Generator split
  effects(runs_python, reads, writes, allocates, raises, switches_frame, releases on (dst))
  feedback(read(entry.func_version), read(entry.plan))
  exits(next, raise, miss)
{
  entry():
    guard default_eval_frame(thread) else miss;
    guard function_version(use(fn), fb) else miss;
    guard recursion_budget(thread) else miss;
    branch plan_fits(thread, frame, use(fn), args, fb) -> Planned(), Vector();
  Planned():
    call plan_generator(thread, frame, fn, args, fb) {
      ok -> Made();
      err -> Failed();
    }
  Made(z:O):
    publish [dst = z] retire [old(dst)] at CallKw.Done;
    exit next();
  Failed(e:Err):
    exit raise(CallKw.Failed, e);
  Vector():
    call call_native(thread, frame, fn, args) {
      ok -> Result();
      err -> NativeFailed();
    }
  Result(r:O):
    publish [dst = r] retire [spent(args), spent(fn), old(dst)] at CallKw.Done;
    exit next();
  NativeFailed(ne:Err):
    let saved:Err = retire_failed_args(frame, fn, args, ne);
    exit raise(CallKw.Failed, saved);
}

// A bound method of a function of the default call, which has no self
