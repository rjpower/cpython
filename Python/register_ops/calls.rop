// Family interfaces of Appendix A, "Calls, frames, iteration, suspension,
// and observation".  Arms come with their batches.  Observation is a
// generated wrapper bound to a family and arm, not a family.

enum IterMode(ORDINARY_ITER, YIELD_FROM_ITER);
enum AsyncIterMode(AITER, ANEXT);
enum AwaitOrigin(AWAIT, AWAIT_AENTER, AWAIT_AEXIT);
enum YieldMode(ORDINARY_YIELD, DELEGATED_YIELD);
enum ExceptMode(ENTER_HANDLER, LEAVE_HANDLER);
enum MatchMode(ORDINARY_MATCH, GROUP_MATCH);
enum ResumeKind(FUNC_START, AFTER_YIELD, AFTER_YIELD_FROM, AFTER_AWAIT, GEN_EXPR_START);
enum PollKind(BACKEDGE, CALL_END, RESUME_POLL, JIT_EVENT);

// P4: positional calls, init cleanup, return

family Call(dst:Dst, fn:Src, self:Maybe<Src>, args:Args, fb:Fb<Call>) layout HHHVF
  exits(next, enter, raise, redirect, miss, again);

family InitResult(value:Src) layout H
  exits(next, raise);

family Return(value:Src) layout H
  exits(return, exit, raise, redirect);

// 2A: keyword and expanded calls

family CallKw(dst:Dst, fn:Src, self:Maybe<Src>, args:Args, names:Src, fb:Fb<Call>)
  layout HHHVHF
  exits(next, enter, raise, redirect, miss, again);

family CallEx(dst:Dst, fn:Src, star:Src, kwargs:Maybe<Src>, fb:Fb<Call>) layout HHHHF
  exits(next, enter, raise, redirect, miss, again);

family MaterializeKwargs(local:Local) layout H
  exits(next, raise);

// 2B: iteration

family IterOpen(pair:IterPair, source:Src, mode:Enum<IterMode>, fb:Fb<Iter>)
  layout HHIF
  exits(next, raise, miss, again);

// `second` receives the value of a dict-items pair delivery
family ForIter(item:Dst, pair:IterPair, body:Head, done:Head, fb:Fb<Iter>,
               second:Maybe<Dst>) layout HHJJFH
  exits(next, branch, jump, enter, raise, redirect, miss, again);

// 2C: async iteration, await, send, yield

family AsyncIter(dst:Dst, source:Src, mode:Enum<AsyncIterMode>) layout HHI
  exits(next, raise);

family Awaitable(dst:Dst, source:Src, origin:Enum<AwaitOrigin>) layout HHI
  exits(next, raise);

// A folded consumer can also return or yield
family Send(yielded:Dst, completed:Dst, pair:IterPair, sent:Src, done:Head,
            fb:Fb<Send>) layout HHHHJF
  exits(next, branch, enter, return, yield, raise, redirect, miss, again);

family Yield(value:Src, resume:Dst, route:Head, mode:Enum<YieldMode>) layout HHJI
  exits(yield, raise, redirect);

// 2D: exceptions

family Raise(exc:Maybe<Src>, cause:Maybe<Src>) layout HH
  exits(raise);

family Reraise(exc:Src, lasti:Maybe<Src>) layout HH
  exits(raise);

family ExceptState(mode:Enum<ExceptMode>, dst:Maybe<Dst>, exc:Src) layout IHH
  exits(next);

family ExceptMatch(dst:Dst, rest:Maybe<Dst>, exc:Src, pattern:Src,
                   mode:Enum<MatchMode>) layout HHHHI
  exits(next, raise);

// 2E: throw completion, async-for termination, exceptional context exit

family CleanupThrow(exc:Src, pair:IterPair, completed:Dst, done:Head, route:Head)
  layout HHHJJ
  exits(branch, return, raise, redirect);

// `send` is the original Send head, the origin its branch observer reports
family EndAsyncFor(exc:Src, target:Head, send:Head) layout HJJ
  exits(next, jump, raise, redirect);

family WithExit(dst:Dst, exit_fn:Src, self:Maybe<Src>, exc:Src, context:Src)
  layout HHHHH
  exits(next, raise);

// 2F: resume and polls

family Resume(kind:Enum<ResumeKind>) layout I
  exits(next, jump, raise, redirect, exit);

family Poll(kind:Enum<PollKind>) layout I
  exits(next, raise, redirect, exit);
