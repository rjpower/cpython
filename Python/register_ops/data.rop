// Family interfaces of Appendix A, "Data, bindings, constructors, and
// matching".  Arms come with their batches.

enum CellMode(MAKE, GET, MAPPING_GET, CELL_SET, CELL_DELETE, COPY_FREE);
enum TextKind(JOIN, INTERPOLATION, TEMPLATE);
enum ConvertKind(STR, REPR, ASCII);
enum PatternKind(Mapping, Sequence, Keys, Class);

// 1C: items and slices

family GetItem(dst:Dst, obj:Src, key:Src, fb:Fb<Item>)
  exits(next, enter, raise, miss, again) ops(BINARY_OP);

family SetItem(obj:Src, key:Src, value:Src, fb:Fb<Item>)
  exits(next, raise, miss, again) ops(STORE_SUBSCR);

family DelItem(obj:Src, key:Src)
  exits(next, raise) ops(DELETE_SUBSCR);

family SliceRead(dst:Dst, obj:Src, start:Src, stop:Src)
  exits(next, raise) ops(BINARY_SLICE);

family SliceWrite(obj:Src, start:Src, stop:Src, value:Src)
  exits(next, raise) ops(STORE_SLICE);

family BuildSlice(dst:Dst, parts:Span<Src>)
  exits(next, raise) ops(BUILD_SLICE);

// 1E: displays, updates, comprehension insertion, keyword merge, unpack

family Unpack(dsts:Span<Dst>, source:Src, before:U8, after:Maybe<U8>, fb:Fb<Unpack>)
  exits(next, raise, miss, again) ops(UNPACK_SEQUENCE, UNPACK_EX);

// 1F: namespaces, cells, globals, annotations, import

family Cell(mode:Enum<CellMode>, cell:Cell, value:Maybe<Src>, dst:Maybe<Dst>,
            frees:Span<Free>)
  exits(next, raise) ops(MAKE_CELL, LOAD_DEREF, STORE_DEREF, DELETE_DEREF, COPY_FREE_VARS, LOAD_FROM_DICT_OR_DEREF);

family GlobalRead(dst:Dst, name:Name, fb:Fb<Global>)
  exits(next, raise, miss, again) ops(LOAD_GLOBAL);

// 1G: text

family BuildText(dst:Dst, kind:Enum<TextKind>, parts:Span<Src>, flags:U8)
  exits(next, raise) ops(BUILD_STRING, BUILD_INTERPOLATION, BUILD_TEMPLATE);

family Convert(dst:Dst, value:Src, kind:Enum<ConvertKind>)
  exits(next, raise) ops(CONVERT_VALUE);

family Format(dst:Dst, value:Src, spec:Maybe<Src>)
  exits(next, raise) ops(FORMAT_SIMPLE, FORMAT_WITH_SPEC);

// 1H: length and patterns

family Length(dst:Dst, value:Src)
  exits(next, raise) ops(GET_LEN);

family Pattern(dst:Maybe<Dst>, subject:Src, kind:Enum<PatternKind>, cls:Maybe<Src>,
               names:Maybe<Src>, count:Maybe<U8>, mismatch:NearHead)
  exits(next, branch, raise) ops(MATCH_CLASS, MATCH_KEYS, MATCH_MAPPING, MATCH_SEQUENCE);
