family AddElement(container:Src, item:Src)
  exits(next, raise);

point AddElement.Failed(current, site, pending) keep(container) spent(item) defs();
point AddElement.Done(current, next_head, clear) keep(container) spent(item) defs();

extern helper list_append(list:Src, item:O)
  cases(ok(), err(e:Err))
  effects(writes, allocates, raises, releases, runs_python)
  c _PyRop_ListAppend as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_ListAppend: _PyList_AppendTakeValueInline: the store is in line while the list has room. The container is the word's home.",
    contract: "The item is taken on every outcome. The container is read and kept. Growth may allocate; a finalizer may run when a failed append closes the item.");

extern helper set_add(set:Src, item:O)
  cases(ok(), err(e:Err))
  effects(writes, allocates, raises, releases, runs_python)
  c _PyRop_SetAdd as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_SetAdd: _PySet_AddValueTakeRef. The container is the word's home.",
    contract: "The item is taken on every outcome. The container is read and kept. A hash or equality of the item can run Python.");

arm AddElement.Append shared select(append)
  effects(writes, allocates, raises, releases, runs_python)
  feedback()
  exits(next, raise)
{
  entry():
    let v:O = acquire(item);
    call list_append(container, v) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(AddElement.Failed, e);
  Finish():
    publish [] retire [spent(item)] at AddElement.Done;
    exit next();
}

arm AddElement.Add shared select(add)
  effects(writes, allocates, raises, releases, runs_python)
  feedback()
  exits(next, raise)
{
  entry():
    let v:O = acquire(item);
    call set_add(container, v) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(AddElement.Failed, e);
  Finish():
    publish [] retire [spent(item)] at AddElement.Done;
    exit next();
}

family AddEntry(container:Src, key:Src, value:Src)
  exits(next, raise);

point AddEntry.Failed(current, site, pending) keep(container) spent(key, value) defs();
point AddEntry.Done(current, next_head, clear) keep(container) spent(key, value) defs();

extern helper dict_put(dict:Src, key:O, value:O)
  cases(ok(), err(e:Err))
  effects(writes, allocates, raises, releases, runs_python)
  c _PyRop_DictPut as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_DictPut: _PyDict_SetValue_Take2 on the word's dict home.",
    contract: "The key and value are taken on every outcome. The dict is read and kept. A hash or equality can run Python.");

arm AddEntry.Put shared
  effects(writes, allocates, raises, releases, runs_python)
  feedback()
  exits(next, raise)
{
  entry():
    let k:O = acquire(key);
    let v:O = acquire(value);
    call dict_put(container, k, v) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(AddEntry.Failed, e);
  Finish():
    publish [] retire [spent(key), spent(value)] at AddEntry.Done;
    exit next();
}

family UpdateContainer(container:Src, source:Src)
  exits(next, raise);

point UpdateContainer.Failed(current, site, pending) keep(container, source) spent() defs();
point UpdateContainer.Done(current, next_head, clear) keep(container) spent(source) defs();

extern helper list_extend(list:Src, source:Src)
  cases(ok(), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_ListExtend as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_ListExtend: _PyList_Extend, with the TypeError text 'Value after * must be an iterable, not %.200s' for a value that has no iterator.",
    contract: "Reads the two homes and holds a count of each across the call, which runs Python. Nothing is spent: on failure the exception is set and both stay in their homes.");

extern helper set_union(set:Src, source:Src)
  cases(ok(), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_SetUnion as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_SetUnion: _PySet_Update, with the text '%.200s' object is not iterable for a number.",
    contract: "Reads the two homes and holds a count of each across the call, which runs Python. Nothing is spent: on failure the exception is set and both stay in their homes.");

extern helper dict_overlay(dict:Src, source:Src)
