// The operands are in operand order: the callable, the dict, then the mapping
family MergeKeywords(fn:Src, dict:Src, source:Src)
  exits(next, raise);

point MergeKeywords.Failed(current, site, pending) keep(fn, dict, source) spent() defs();
point MergeKeywords.Done(current, next_head, clear) keep(fn, dict) spent(source) defs();

extern helper merge_unique(fn:Src, dict:Src, source:Src)
  cases(ok(), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_MergeKeywords as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_MergeKeywords: value_dict_merge_uniq; a duplicate key or a non-mapping raises through _PyEval_FormatKwargsError, which names the callable fn.",
    contract: "Reads the three homes and holds a count of each across the call. Nothing is spent. The messages are the inherited handler's.");

arm MergeKeywords.Merge shared
  effects(allocates, raises, releases, runs_python)
  feedback()
  exits(next, raise)
{
  entry():
    call merge_unique(fn, dict, source) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(MergeKeywords.Failed, e);
  Finish():
    publish [] retire [spent(source)] at MergeKeywords.Done;
    exit next();
}

// Unpack: the values of the source, in the order of the targets, go to the
// destination homes.  The row makes them (a vector of owners) and one
// publish moves them in, closing what the homes held.

family Unpack(dsts:Span<Dst>, source:Src, fb:Fb<Unpack>)
  exits(next, raise, miss, again) generic(Generic);

point Unpack.Failed(current, site, pending) keep(source) spent() defs();
point Unpack.Done(current, next_head, clear) keep() spent(source) defs(dsts);

extern helper unpack_iterable(source:Src, n:Size)
  cases(ok(vals:Span<O>), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_UnpackIterable as owners_or_raised
  evidence(
    review: "ceval.c _PyRop_UnpackIterable: _PyEval_UnpackIterableValue on a count held across the call; a number raises the cannot-unpack text.",
    contract: "Reads the source home and keeps it. On success n owners in reverse target order (the first target last), in storage the publish frees; on failure the exception is set and nothing is made. Iterating the source runs Python.");

// The guards of the specialized arms: an exact tuple or list of n items
extern helper tuple_has_length(v:B, n:Size) -> Bool
  effects(reads)
  c _PyRop_TupleHasLength as bool
  evidence(
    review: "ceval.c _PyRop_TupleHasLength: the old _GUARD_TOS_TUPLE and the length test of _UNPACK_SEQUENCE_TUPLE.",
    contract: "Reads the type and the size. True for an object that is an exact tuple of n items.");

extern helper list_has_length(v:B, n:Size) -> Bool
  effects(reads)
  c _PyRop_ListHasLength as bool
  evidence(
    review: "ceval.c _PyRop_ListHasLength: the old _GUARD_TOS_LIST and the length test of _UNPACK_SEQUENCE_LIST.",
    contract: "Reads the type and the size. True for an object that is an exact list of n items.");

// The items, duplicated, in reverse target order.  The list's length is checked again
// in the critical section that copies it; a list that changed since the guard
// goes the generic way, which raises what the generic arm raises.
extern helper tuple_items(source:Src, n:Size)
  cases(ok(vals:Span<O>), err(e:Err))
  effects(reads, allocates, raises, runs_python)
  c _PyRop_UnpackTuple as owners_or_raised
  evidence(
    review: "ceval.c _PyRop_UnpackTuple: the old _UNPACK_SEQUENCE_TUPLE: the items are duplicated.",
    contract: "Reads the source home and keeps it. n owners in reverse target order, in storage the publish frees; err: the allocation failed, MemoryError set.");

extern helper list_items(source:Src, n:Size)
  cases(ok(vals:Span<O>), err(e:Err))
  effects(reads, allocates, raises, runs_python)
  c _PyRop_UnpackList as owners_or_raised
  evidence(
    review: "ceval.c _PyRop_UnpackList: the old _UNPACK_SEQUENCE_LIST: the length check and the copy are one critical section of the list.",
    contract: "As tuple_items, for an exact list; a list whose length changed since the guard unpacks as any iterable.");

// The specializer's evidence: an inline int or an exact tuple or list of
// another length is not nominated
extern helper classify_unpack(v:B, n:Size)
  cases(tuple(), list(), other())
  effects(reads)
  c _PyRop_ClassifyUnpack as case_index
  evidence(
    review: "ceval.c _PyRop_ClassifyUnpack: the old _Py_Specialize_UnpackSequence's refusals.",
    contract: "Reads the type and length. No Python, no failure.");

macro adapt_before_use_unpack(f:Fb<Unpack>, source:Src, n:Size)
  cases(run(), changed(t:Ticket<Unpack>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    call classify_unpack(use(source), n) {
      tuple -> ChosenTuple();
      list -> ChosenList();
      other -> NoArm();
    }
  ChosenTuple():
    let ct:Candidate<Unpack> = candidate(Unpack.Tuple);
    call install(site, f, ct) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  ChosenList():
    let cl:Candidate<Unpack> = candidate(Unpack.List);
    call install(site, f, cl) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoArm():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Unpack>):
    exit changed(t);
  Run():
    exit run();
}

arm Unpack.Generic shared
  effects(allocates, raises, releases on (dsts), runs_python)
  feedback(read(entry), write(entry), write(handler))
  exits(next, again, raise)
{
  entry():
    call adapt_before_use_unpack(fb, source, count(dsts)) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Unpack>):
    exit again(t);
  Run():
    call unpack_iterable(source, count(dsts)) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Unpack.Failed, e);
  Finish(vals:Span<O>):
    publish [dsts[] = vals] retire [spent(source), old(dsts)] at Unpack.Done;
    exit next();
}

arm Unpack.Tuple shared entry(tuple)
  effects(reads, allocates, raises, releases on (dsts), runs_python)
  feedback()
  exits(next, miss, raise)
{
  entry():
    let v:B = use(source);
    guard tuple_has_length(v, count(dsts)) else miss;
    call tuple_items(source, count(dsts)) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Unpack.Failed, e);
  Finish(vals:Span<O>):
    publish [dsts[] = vals] retire [spent(source), old(dsts)] at Unpack.Done;
    exit next();
}

arm Unpack.List shared entry(list)
  effects(reads, allocates, raises, releases on (dsts), runs_python)
  feedback()
  exits(next, miss, raise)
{
  entry():
    let v:B = use(source);
    guard list_has_length(v, count(dsts)) else miss;
    call list_items(source, count(dsts)) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Unpack.Failed, e);
  Finish(vals:Span<O>):
    publish [dsts[] = vals] retire [spent(source), old(dsts)] at Unpack.Done;
    exit next();
}

// Unpack with a starred target.  `shape` is the oparg: the count before the
// star, and in the next byte the count after it.

family UnpackStar(dsts:Span<Dst>, source:Src, shape:U16)
  exits(next, raise);

point UnpackStar.Failed(current, site, pending) keep(source) spent() defs();
point UnpackStar.Done(current, next_head, clear) keep() spent(source) defs(dsts);

extern helper unpack_star(source:Src, shape:U16)
  cases(ok(vals:Span<O>), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_UnpackStar as owners_or_raised
  evidence(
    review: "ceval.c _PyRop_UnpackStar: _PyEval_UnpackIterableValue with the variable target; the middle value is a list.",
    contract: "As unpack_iterable, with before + 1 + after owners.");

arm UnpackStar.Iterable shared
  effects(allocates, raises, releases on (dsts), runs_python)
  feedback()
  exits(next, raise)
{
  entry():
    call unpack_star(source, shape) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(UnpackStar.Failed, e);
  Finish(vals:Span<O>):
    publish [dsts[] = vals] retire [spent(source), old(dsts)] at UnpackStar.Done;
    exit next();
}
