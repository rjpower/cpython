extern helper build_set(items:Span<Src>)
  cases(ok(z:O), err(e:Err))
  effects(writes, allocates, raises, releases, runs_python)
  spends(items)
  ensures(ok.exact<set>(z))
  c _PyRop_BuildSet as value_or_null
  evidence(
    review: "ceval.c _PyRop_BuildSet: each item's owner is taken out of its home (a local's gets a count of its own), then PySet_New and _PySet_AddValueTakeRef for each item.",
    contract: "Every item is spent on every outcome: it moves into the new object or, on failure, is closed. A hash or equality of an item can run Python. The result is NULL with an exception set on failure.");

arm Build.Set shared select(set)
  effects(writes, allocates, raises, releases, runs_python)
  feedback()
  exits(next, raise)
  ensures(next.exact<set>(dst))
{
  entry():
    call build_set(items) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Build.Failed, e);
  Finish(z:O):
    publish [dst = z] retire [old(dst)] at Build.Done;
    exit next();
}

