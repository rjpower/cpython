// 1E: displays, element insertion, container updates, keyword merge.
// The arm is the kind of container, chosen by the lowering (`select`).  The
// sources of Build and the item of AddElement are spent on every outcome:
// each leaves its home, a temporary's owner moving into the container and a
// local's binding giving a count of its own.  UpdateContainer and
// MergeKeywords read their sources, keep them on failure for the unwinder,
// and retire the source (the stack op's pop) on success.

family Build(dst:Dst, items:Span<Src>)
  exits(next, raise) ops(BUILD_TUPLE, BUILD_LIST, BUILD_SET, BUILD_MAP);

point Build.Failed(current, site, pending) keep() spent(items) defs() held();
point Build.Done(current, next_head, clear) keep() spent(items) defs(dst) held();

extern helper build_tuple(items:Span<Src>)
  cases(ok(z:O), err(e:Err))
  effects(writes, allocates, raises, releases, runs_python)
  spends(items)
  ensures(ok.exact<tuple>(z))
  c _PyRop_BuildTuple as value_or_null
  evidence(
    review: "ceval.c _PyRop_BuildTuple: each item's owner is taken out of its home (a local's gets a count of its own), then Ceval.c rop_take_items, _PyTuple_FromValueStealOnSuccess.",
    contract: "Every item is spent on every outcome: it moves into the new object or, on failure, is closed (which may run a finalizer). NULL with an exception set on failure.");

arm Build.Tuple shared select(tuple)
  effects(writes, allocates, raises, releases, runs_python)
  feedback()
  exits(next, raise)
  ensures(next.exact<tuple>(dst))
{
  entry():
    call build_tuple(items) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Build.Failed, e);
  Finish(z:O):
    publish [dst = z] retire [old(dst)] at Build.Done;
    exit next();
}

