  cases(ok(z:O), err(e:Err))
  effects(writes, allocates, raises, releases, runs_python)
  spends(items)
  ensures(ok.exact<dict>(z))
  c _PyRop_BuildMap as value_or_null
  evidence(
    review: "ceval.c _PyRop_BuildMap: each item's owner is taken out of its home (a local's gets a count of its own), then _PyDict_FromValueItems over the key and value pairs.",
    contract: "Every item is spent on every outcome: it moves into the new object or, on failure, is closed. A hash or equality of an item can run Python. The result is NULL with an exception set on failure.");

arm Build.Map shared select(map)
  effects(writes, allocates, raises, releases, runs_python)
  feedback()
  exits(next, raise)
  ensures(next.exact<dict>(dst))
{
  entry():
    call build_map(items) {
