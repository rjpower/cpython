    contract: "Every item is spent on every outcome: it moves into the new object or, on failure, is closed. A hash or equality of an item can run Python. The result is NULL with an exception set on failure.");

arm Build.Map shared select(map)
  effects(writes, allocates, raises, releases on (dst), runs_python)
  feedback()
  exits(next, raise)
  ensures(next.exact<dict>(dst))
{
