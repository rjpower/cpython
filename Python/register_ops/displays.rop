    review: "ceval.c _PyRop_DictOverlay: PyDict_Update, with the '%N' object is not a mapping texts and the keys probe of the inherited handler.",
    contract: "Reads the two homes and holds a count of each across the call, which runs Python. Nothing is spent: on failure the exception is set and both stay in their homes.");

arm UpdateContainer.Extend shared select(extend)
  effects(allocates, raises, releases, runs_python)
