}

// A receiver with a dictionary slot that has no dictionary yet
arm GetMethod.LazyDict inline
  effects(reads, writes, releases)
  feedback(read(entry))
  exits(next, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    guard lazy_dict_absent(o, r) else miss;
    let method:O = dup(borrow_cached_value(r));
    let receiver:O = acquire(obj);
    publish [callable = method, self_dst = receiver]
      retire [spent(obj), old(callable), old(self_dst)] at GetMethod.Done;
    exit next();
  Miss():
    exit miss();
}

// A class receiver: the wrapped function of a classmethod, with the class as self
arm GetMethod.ClassMethod inline
  effects(reads, writes, releases)
  feedback(read(entry))
  exits(next, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard builtin_metaclass(o) else miss;
    guard class_current(o, r) else miss;
    let target:Maybe<B> = classmethod_function(r);
    guard present(target) else miss;
    let method:O = dup(unwrap(target));
    let receiver:O = acquire(obj);
    publish [callable = method, self_dst = receiver]
      retire [spent(obj), old(callable), old(self_dst)] at GetMethod.Done;
    exit next();
  Miss():
    exit miss();
}
