arm GetAttr.Class inline
  effects(reads, writes, releases)
  feedback(read(entry))
  exits(next, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard class_current(o, r) else miss;
    let result:O = dup(borrow_cached_value(r));
    publish [dst = result] retire [spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Miss():
    exit miss();
}

// A class value that is not a descriptor, under an unshadowed layout
arm GetAttr.NonDescriptorValues inline
  effects(reads, writes, releases)
  feedback(read(entry))
  exits(next, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    guard valid_inline_values(o) else miss;
    let result:O = dup(borrow_cached_value(r));
    publish [dst = result] retire [spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Miss():
    exit miss();
}

