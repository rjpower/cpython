// GetAttr: attribute load (Appendix A, batch P3).  A recipe is evidence for
// this site's name and an admitted lookup path; the duplicate precedes any
// release of the receiver.

family GetAttr(dst:Dst, obj:Src, name:Name, fb:Fb<Attr>)
  exits(next, miss, again, enter, raise, redirect) generic(Generic);

point GetAttr.Failed(current, site, pending) keep() spent(obj) defs();
point GetAttr.Done(current, next_head, clear) keep() spent(obj) defs(dst);
// The getter, entered in place, has returned: its value takes the destination
point GetAttr.Returned(caller, next_head, clear) keep() spent(obj) defs(dst);

// Instance-slot evidence: a recipe for this name on the observed type, read
// coherently from the site's entry.  Declared ahead of its C body (F2).
extern helper admitted_instance_slot(f:Fb<Attr>, n:Name)
  cases(hit(r:Recipe<Attr>), absent())
  effects(reads)
  feedback(read(entry.kind), read(entry.type_version), read(entry.offset))
  c _PyAttr_AdmittedInstanceSlot as bool_out_hit
  evidence(
    review: "pycore_attr_recipe.h: the entry is the recipe when it holds a live type version.",
    contract: "Reads the entry only; no callee, no failure. The name is the site's own,"
              "so the entry cannot belong to another name.");

// guard_current_nonzero_type_version: the object's type has the recipe's
// live nonzero version
extern primitive instance_version(o:Obj, r:Recipe<Attr>) -> Bool
  effects(reads)
  test(type_version(o, r))
  c _PyAttr_InstanceVersion as bool
  evidence(
    review: "pycore_attr_recipe.h: the type's version tag equals the recipe's, a relaxed load.",
    contract: "One load of the type, no memory write, no callee.",
    lowering: "none yet: an arm that calls it keeps the call of its form (rop_leaf has no lowering)",
    test: "test_rop_getattr row tests");

// guard_managed_inline_values_valid
extern primitive valid_inline_values(o:Obj) -> Bool
  effects(reads)
  test(has_values(o))
  c _PyAttr_ValidInlineValues as bool
  evidence(
    review: "pycore_attr_recipe.h: the valid byte of the inline values, an atomic load.",
    contract: "Requires a type with inline values, which a version match proves.",
    lowering: "none yet: an arm that calls it keeps the call of its form (rop_leaf has no lowering)",
    test: "test_rop_getattr row tests");

// The slot the recipe names; vacant on a valid instance is NULL
extern primitive borrow_value_slot(o:Obj, r:Recipe<Attr>) -> Maybe<B>
  effects(reads)
  requires(type_version(o, r), has_values(o))
  c _PyAttr_BorrowValueSlot as borrow
  evidence(
    review: "pycore_attr_recipe.h: the word at the recipe's offset in the values, as a borrow.",
    contract: "A read; NULL is a vacant slot, which is a legal value of the type.",
    lowering: "none yet: an arm that calls it keeps the call of its form (rop_leaf has no lowering)",
    test: "test_rop_getattr row tests");

arm GetAttr.Instance inline entry(instance)
  effects(reads, writes, releases on (dst))
  feedback(read(entry.kind), read(entry.type_version), read(entry.offset))
  exits(next, miss)
{
  entry():
    call admitted_instance_slot(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    guard valid_inline_values(o) else miss;
    let item:Maybe<B> = borrow_value_slot(o, r);
    guard present(item) else miss;
    let result:O = dup(unwrap(item));
    publish [dst = result] retire [spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Miss():
    exit miss();
}

// Python lookup: _PyValue_GetAttr on the receiver the anchors hold, the
// frame checked on return like binary_at_origin.  Body with the shared
// call-boundary macros.
macro getattr_at_origin(n:Name, a:Anchors)
  cases(ok(z:O), err(e:Err), redirected(r:Route))
  effects(runs_python, raises, releases)
  feedback()
  borrows(a)
{
  entry():
    call value_getattr(arg(a, 0), n) {
      ok -> Check();
      err -> Failed();
    }
  Check(value:O):
    call redirect_status(frame) {
      running -> Done(value);
      redirected -> Moved(value);
    }
  Done(kept:O):
    exit ok(kept);
  Moved(r:Route, dropped:O):
    let _:Unit = discard_result(dropped);
    exit redirected(r);
  Failed(e:Err):
    exit err(e);
}

extern helper value_getattr(v:B, n:Name)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  c _PyValue_GetAttr as value_or_null
  evidence(
    review: "pycore_value_ops.h: _PyValue_GetAttr(v, name) -> tp_getattro or the generic lookup, descriptors, __getattr__.",
    contract: "The receiver is borrowed; the result owned, or NULL with an exception set. Callbacks: arbitrary Python.");

// Adaptation evidence (specialize.c): the attribute specializer in
// collecting mode fills the site's entry, records the observation in the
// site's poly table and answers with the arm family that the receiver
// stands for.  Arms that are not written nominate "none".
extern helper classify_getattr(v:B, at:Site, f:Fb<Attr>, n:Name)
  cases(instance(r:Recipe<Attr>), shape(r:Recipe<Attr>), module(r:Recipe<Attr>),
        hint(r:Recipe<Attr>), value_slot(r:Recipe<Attr>), pointer_slot(r:Recipe<Attr>),
        class_(r:Recipe<Attr>), nondescriptor_values(r:Recipe<Attr>),
        nondescriptor_no_dict(r:Recipe<Attr>), getset(r:Recipe<Attr>),
        property(r:Recipe<Attr>), getattribute_overridden(r:Recipe<Attr>), none())
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry))
  c _PyAttr_ClassifyGetAttr as case_index
  evidence(
    review: "specialize.c attr_classify: runs _Py_Specialize_LoadAttr with its handler choice collected; the case is the choice, the recipe is the entry it wrote.",
    contract: "Writes the site's entry and poly table and sets no handler. No Python runs: the lookups are NoAlloc.");

extern helper poly_shape_ready(at:Site, f:Fb<Attr>) -> Bool
  effects(reads)
  feedback(read(entry))
  c _PyAttr_PolyShapeReady as bool
  evidence(
    review: "specialize.c: fb_shape_read_set, two to four live shape rows of distinct type versions.",
    contract: "Reads the poly table only.");

// Adaptation policy (addendum section 2): sample when the counter is due,
// nominate by evidence, and select poly when the site's table is ready.
macro adapt_before_use_getattr(f:Fb<Attr>, o:Src, n:Name)
  cases(run(), changed(t:Ticket<Attr>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    call classify_getattr(use(o), site, f, n) {
      instance -> Instance();
      shape -> Shape();
      module -> LModule();
      hint -> LHint();
      value_slot -> LValueSlot();
      pointer_slot -> LPointerSlot();
      class_ -> LClass();
      nondescriptor_values -> LNonDescriptorValues();
      nondescriptor_no_dict -> LNonDescriptorNoDict();
      getset -> LGetSet();
      property -> LProperty();
      getattribute_overridden -> LGetattribute();
      none -> Other();
    }
  Instance(ri:Recipe<Attr>):
    let ci:Candidate<Attr> = candidate(GetAttr.Instance, ri);
    call install(site, f, ci) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Shape(rs:Recipe<Attr>):
    branch poly_shape_ready(site, f) -> Poly(), Mono(rs);
  Poly():
    let cp:Candidate<Attr> = candidate(GetAttr.PolyShape);
    call install(site, f, cp) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Mono(rm:Recipe<Attr>):
    let cm:Candidate<Attr> = candidate(GetAttr.Shape, rm);
    call install(site, f, cm) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LModule(rModule:Recipe<Attr>):
    let cLModule:Candidate<Attr> = candidate(GetAttr.Module, rModule);
    call install(site, f, cLModule) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LHint(rHint:Recipe<Attr>):
    let cLHint:Candidate<Attr> = candidate(GetAttr.Hint, rHint);
    call install(site, f, cLHint) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LValueSlot(rValueSlot:Recipe<Attr>):
    let cLValueSlot:Candidate<Attr> = candidate(GetAttr.ValueSlot, rValueSlot);
    call install(site, f, cLValueSlot) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LPointerSlot(rPointerSlot:Recipe<Attr>):
    let cLPointerSlot:Candidate<Attr> = candidate(GetAttr.PointerSlot, rPointerSlot);
    call install(site, f, cLPointerSlot) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LClass(rClass:Recipe<Attr>):
    let cLClass:Candidate<Attr> = candidate(GetAttr.Class, rClass);
    call install(site, f, cLClass) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LNonDescriptorValues(rNonDescriptorValues:Recipe<Attr>):
    let cLNonDescriptorValues:Candidate<Attr> = candidate(GetAttr.NonDescriptorValues, rNonDescriptorValues);
    call install(site, f, cLNonDescriptorValues) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LNonDescriptorNoDict(rNonDescriptorNoDict:Recipe<Attr>):
    let cLNonDescriptorNoDict:Candidate<Attr> = candidate(GetAttr.NonDescriptorNoDict, rNonDescriptorNoDict);
    call install(site, f, cLNonDescriptorNoDict) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LGetSet(rGetSet:Recipe<Attr>):
    let cLGetSet:Candidate<Attr> = candidate(GetAttr.GetSet, rGetSet);
    call install(site, f, cLGetSet) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LProperty(rProperty:Recipe<Attr>):
    let cLProperty:Candidate<Attr> = candidate(GetAttr.Property, rProperty);
    call install(site, f, cLProperty) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LGetattribute(rGetattribute:Recipe<Attr>):
    let cLGetattribute:Candidate<Attr> = candidate(GetAttr.GetattributeOverridden, rGetattribute);
    call install(site, f, cLGetattribute) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Attr>):
    exit changed(t);
  Run():
    exit run();
}

// A getset descriptor with a value getter, found under the owner's type
// version.  The getter runs Python, so the call is anchored like Generic's;
// a miss before it leaves the word to Generic.
macro getset_at_origin(recipe:Recipe<Attr>, a:Anchors)
  cases(ok(z:O), err(e:Err), redirected(r:Route))
  effects(runs_python, raises, releases)
  feedback()
  borrows(a)
{
  entry():
    call value_getset_read(recipe, arg(a, 0)) {
      ok -> Check();
      err -> Failed();
    }
  Check(value:O):
    call redirect_status(frame) {
      running -> Done(value);
      redirected -> Moved(value);
    }
  Done(kept:O):
    exit ok(kept);
  Moved(r:Route, dropped:O):
    let _:Unit = discard_result(dropped);
    exit redirected(r);
  Failed(e:Err):
    exit err(e);
}

extern helper value_getset_read(recipe:Recipe<Attr>, v:B)
  cases(ok(z:O), err(e:Err))
  effects(runs_python, raises)
  c _PyAttr_GetSetRead as value_or_null
  evidence(
    review: "descrobject.c _PyGetSet_ValueRead: the descriptor's value getter, called with the owner.",
    contract: "The descriptor is loaded from the recipe inside the call and the owner is borrowed, as the old handler did; the result owned, or NULL with an exception set. Callbacks: arbitrary Python (the getter).");

arm GetAttr.GetSet inline entry(getset)
  effects(runs_python, raises, releases on (dst))
  feedback(read(entry))
  exits(next, miss, raise, redirect)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    let a:Anchors = anchor_for_call([obj]);
    call getset_at_origin(r, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [obj], e);
    exit raise(GetAttr.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
  Miss():
    exit miss();
}

// The getter of a property or an overridden __getattribute__ runs in a frame
// of the loading activation, as golden87's LOAD_ATTR_PROPERTY and
// LOAD_ATTR_GETATTRIBUTE_OVERRIDDEN pushed it.  The recipe holds the type
// version, the function's version and the function itself.
extern helper attr_frame_ready(t:Thread, r:Recipe<Attr>) -> Bool
  effects(reads)
  c _PyAttr_FrameReady as bool
  evidence(
    review: "bytecodes.c _LOAD_ATTR_PROPERTY_FRAME and _LOAD_ATTR_GETATTRIBUTE_OVERRIDDEN_FRAME: the function's version is the recipe's and the thread has frame space for its frame.",
    contract: "Reads the function and its code; no memory, no failure.");

extern helper push_property(t:Thread, f:Frame, at:Site, o:Src, r:Recipe<Attr>) -> NewFrame
  effects(reads, writes, releases)
  spends(o)
  c _PyAttr_PushProperty as pointer
  evidence(
    review: "bytecodes.c _LOAD_ATTR_PROPERTY_FRAME: the getter's frame, with the owner moved into its first slot.",
    contract: "Infallible: the guards checked the version and the frame space. A local owner is counted.");

extern helper push_getattribute(t:Thread, f:Frame, at:Site, o:Src, n:Name, r:Recipe<Attr>) -> NewFrame
  effects(reads, writes, releases)
  spends(o)
  c _PyAttr_PushGetattribute as pointer
  evidence(
    review: "bytecodes.c _LOAD_ATTR_GETATTRIBUTE_OVERRIDDEN_FRAME: the frame of __getattribute__, with the owner and the name as its arguments.",
    contract: "Infallible: the guards checked the version and the frame space. A local owner is counted.");

arm GetAttr.Property split entry(property)
  effects(runs_python, reads, writes, releases, switches_frame)
  feedback(read(entry))
  exits(enter, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    guard default_eval_frame(thread) else miss;
    guard attr_frame_ready(thread, r) else miss;
    let c:NewFrame = push_property(thread, frame, site, obj, r);
    exit enter(c) resume GetAttr.Returned;
  Miss():
    exit miss();
}

arm GetAttr.GetattributeOverridden split entry(getattribute_overridden)
  effects(runs_python, reads, writes, releases, switches_frame)
  feedback(read(entry))
  exits(enter, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    guard default_eval_frame(thread) else miss;
    guard attr_frame_ready(thread, r) else miss;
    let c:NewFrame = push_getattribute(thread, frame, site, obj, name, r);
    exit enter(c) resume GetAttr.Returned;
  Miss():
    exit miss();
}

// What Generic runs in a frame of this activation: the owner's type has a
// property with a Python getter or a Python __getattribute__ that
// the specializer would take (the guards of the two arms above, found by the
// lookup of the specializer's)
extern helper attr_frame_claimable(t:Thread, o:B, n:Name) -> Bool
  effects(reads)
  c _PyAttr_FrameClaimable as bool
  evidence(
    review: "specialize.c: analyze_descriptor_load names a property or an overridden __getattribute__ whose function takes exactly its arguments; PEP 523 is not hooked, the thread has recursion and frame space.",
    contract: "Reads the owner's type and the function; no memory, no failure. The answer holds until Python runs.");

extern helper push_attr_frame(t:Thread, f:Frame, at:Site, o:Src, n:Name) -> NewFrame
  effects(reads, writes, releases)
  spends(o)
  c _PyAttr_PushFrame as pointer
  evidence(
    review: "specialize.c: the function of attr_frame_claimable, entered as the two arms above enter theirs.",
    contract: "Infallible after attr_frame_claimable with no Python run between. A local owner is counted.");

arm GetAttr.Generic split
  effects(runs_python, reads, writes, raises, releases on (dst), switches_frame)
  feedback(read(entry), write(entry), write(handler))
  exits(next, again, enter, raise, redirect)
{
  entry():
    call adapt_before_use_getattr(fb, obj, name) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Attr>):
    exit again(t);
  Run():
    branch attr_frame_claimable(thread, use(obj), name) -> Framed(), Lookup();
  Framed():
    let c:NewFrame = push_attr_frame(thread, frame, site, obj, name);
    exit enter(c) resume GetAttr.Returned;
  Lookup():
    let a:Anchors = anchor_for_call([obj]);
    call getattr_at_origin(name, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [obj], e);
    exit raise(GetAttr.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

// Shape evidence: the site's recipe when it holds a shape read
extern helper admitted_shape(f:Fb<Attr>, n:Name)
  cases(hit(r:Recipe<Attr>), absent())
  effects(reads)
  feedback(read(entry.kind), read(entry.type_version), read(entry.shape), read(entry.offset))
  c _PyAttr_AdmittedShape as bool_out_hit
  evidence(
    review: "pycore_attr_recipe.h: the entry is the recipe when its read kind is a shape read.",
    contract: "Reads the entry only; no callee, no failure.");

// The owner's shape is the recipe's.  An owner has a shape only while it has
// valid inline values, and a shape names the slots that are filled.
extern primitive shape_current(o:Obj, r:Recipe<Attr>) -> Bool
  effects(reads)
  requires(type_version(o, r))
  test(has_values(o))
  c _PyAttr_ShapeCurrent as bool
  evidence(
    review: "pycore_attr_recipe.h: the shape byte of the inline values equals the recipe's.",
    contract: "One load. The shape is _Py_SHAPE_NONE for an owner with a dictionary or invalid values.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

// A slot that the type version and the shape prove filled
extern primitive borrow_shape_slot(o:Obj, r:Recipe<Attr>) -> B
  effects(reads)
  requires(type_version(o, r), has_values(o))
  c _PyAttr_BorrowValueSlotFilled as borrow
  evidence(
    review: "pycore_attr_recipe.h: the word at the recipe's offset; asserted not NULL.",
    contract: "A read; the shape names the slot as filled, so the borrow is a value.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

// The row of a poly table for the owner's type and shape: the whole
// recipe of that observation.
extern helper poly_shape(fr:Frame, f:Fb<Attr>, o:Obj)
  cases(hit(r:Recipe<Attr>), absent())
  effects(reads)
  feedback(read(entry.rows))
  ensures(hit.type_version(o, r), hit.has_values(o))
  c _PyAttr_PolyShape as bool_out_hit
  evidence(
    review: "pycore_attr_recipe.h: the row of the owner's version whose shape is the owner's.",
    contract: "Reads the site's poly table; no callee. The hit carries the version and the shape that it matched.");

arm GetAttr.Shape inline entry(shape)
  effects(reads, writes, releases on (dst))
  feedback(read(entry.kind), read(entry.type_version), read(entry.shape), read(entry.offset))
  exits(next, miss)
{
  entry():
    call admitted_shape(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    guard shape_current(o, r) else miss;
    let result:O = dup(borrow_shape_slot(o, r));
    publish [dst = result] retire [spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Miss():
    exit miss();
}

// Two to four compatible recipes of one site: the row of the owner's type
arm GetAttr.PolyShape inline
  effects(reads, writes, releases on (dst))
  feedback(read(entry))
  exits(next, miss)
{
  entry():
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    call poly_shape(frame, fb, o) {
      hit -> Read();
      absent -> Miss();
    }
  Read(r:Recipe<Attr>):
    let result:O = dup(borrow_shape_slot(o, r));
    publish [dst = result] retire [spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Miss():
    exit miss();
}

// Further lookup paths.  Each arm reads the recipe its site's entry holds
// and guards every correlated fact before it duplicates the result.

extern helper admitted_recipe(f:Fb<Attr>, n:Name)
  cases(hit(r:Recipe<Attr>), absent())
  effects(reads)
  feedback(read(entry.kind), read(entry.type_version), read(entry.keys_version),
           read(entry.offset), read(entry.class_value))
  c _PyAttr_AdmittedRecipe as bool_out_hit
  evidence(
    review: "pycore_attr_recipe.h: the entry is the recipe when it holds a type, class or keys version.",
    contract: "Reads the entry only; no callee, no failure.");

extern primitive is_module(o:Obj) -> Bool
  effects(reads)
  test(exact<module>(o))
  c _PyAttr_IsModule as bool
  evidence(
    review: "pycore_attr_recipe.h: PyModule_CheckExact.",
    contract: "One load of the type.",
    lowering: "jit_lower.c LOWERING(PyModule_CheckExact) after Py_TYPE: not wired for this row yet",
    test: "test_rop_getattr row tests");

// The module dictionary's entry when its keys have the recipe's version
extern primitive module_entry(o:Obj, r:Recipe<Attr>) -> Maybe<B>
  effects(reads)
  requires(exact<module>(o))
  c _PyAttr_ModuleEntry as borrow
  evidence(
    review: "pycore_attr_recipe.h: keys version, entry count and value of the module's dictionary.",
    contract: "Reads the dictionary and its keys; NULL is absent.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

// The managed dictionary's entry at the recipe's hint when its key is the name
extern primitive hinted_entry(o:Obj, n:Name, r:Recipe<Attr>) -> Maybe<B>
  effects(reads)
  requires(type_version(o, r))
  c _PyAttr_HintedEntry as borrow
  evidence(
    review: "pycore_attr_recipe.h: the managed dict's combined keys at the hint, key identity.",
    contract: "Reads the dictionary; NULL is absent.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

// A member slot of the owner (a value slot): vacant is absent
extern primitive borrow_member_slot(o:Obj, r:Recipe<Attr>) -> Maybe<B>
  effects(reads)
  requires(type_version(o, r))
  c _PyAttr_BorrowValueSlot as borrow
  evidence(
    review: "pycore_attr_recipe.h: the word at the recipe's offset in the owner.",
    contract: "A read; NULL is a vacant slot.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

extern primitive borrow_pointer_slot(o:Obj, r:Recipe<Attr>) -> Maybe<B>
  effects(reads)
  requires(type_version(o, r))
  c _PyAttr_BorrowPointerSlot as borrow
  evidence(
    review: "pycore_attr_recipe.h: a PyObject * field of the owner as an object word.",
    contract: "A read; a NULL field is absent.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

extern primitive class_current(o:Obj, r:Recipe<Attr>) -> Bool
  effects(reads)
  c _PyAttr_ClassCurrent as bool
  evidence(
    review: "pycore_attr_recipe.h: the owner is a class of the recipe's version, under the recipe's metaclass version when it has one.",
    contract: "Loads of two version tags.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

extern primitive builtin_metaclass(o:Obj) -> Bool
  effects(reads)
  c _PyAttr_BuiltinMetaclass as bool
  evidence(
    review: "pycore_attr_recipe.h: the owner's type is exactly type; false on a free-threaded build.",
    contract: "One load of the type.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

extern primitive lazy_dict_absent(o:Obj, r:Recipe<Attr>) -> Bool
  effects(reads)
  requires(type_version(o, r))
  c _PyAttr_LazyDictAbsent as bool
  evidence(
    review: "pycore_attr_recipe.h: the dictionary slot at the recipe's offset holds NULL.",
    contract: "One acquire load.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

extern primitive classmethod_function(r:Recipe<Attr>) -> Maybe<B>
  effects(reads)
  c _PyAttr_ClassMethodFunction as borrow
  evidence(
    review: "pycore_attr_recipe.h: the classmethod object's wrapped Python function.",
    contract: "Reads the classmethod; absent unless it wraps a Python function.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

arm GetAttr.Module inline entry(module)
  effects(reads, writes, releases on (dst))
  feedback(read(entry))
  exits(next, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard is_module(o) else miss;
    let item:Maybe<B> = module_entry(o, r);
    guard present(item) else miss;
    let result:O = dup(unwrap(item));
    publish [dst = result] retire [spent(obj), old(dst)] at GetAttr.Done;
    exit next();
  Miss():
    exit miss();
}

