// GetMethod: the method form of attribute lookup.  It publishes the callable
// and, in its own home, the receiver or an absent self.

family GetMethod(callable:Dst, self_dst:Maybe<Dst>, obj:Src, name:Name, fb:Fb<Attr>)
  exits(next, miss, again, raise, redirect) generic(Generic);

point GetMethod.Failed(current, site, pending) keep() spent(obj) defs();
point GetMethod.Done(current, next_head, clear) keep() spent(obj) defs(callable, self_dst);

// Method evidence: the site's recipe when it names an unshadowed method of
// the observed type
extern helper admitted_method(f:Fb<Attr>, n:Name)
  cases(hit(r:Recipe<Attr>), absent())
  effects(reads)
  feedback(read(entry.type_version), read(entry.class_value))
  c _PyAttr_AdmittedMethod as bool_out_hit
  evidence(
    review: "pycore_attr_recipe.h: the entry is the recipe when it holds a live type version and a method.",
    contract: "Reads the entry only; no callee, no failure.");

// The method object the recipe caches, under its guard
extern primitive receiver_valid(o:Obj, r:Recipe<Attr>) -> Bool
  effects(reads)
  c _PyAttr_ValidReceiver as bool
  evidence(
    review: "pycore_attr_recipe.h: a values-layout row needs the receiver's inline values valid.",
    contract: "One load of the valid byte, only for a values-layout recipe.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

extern helper poly_method(fr:Frame, f:Fb<Attr>, o:Obj)
  cases(hit(r:Recipe<Attr>), absent())
  effects(reads)
  feedback(read(entry.rows))
  ensures(hit.type_version(o, r))
  c _PyAttr_PolyMethod as bool_out_hit
  evidence(
    review: "pycore_attr_recipe.h: the row of the owner's type version in the site's poly table.",
    contract: "Reads the poly table; no callee. The hit carries the version it matched.");

extern primitive borrow_cached_value(r:Recipe<Attr>) -> B
  effects(reads)
  c _PyAttr_BorrowMethod as borrow
  evidence(
    review: "pycore_attr_recipe.h: _PyValueGuarded_Load of the entry's class value.",
    contract: "A read of the recipe's own payload; an object with the method-descriptor flag.",
    lowering: "none yet: an arm that calls it keeps the call of its form",
    test: "test_rop_getattr row tests");

// _PyValue_GetMethod on the receiver the anchors hold: the callable and
// either the receiver (an unbound method) or an absent self
macro getmethod_at_origin(n:Name, a:Anchors)
  cases(ok(f:O, s:Maybe<O>), err(e:Err), redirected(r:Route))
  effects(runs_python, raises, releases)
  feedback()
  borrows(a)
{
  entry():
    call value_getmethod(arg(a, 0), n) {
      ok -> Check();
      err -> Failed();
    }
  Check(callable:O, receiver:Maybe<O>):
    call redirect_status(frame) {
      running -> Done(callable, receiver);
      redirected -> Moved(callable, receiver);
    }
  Done(kept:O, self_kept:Maybe<O>):
    exit ok(kept, self_kept);
  Moved(r:Route, dropped:O, self_dropped:Maybe<O>):
    let _:Unit = discard_result(dropped);
    let _:Unit = discard_maybe_result(self_dropped);
    exit redirected(r);
  Failed(e:Err):
    exit err(e);
}

// The callable, and the receiver as an owner when the callable is an unbound
// method (absent when the attribute itself was found)
extern helper value_getmethod(v:B, n:Name)
  cases(ok(f:O, s:Maybe<O>), err(e:Err))
  effects(runs_python, raises)
  c _PyAttr_GetMethod as value_out_or_null
  evidence(
    review: "pycore_attr_recipe.h: _PyValue_GetMethod, the receiver duplicated for an unbound method.",
    contract: "The receiver is borrowed; the callable owned and the self owned or absent, or NULL with an exception set. Callbacks: arbitrary Python.");

extern helper discard_maybe_result(z:Maybe<O>) -> Unit
  effects(releases)
  c _PyRop_DiscardMaybe as unit
  evidence(
    review: "pycore_attr_recipe.h: PyValue_XCLOSE of an optional owner.",
    contract: "Takes the owner if there is one. A finalizer may run Python. It does not fail.");

extern helper classify_getmethod(v:B, at:Site, f:Fb<Attr>, n:Name)
  cases(method_values(r:Recipe<Attr>), no_dict(r:Recipe<Attr>), lazy_dict(r:Recipe<Attr>),
        classmethod(r:Recipe<Attr>), module(r:Recipe<Attr>), none())
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry))
  c _PyAttr_ClassifyGetMethod as case_index
  evidence(
    review: "specialize.c attr_classify: as classify_getattr, for a word with the method bit.",
    contract: "Writes the site's entry and poly table and sets no handler.");

extern helper poly_method_ready(at:Site, f:Fb<Attr>) -> Bool
  effects(reads)
  feedback(read(entry))
  c _PyAttr_PolyMethodReady as bool
  evidence(
    review: "specialize.c: fb_method_poly_set, two to four method rows of distinct type versions.",
    contract: "Reads the poly table only.");

macro adapt_before_use_getmethod(f:Fb<Attr>, o:Src, n:Name)
  cases(run(), changed(t:Ticket<Attr>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    call classify_getmethod(use(o), site, f, n) {
      method_values -> Method();
      no_dict -> NoDictCheck();
      lazy_dict -> LLazyDict();
      classmethod -> LClassMethod();
      module -> LModule();
      none -> Other();
    }
  Method(rr:Recipe<Attr>):
    branch poly_method_ready(site, f) -> Poly(), Mono(rr);
  Poly():
    let cp:Candidate<Attr> = candidate(GetMethod.PolyMethod);
    call install(site, f, cp) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Mono(r:Recipe<Attr>):
    let cm:Candidate<Attr> = candidate(GetMethod.MethodValues, r);
    call install(site, f, cm) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoDictCheck(rn:Recipe<Attr>):
    branch poly_method_ready(site, f) -> Poly(), LNoDict(rn);
  LNoDict(rNoDict:Recipe<Attr>):
    let cLNoDict:Candidate<Attr> = candidate(GetMethod.NoDict, rNoDict);
    call install(site, f, cLNoDict) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LLazyDict(rLazyDict:Recipe<Attr>):
    let cLLazyDict:Candidate<Attr> = candidate(GetMethod.LazyDict, rLazyDict);
    call install(site, f, cLLazyDict) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LClassMethod(rClassMethod:Recipe<Attr>):
    let cLClassMethod:Candidate<Attr> = candidate(GetMethod.ClassMethod, rClassMethod);
    call install(site, f, cLClassMethod) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  LModule(rModule:Recipe<Attr>):
    let cLModule:Candidate<Attr> = candidate(GetMethod.Module, rModule);
    call install(site, f, cLModule) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Attr>):
    exit changed(t);
  Run():
    exit run();
}

arm GetMethod.MethodValues inline entry(method_values)
  effects(reads, writes, releases on (callable, self_dst))
  feedback(read(entry.type_version), read(entry.class_value))
  exits(next, miss)
{
  entry():
    call admitted_method(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard instance_version(o, r) else miss;
    guard valid_inline_values(o) else miss;
    let method:O = dup(borrow_cached_value(r));
    let receiver:O = acquire(obj);
    publish [callable = method, self_dst = receiver]
      retire [spent(obj), old(callable), old(self_dst)] at GetMethod.Done;
    exit next();
  Miss():
    exit miss();
}

arm GetMethod.Generic shared
  effects(runs_python, raises, releases on (callable, self_dst))
  feedback(read(entry), write(entry), write(handler))
  exits(next, again, raise, redirect)
{
  entry():
    call adapt_before_use_getmethod(fb, obj, name) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Attr>):
    exit again(t);
  Run():
    let a:Anchors = anchor_for_call([obj]);
    call getmethod_at_origin(name, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(f:O, s:Maybe<O>):
    publish [callable = f, self_dst = s]
      retire [roots(a), spent(obj), old(callable), old(self_dst)] at GetMethod.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [obj], e);
    exit raise(GetMethod.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

// A module receiver (LOAD_ATTR_MODULE with the method bit): the attribute is
// the callable and there is no self
arm GetMethod.Module inline entry(module)
  effects(reads, writes, releases on (callable, self_dst))
  feedback(read(entry))
  exits(next, miss)
{
  entry():
    call admitted_recipe(fb, name) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    guard is_module(o) else miss;
    let item:Maybe<B> = module_entry(o, r);
    guard present(item) else miss;
    let method:O = dup(unwrap(item));
    publish [callable = method, self_dst = null]
      retire [spent(obj), old(callable), old(self_dst)] at GetMethod.Done;
    exit next();
  Miss():
    exit miss();
}

// Two to four method rows of one site: the row of the receiver's type, with
// its own shadowing guard
arm GetMethod.PolyMethod inline
  effects(reads, writes, releases on (callable, self_dst))
  feedback(read(entry.kind), read(entry.rows))
  exits(next, miss)
{
  entry():
    let v:B = use(obj);
    guard is_object(v) else miss;
    let o:Obj = as_object(v);
    call poly_method(frame, fb, o) {
      hit -> Check();
      absent -> Miss();
    }
  Check(r:Recipe<Attr>):
    guard receiver_valid(o, r) else miss;
    let method:O = dup(borrow_cached_value(r));
    let receiver:O = acquire(obj);
    publish [callable = method, self_dst = receiver]
      retire [spent(obj), old(callable), old(self_dst)] at GetMethod.Done;
    exit next();
  Miss():
    exit miss();
}

