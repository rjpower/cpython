// Arms

arm GetItem.ListIndex inline entry(list_index)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next, miss)
{
  entry():
    let l:B = use(obj);
    let i:B = use(key);
    guard exact_list(l) else miss;
    guard inline_int_key(i) else miss;
    guard list_in_bounds(l, i) else miss;
    let item:B = list_item(l, i);
    let result:O = dup(item);
    publish [dst = result] retire [spent(key), spent(obj), old(dst)] at GetItem.Done;
    exit next();
}

arm GetItem.TupleIndex inline entry(tuple_index)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next, miss)
{
  entry():
    let l:B = use(obj);
    let i:B = use(key);
    guard exact_tuple(l) else miss;
    guard inline_int_key(i) else miss;
    guard tuple_in_bounds(l, i) else miss;
    let item:B = tuple_item(l, i);
    let result:O = dup(item);
    publish [dst = result] retire [spent(key), spent(obj), old(dst)] at GetItem.Done;
    exit next();
}

arm GetItem.Ascii inline entry(ascii)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next, miss)
{
  entry():
    let l:B = use(obj);
    let i:B = use(key);
    guard compact_ascii_str(l) else miss;
    guard inline_int_key(i) else miss;
    guard str_in_bounds(l, i) else miss;
    let item:B = ascii_char(l, i);
    let result:O = dup(item);
    publish [dst = result] retire [spent(key), spent(obj), old(dst)] at GetItem.Done;
    exit next();
}

arm GetItem.UnicodeAsciiChar inline entry(unicode_char)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next, miss)
{
  entry():
    let l:B = use(obj);
    let i:B = use(key);
    guard exact_str(l) else miss;
    guard inline_int_key(i) else miss;
    guard str_in_bounds(l, i) else miss;
    let item:Maybe<B> = unicode_ascii_char(l, i);
    guard present(item) else miss;
    let result:O = dup(unwrap(item));
    publish [dst = result] retire [spent(key), spent(obj), old(dst)] at GetItem.Done;
    exit next();
}

arm GetItem.ListSlice shared entry(list_slice)
  effects(runs_python, raises, releases on (dst))
  feedback()
  exits(next, miss, raise, redirect)
{
  entry():
    let l:B = use(obj);
    let s:B = use(key);
    guard exact_list(l) else miss;
    guard exact_slice(s) else miss;
    let a:Anchors = anchor_for_call([obj, key]);
    call list_slice_at_origin(a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(key), spent(obj), old(dst)] at GetItem.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [key, obj], e);
    exit raise(GetItem.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

arm GetItem.Dict inline entry(dict)
  effects(runs_python, raises, writes, releases on (dst))
  feedback()
  exits(next, miss, raise, redirect)
{
  entry():
    let l:B = use(obj);
    let i:B = use(key);
    guard dict_subscript_slot(l) else miss;
    call dict_first_probe(l, i) {
      hit -> Hit();
      absent -> Slow();
    }
  Hit(first:O):
    publish [dst = first] retire [spent(key), spent(obj), old(dst)] at GetItem.Done;
    exit next();
  Slow():
    let a:Anchors = anchor_for_call([obj, key]);
    call getitem_at_origin(a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(key), spent(obj), old(dst)] at GetItem.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [key, obj], e);
    exit raise(GetItem.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

arm SetItem.ListIndex inline entry(list_index)
  effects(reads, writes, releases, runs_python, raises)
  feedback()
  exits(next, miss, raise, redirect)
{
  entry():
    let l:B = use(obj);
    let i:B = use(key);
    guard exact_list(l) else miss;
    guard inline_int_key(i) else miss;
    guard list_in_bounds(l, i) else miss;
    let w:B = use(value);
    call list_exchange_locked(l, i, w) {
      hit -> Stored();
      absent -> Slow();
    }
  Stored(old:O):
    publish [] retire [owned(old), spent(key), spent(obj), spent(value)] at SetItem.Done;
    exit next();
  Slow():
    let a:Anchors = anchor_for_call([obj, key, value]);
    call setitem_at_origin(a) {
      ok -> Slowed();
      err -> Failed();
      redirected -> Gone();
    }
  Slowed():
    publish [] retire [roots(a), spent(key), spent(obj), spent(value)] at SetItem.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [key, obj, value], e);
    exit raise(SetItem.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

arm SetItem.Dict inline entry(dict)
  effects(runs_python, raises)
  feedback()
  exits(next, miss, raise, redirect)
{
  entry():
    let l:B = use(obj);
    guard dict_assign_slot(l) else miss;
    let a:Anchors = anchor_for_call([obj, key, value]);
    call dict_store_at_origin(a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result():
    publish [] retire [roots(a), spent(key), spent(obj), spent(value)] at SetItem.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [key, obj, value], e);
    exit raise(SetItem.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}
