// 1F1: namespace reads and writes, annotation setup, import (Appendix A).
// Each stack op names its namespace statically, so the arm is the scope:
// the word carries no scope operand.  Every source is acquired before the
// row runs, because every row can run Python (a mapping's __getitem__, a
// finalizer, an import hook).  A deletion is its own family: it has no
// source.

// NamespaceRead: the value of a name in the code's namespace.  Name is the
// locals, then the globals, then the builtins; Locals is the namespace
// itself; BuildClass is the builtins' __build_class__.  Locals and
// BuildClass read no name: their word's name field is 0.
family NamespaceRead(dst:Dst, name:Name)
  exits(next, raise) ops(LOAD_NAME, LOAD_LOCALS, LOAD_BUILD_CLASS);

point NamespaceRead.Failed(current, site, pending) keep() spent() defs() held();
point NamespaceRead.Done(current, next_head, clear) keep() spent() defs(dst) held();

extern helper load_name(t:Thread, fr:Frame, n:Name)
  cases(ok(z:O), err(e:Err))
  effects(raises, runs_python)
  c _PyEval_LoadName as value_or_null
  evidence(
    review: "ceval.c _PyEval_LoadName: locals, then globals (a lazy import is reified), then builtins.",
    contract: "The result owned, or NULL with an exception set (NameError, SystemError for no locals). Callbacks: a mapping's __getitem__.");

extern helper load_locals(t:Thread, fr:Frame)
  cases(ok(z:O), err(e:Err))
  effects(reads, allocates, raises)
  c _PyRop_LoadLocals as value_or_null
  evidence(
    review: "ceval.c _PyRop_LoadLocals: a new owner of the frame's locals.",
    contract: "The result owned, or NULL with SystemError when the frame has no locals. No Python.");

extern helper load_build_class(t:Thread, fr:Frame)
  cases(ok(z:O), err(e:Err))
  effects(reads, allocates, raises, runs_python)
  c _PyRop_LoadBuildClass as value_or_null
  evidence(
    review: "ceval.c _PyRop_LoadBuildClass: the builtins' __build_class__, as LOAD_BUILD_CLASS read it.",
    contract: "The result owned, or NULL with NameError. Callbacks: a builtins mapping's __getitem__.");

arm NamespaceRead.Name shared select(named)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    call load_name(thread, frame, name) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at NamespaceRead.Done;
    exit next();
  Failed(e:Err):
    exit raise(NamespaceRead.Failed, e);
}

arm NamespaceRead.Locals shared select(locals_scope)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    call load_locals(thread, frame) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at NamespaceRead.Done;
    exit next();
  Failed(e:Err):
    exit raise(NamespaceRead.Failed, e);
}

arm NamespaceRead.BuildClass shared select(build_class_scope)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    call load_build_class(thread, frame) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at NamespaceRead.Done;
    exit next();
  Failed(e:Err):
    exit raise(NamespaceRead.Failed, e);
}

// The class namespace (or any mapping) first, then the globals and
// builtins.  The mapping is consumed on every path.
family NamespaceReadFrom(dst:Dst, mapping:Src, name:Name)
  exits(next, raise) ops(LOAD_FROM_DICT_OR_GLOBALS);

point NamespaceReadFrom.Failed(current, site, pending) keep() spent(mapping) defs() held();
point NamespaceReadFrom.Done(current, next_head, clear) keep() spent(mapping) defs(dst) held();

extern helper load_from_mapping(t:Thread, fr:Frame, d:O, n:Name)
  cases(ok(z:O), err(e:Err))
  effects(reads, allocates, raises, releases, runs_python)
  c _PyRop_LoadFromMapping as value_or_null
  evidence(
    review: "ceval.c _PyRop_LoadFromMapping: LOAD_FROM_DICT_OR_GLOBALS: value_load_from_dict on the mapping, which is closed before the fallback to value_load_global.",
    contract: "Consumes the mapping on every path. The result owned, or NULL with an exception set. Callbacks: arbitrary Python (the mapping, a lazy import, a finalizer).");

arm NamespaceReadFrom.Mapping shared
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let d:O = acquire(mapping);
    call load_from_mapping(thread, frame, d, name) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at NamespaceReadFrom.Done;
    exit next();
  Failed(e:Err):
    exit raise(NamespaceReadFrom.Failed, e);
}

// NamespaceWrite: the value into the namespace, which takes its own owner.
// Name is the locals (a mapping); Global is the globals dict.
family NamespaceWrite(name:Name, value:Src)
  exits(next, raise) ops(STORE_NAME, STORE_GLOBAL);

point NamespaceWrite.Failed(current, site, pending) keep() spent(value) defs() held();
point NamespaceWrite.Done(current, next_head, clear) keep() spent(value) defs() held();

extern helper store_name(t:Thread, fr:Frame, n:Name, v:O)
  cases(ok(), err(e:Err))
  effects(allocates, raises, releases, runs_python)
  c _PyRop_StoreName as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_StoreName: _PyEval_StoreName into the frame's locals, then the value closed.",
    contract: "Consumes the value on every path. 0, or -1 with the exception set (SystemError for no locals). Callbacks: a mapping's __setitem__, a finalizer.");

extern helper store_global(t:Thread, fr:Frame, n:Name, v:O)
  cases(ok(), err(e:Err))
  effects(allocates, raises, releases, runs_python)
  c _PyRop_StoreGlobal as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_StoreGlobal: PyDict_SetValue into the globals, then the value closed.",
    contract: "Consumes the value on every path. 0, or -1 with the exception set. Callbacks: a dict key's __eq__, a finalizer.");

arm NamespaceWrite.Name shared select(name_scope)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let v:O = acquire(value);
    call store_name(thread, frame, name, v) {
      ok -> Done();
      err -> Failed();
    }
  Done():
    publish [] retire [] at NamespaceWrite.Done;
    exit next();
  Failed(e:Err):
    exit raise(NamespaceWrite.Failed, e);
}

arm NamespaceWrite.Global shared select(global_scope)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let v:O = acquire(value);
    call store_global(thread, frame, name, v) {
      ok -> Done();
      err -> Failed();
    }
  Done():
    publish [] retire [] at NamespaceWrite.Done;
    exit next();
  Failed(e:Err):
    exit raise(NamespaceWrite.Failed, e);
}

// NamespaceDelete: `del name`, which the compiler writes as a NULL store.
// A missing name raises NameError.
family NamespaceDelete(name:Name)
  exits(next, raise) ops(STORE_NAME, STORE_GLOBAL);

point NamespaceDelete.Failed(current, site, pending) keep() spent() defs() held();
point NamespaceDelete.Done(current, next_head, clear) keep() spent() defs() held();

extern helper delete_name(t:Thread, fr:Frame, n:Name)
  cases(ok(), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_DeleteName as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_DeleteName: _PyEval_StoreName with no value: del of the name in the frame's locals.",
    contract: "0, or -1 with the exception set (NameError for a missing name, SystemError for no locals). Callbacks: a mapping's __delitem__.");

extern helper delete_global(t:Thread, fr:Frame, n:Name)
  cases(ok(), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_DeleteGlobal as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_DeleteGlobal: PyDict_PopValue from the globals, NameError when missing.",
    contract: "0, or -1 with the exception set. Callbacks: a dict key's __eq__, a finalizer.");

arm NamespaceDelete.Name shared select(name_scope)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    call delete_name(thread, frame, name) {
      ok -> Done();
      err -> Failed();
    }
  Done():
    exit next();
  Failed(e:Err):
    exit raise(NamespaceDelete.Failed, e);
}

arm NamespaceDelete.Global shared select(global_scope)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    call delete_global(thread, frame, name) {
      ok -> Done();
      err -> Failed();
    }
  Done():
    exit next();
  Failed(e:Err):
    exit raise(NamespaceDelete.Failed, e);
}

// SetupAnnotations: __annotations__ in the namespace, created when missing
family SetupAnnotations()
  exits(next, raise) ops(SETUP_ANNOTATIONS);

point SetupAnnotations.Failed(current, site, pending) keep() spent() defs() held();
point SetupAnnotations.Done(current, next_head, clear) keep() spent() defs() held();

extern helper setup_annotations(t:Thread, fr:Frame)
  cases(ok(), err(e:Err))
  effects(allocates, raises, runs_python)
  c _PyRop_SetupAnnotations as int_zero_ok
  evidence(
    review: "ceval.c _PyRop_SetupAnnotations: the body of the old SETUP_ANNOTATIONS.",
    contract: "0, or -1 with the exception set (SystemError for no locals). Callbacks: the namespace's __getitem__ and __setitem__.");

arm SetupAnnotations.Setup shared
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    call setup_annotations(thread, frame) {
      ok -> Done();
      err -> Failed();
    }
  Done():
    exit next();
  Failed(e:Err):
    exit raise(SetupAnnotations.Failed, e);
}

// Import: `import m` (IMPORT_NAME).  level and fromlist are consumed.  The
// compiler fixes how the import may be lazy: Eager is forced eager (inside
// a handler or a function); Policy is lazy when the interpreter's policy
// or __lazy_modules__ says so; Lazy is `lazy import`.
family Import(dst:Dst, level:Src, fromlist:Src, name:Name)
  exits(next, raise) ops(IMPORT_NAME);

point Import.Failed(current, site, pending) keep() spent(level, fromlist) defs() held();
point Import.Done(current, next_head, clear) keep() spent(level, fromlist) defs(dst) held();

enum ImportKind(IMPORT_EAGER, IMPORT_POLICY, IMPORT_LAZY);

extern helper import_name(t:Thread, fr:Frame, n:Name, level:O, fromlist:O, kind:Enum<ImportKind>)
  cases(ok(z:O), err(e:Err))
  effects(allocates, raises, releases, runs_python)
  c _PyRop_ImportName as value_or_null
  evidence(
    review: "ceval.c _PyRop_ImportName: IMPORT_NAME: the level as a C int, then _PyEval_ImportName (IMPORT_EAGER) or _PyEval_LazyImportName with the explicit flag (LAZY).",
    contract: "Consumes level and fromlist on every path. The result owned, or NULL with an exception set. Callbacks: arbitrary Python (the import system).");

arm Import.Eager shared select(eager_import)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let l:O = acquire(level);
    let f:O = acquire(fromlist);
    call import_name(thread, frame, name, l, f, IMPORT_EAGER) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at Import.Done;
    exit next();
  Failed(e:Err):
    exit raise(Import.Failed, e);
}

arm Import.Policy shared select(policy_import)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let l:O = acquire(level);
    let f:O = acquire(fromlist);
    call import_name(thread, frame, name, l, f, IMPORT_POLICY) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at Import.Done;
    exit next();
  Failed(e:Err):
    exit raise(Import.Failed, e);
}

arm Import.Lazy shared select(lazy_import)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let l:O = acquire(level);
    let f:O = acquire(fromlist);
    call import_name(thread, frame, name, l, f, IMPORT_LAZY) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at Import.Done;
    exit next();
  Failed(e:Err):
    exit raise(Import.Failed, e);
}

// ImportFrom: `from m import name` (IMPORT_FROM).  From leaves the module
// in its home for the next read; FromLast is the last read, which spends it
// (no retirement follows).
family ImportFrom(dst:Dst, module:Src, name:Name)
  exits(next, raise) ops(IMPORT_FROM);

point ImportFrom.Failed(current, site, pending) keep(module) spent() defs() held();
point ImportFrom.Done(current, next_head, clear) keep(module) spent() defs(dst) held();
point ImportFrom.LastFailed(current, site, pending) keep() spent(module) defs() held();
point ImportFrom.LastDone(current, next_head, clear) keep() spent(module) defs(dst) held();

extern helper import_from(t:Thread, fr:Frame, m:O, n:Name)
  cases(ok(z:O), err(e:Err))
  effects(allocates, raises, releases, runs_python)
  c _PyRop_ImportFrom as value_or_null
  evidence(
    review: "ceval.c _PyRop_ImportFrom: IMPORT_FROM: _PyEval_LazyImportFrom for a lazy import object, else _PyEval_ImportFromValue.",
    contract: "Consumes the module on every path. The result owned, or NULL with an exception set. Callbacks: arbitrary Python (attribute lookup, the import system).");

arm ImportFrom.From shared select(module_kept)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let m:O = dup(use(module));
    call import_from(thread, frame, m, name) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at ImportFrom.Done;
    exit next();
  Failed(e:Err):
    exit raise(ImportFrom.Failed, e);
}

arm ImportFrom.FromLast shared select(module_spent)
  effects(runs_python, raises)
  feedback()
  exits(next, raise)
{
  entry():
    let m:O = acquire(module);
    call import_from(thread, frame, m, name) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at ImportFrom.LastDone;
    exit next();
  Failed(e:Err):
    exit raise(ImportFrom.LastFailed, e);
}
