// Binary and Unary: the numeric operations other than ordinary addition (Add,
// add.rop) and subscript (GetItem, items.rop), and the unary protocols.

enum UnaryOp(NEGATIVE, POSITIVE, INVERT);

family Binary(dst:Dst, x:Src, y:Src, op:Enum<Numeric>, fb:Fb<Binary>)
  exits(next, raise, redirect, miss, again) generic(Generic);

family Unary(dst:Dst, value:Src, op:Enum<UnaryOp>)
  exits(next, raise);

point Binary.BoxFailed(current, site, pending) keep(x, y) spent() defs();
point Binary.OpFailed(current, site, pending) keep() spent(y, x) defs();
point Binary.Done(current, next_head, clear) keep() spent(y, x) defs(dst);
point Unary.Failed(current, site, pending) keep() spent(value) defs();
point Unary.Done(current, next_head, clear) keep() spent(value) defs(dst);

// Int rows: two inline ints and an operator the pair admits (a zero divisor
// or a negative shift count goes to the generic arm, which raises)

extern primitive int_binary_applies(op:Enum<Numeric>, a:B, b:B) -> Bool
  effects()
  test(inline_int(a), inline_int(b))
  c _PyRop_IntBinaryApplies as bool
  evidence(
    review: "Reviewed BN. pycore_rop_rows.h: both words inline ints, and the operator"
            "defined for this pair.",
    contract: "Reads the two words and the operator: no memory, no failure, no"
              "callback.",
    lowering: "none: the arms that use it are shared and are not compiled inline",
    test: "test_rop_binary");

// The operator admits the decoded divisor or shift count (scaled)
extern primitive int_op_admits(op:Enum<Numeric>, b:Scaled51) -> Bool
  effects()
  c _PyRop_IntOpAdmits as bool
  evidence(
    review: "TB. pycore_rop_rows.h: the operator half of _PyRop_IntBinaryApplies."
            "A scaled value is zero or negative exactly when its int is.",
    contract: "Reads the operator and the value: no memory, no failure.",
    lowering: "none: the arms that use it are shared and are not compiled inline",
    test: "test_rop_binary");

extern helper int_binary(op:Enum<Numeric>, a:Scaled51, b:Scaled51)
  cases(ok(z:O), err(e:Err))
  effects(allocates, raises)
  ensures(ok.exact<int>(z))
  c _PyRop_IntBinary as value_or_null
  evidence(
    review: "Reviewed BN. pycore_rop_rows.h: the old _BINARY_OP_*_INT uops, on"
            "scaled values where the sum, difference or product can overflow.",
    contract: "The operator admits the pair (asserted). NULL with MemoryError only"
              "if the box of a result outside int51 fails. No finalizer, no Python.");

// Float rows: two inline floats, or an inline float and an inline int

extern primitive float_binary_applies(op:Enum<Numeric>, a:B, b:B) -> Bool
  effects()
  test(inline_number(a), inline_number(b))
  c _PyRop_FloatBinaryApplies as bool
  evidence(
    review: "Reviewed BN; AR adds power. pycore_rop_rows.h: the float operand pair,"
            "and an operator the pair's result admits (float_op_admits).",
    contract: "Reads the two words and the operator: no memory, no failure, no"
              "callback.",
    lowering: "none: the arm that uses it is shared and is not compiled inline",
    test: "test_rop_binary");

// The operator's double result of two decoded operands: C's +, -, *, / or
// pow.  The operator admits it or not (float_op_admits).
extern primitive float_value(op:Enum<Numeric>, a:F64, b:F64) -> F64
  effects()
  c _PyRop_FloatValue as scalar
  evidence(
    review: "AR. pycore_rop_rows.h: the operations of floatobject.c's float_add,"
            "float_sub, float_mul, float_div and float_pow, before their checks.",
    contract: "Arithmetic on doubles: no memory, no failure.  pow may set errno,"
              "which no reader trusts without clearing it first.",
    lowering: "none: the arm that uses it is shared and is not compiled inline",
    test: "test_rop_binary");

// Whether the float operation's result is the language's: always for add,
// subtract and multiply; for true divide when the divisor is nonzero; for
// power when the base is positive and finite, the exponent finite and the
// result zero or a normal float, where float_pow returns pow(a, b) with no
// error and no special case.  Anything else is the generic arm's, which
// raises or makes a complex.
extern primitive float_op_admits(op:Enum<Numeric>, a:F64, b:F64, z:F64) -> Bool
  effects()
  c _PyRop_FloatOpAdmits as bool
  evidence(
    review: "TB; AR adds power. pycore_rop_rows.h: floatobject.c float_div's zero"
            "test and float_pow's cases.",
    contract: "Reads the operator and the doubles: no memory, no failure.",
    lowering: "none: the arm that uses it is shared and is not compiled inline",
    test: "test_rop_binary");

// The float of an admitted result, boxed only when it is NaN
extern helper box_float(z:F64)
  cases(ok(v:O), err(e:Err))
  effects(allocates, raises)
  ensures(ok.exact<float>(v))
  c PyValue_FromDouble as value_or_null inline
  evidence(
    review: "AR. pycore_value.h PyValue_FromDouble, which allocates only for NaN.",
    contract: "NULL with MemoryError only if the NaN box fails. No finalizer, no"
              "Python.");

// Text rows: the in-place add of two exact strings

extern primitive text_binary_applies(op:Enum<Numeric>, a:B, b:B) -> Bool
  effects()
  test(exact<str>(a), exact<str>(b))
  c _PyRop_TextBinaryApplies as bool
  evidence(
    review: "Reviewed BN. pycore_rop_rows.h: the in-place add, and both words"
            "objects of exact type str.",
    contract: "Reads the type words and the operator: no memory, no failure, no"
              "callback.",
    lowering: "none: the arm that uses it is shared and is not compiled inline",
    test: "test_rop_binary");

// Records the operand types of the sampled pair as type versions, and clears
// the rest of the entry.  Evidence only: every arm guards what it relies on.
extern helper record_operands(f:Fb<Binary>, a:B, b:B) -> Unit
  effects(reads, writes)
  feedback(read(entry), write(entry))
  c _PyRop_RecordOperands as unit
  evidence(
    review: "Reviewed BN. specialize.c: the old fb_begin_binary of each binary"
            "specialization.",
    contract: "Stores the two operand type versions and zeroes the entry's other"
              "fields; a shared entry is left alone. No memory, no Python, no failure.");

// Adaptation: the old specializer's order (ints, floats, text, a registered
// extension), by the sampled operands.
macro adapt_before_use_binary(f:Fb<Binary>, x:Src, y:Src, op:Enum<Numeric>)
  cases(run(), changed(t:Ticket<Binary>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    let _:Unit = record_operands(f, use(x), use(y));
    branch int_binary_applies(op, use(x), use(y)) -> Chosen(), Other();
  Chosen():
    let c:Candidate<Binary> = candidate(Binary.Int);
    call install(site, f, c) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    branch float_binary_applies(op, use(x), use(y)) -> ChosenFloat(), TryText();
  ChosenFloat():
    let cf:Candidate<Binary> = candidate(Binary.Float);
    call install(site, f, cf) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryText():
    branch text_binary_applies(op, use(x), use(y)) -> ChosenText(), TryExtended();
  ChosenText():
    let ct:Candidate<Binary> = candidate(Binary.Text);
    call install(site, f, ct) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryExtended():
    call find_extension(f, op, use(x), use(y)) {
      hit -> ChosenExtended();
      absent -> NoArm();
    }
  ChosenExtended():
    let ce:Candidate<Binary> = candidate(Binary.Extended);
    call install(site, f, ce) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoArm():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Binary>):
    exit changed(t);
  Run():
    exit run();
}

// One arm per operator of the hot set (`over(op: ...)`), the operator its
// constant; the in-place floor divide, remainder, bitwise and shift forms are
// rare, and share the rest arm, which reads the operator from the word
arm Binary.Int shared over(op: NB_INPLACE_ADD, NB_SUBTRACT, NB_INPLACE_SUBTRACT,
                           NB_MULTIPLY, NB_INPLACE_MULTIPLY, NB_FLOOR_DIVIDE,
                           NB_REMAINDER, NB_AND, NB_OR, NB_XOR, NB_LSHIFT, NB_RSHIFT;
                           rest)
  effects(writes, allocates, raises, releases on (dst))
  feedback()
  exits(next, miss, raise)
  ensures(next.exact<int>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_inline_int(l, r) else miss;
    let a:Scaled51 = int_scaled(l);
    let b:Scaled51 = int_scaled(r);
    guard int_op_admits(op, b) else miss;
    call int_binary(op, a, b) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Binary.BoxFailed, e);
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Binary.Done;
    exit next();
}

// One arm per operator the pair admits (`over(op: ...)`): the operator is
// the arm's constant
arm Binary.Float shared over(op: NB_INPLACE_ADD, NB_SUBTRACT, NB_INPLACE_SUBTRACT,
                             NB_MULTIPLY, NB_INPLACE_MULTIPLY, NB_TRUE_DIVIDE,
                             NB_INPLACE_TRUE_DIVIDE, NB_POWER, NB_INPLACE_POWER)
  effects(writes, allocates, raises, releases on (dst))
  feedback()
  exits(next, miss, raise)
  ensures(next.exact<float>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard float_operands(l, r) else miss;
    let a:F64 = number_as_double(l);
    let b:F64 = number_as_double(r);
    let v:F64 = float_value(op, a, b);
    guard float_op_admits(op, a, b, v) else miss;
    call box_float(v) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Binary.BoxFailed, e);
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Binary.Done;
    exit next();
}

arm Binary.Text shared
  effects(writes, allocates, raises, releases on (dst))
  feedback()
  exits(next, miss, raise)
  ensures(next.exact<str>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard text_binary_applies(op, l, r) else miss;
    call concat_text(l, r) {
      ok -> Finish();
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(Binary.BoxFailed, e);
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Binary.Done;
    exit next();
}

// The operand types of the entry's registered descriptor
arm Binary.Extended shared
  effects(runs_python, writes, allocates, raises, releases on (dst))
  feedback(read(entry.descr))
  exits(next, miss, raise, redirect)
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard extension_applies(fb, l, r) else miss;
    let a:Anchors = anchor_for_call([x, y]);
    call extension_at_origin(fb, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(y), spent(x), old(dst)] at Binary.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(Binary.OpFailed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

arm Binary.Generic shared
  effects(runs_python, raises, releases on (dst))
  feedback(read(entry), write(entry), write(handler))
  exits(next, again, raise, redirect)
{
  entry():
    call adapt_before_use_binary(fb, x, y, op) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Binary>):
    exit again(t);
  Run():
    let a:Anchors = anchor_for_call([x, y]);
    call binary_at_origin(op, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(y), spent(x), old(dst)] at Binary.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(Binary.OpFailed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

// Negation, inversion and unary plus: the operand is consumed.  Inline ints
// and floats negate without a call.
extern helper unary_op(op:Enum<UnaryOp>, x:O)
  cases(ok(z:O), err(e:Err))
  effects(allocates, runs_python, raises, releases)
  c _PyRop_UnaryOp as value_or_null
  evidence(
    review: "Reviewed BN. ceval.c: the old _UNARY_NEGATIVE and _UNARY_INVERT, and"
            "_PyValue_Positive for the intrinsic.",
    contract: "Closes x on both outcomes; the result is a new owner or NULL with an"
              "exception set. Runs Python for objects (__neg__, __pos__, __invert__).");

arm Unary.Generic shared
  effects(allocates, runs_python, raises, releases on (dst))
  feedback()
  exits(next, raise)
{
  entry():
    let xo:O = acquire(value);
    call unary_op(op, xo) {
      ok -> Done();
      err -> Failed();
    }
  Done(z:O):
    publish [dst = z] retire [old(dst)] at Unary.Done;
    exit next();
  Failed(e:Err):
    exit raise(Unary.Failed, e);
}

// In-place concatenation into a local: `s += t` and `s = s + t`, where the
// translator folded the store into the add and the left operand is that
// local.  The word has Binary's operands and starts on this family's Generic
// arm, which adapts as Binary's does but installs the append for two strings.
// The append reuses the string's buffer when the local holds its only
// reference, so a loop of appends stays linear.
family AppendText(dst:Dst, x:Src, y:Src, op:Enum<Numeric>, fb:Fb<Binary>)
  exits(next, raise, redirect, miss, again) generic(Generic);

point AppendText.OpFailed(current, site, pending) keep() spent(y, x) defs();
point AppendText.Failed(current, site, pending) keep() spent(y, x) defs();
point AppendText.Done(current, next_head, clear) keep() spent(y, x) defs(dst);

// Takes the string out of x's home, which is dst's, leaving it vacant, and
// appends r to it.  The result is the grown string, which is the same object
// when nothing else holds it.  On failure the home stays vacant, as the old
// handler left it.
extern helper append_text(x:Src, r:B)
  cases(ok(z:O), err(e:Err))
  effects(reads, writes, allocates, raises, runs_python)
  spends(x)
  ensures(ok.exact<str>(z))
  c _PyRop_AppendText as value_or_null
  evidence(
    review: "Reviewed BN. ceval.c: the old _BINARY_OP_INPLACE_ADD_UNICODE, whose"
            "left operand is the local it stores to.",
    contract: "x is the home of a local that holds an exact str and r is an exact str,"
              "borrowed (asserted). The owner leaves the home, which is vacant on"
              "return; the result is a new owner or NULL with an exception set (the"
              "string is released).");

arm AppendText.Text shared
  effects(reads, writes, allocates, raises, runs_python, releases on (dst))
  feedback()
  exits(next, miss, raise)
  ensures(next.exact<str>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_exact_str(l, r) else miss;
    let a:Anchors = anchor_for_call([y]);
    call append_text(x, arg(a, 0)) {
      ok -> Result();
      err -> Failed();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(y), old(dst)] at AppendText.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y], e);
    exit raise(AppendText.Failed, saved);
}

// The sum, stored in the local: as Binary.Generic
arm AppendText.Generic shared
  effects(runs_python, raises, releases on (dst))
  feedback(read(entry), write(entry), write(handler))
  exits(next, again, raise, redirect)
{
  entry():
    call adapt_before_use_append(fb, x, y, op) {
      run -> Run();
      changed -> Retry();
    }
  Retry(t:Ticket<Binary>):
    exit again(t);
  Run():
    let a:Anchors = anchor_for_call([x, y]);
    call binary_at_origin(op, a) {
      ok -> Result();
      err -> Failed();
      redirected -> Gone();
    }
  Result(z:O):
    publish [dst = z] retire [roots(a), spent(y), spent(x), old(dst)] at AppendText.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(AppendText.OpFailed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

// Binary's adaptation, with the in-place append for the text case: the
// word's destination is the local its left operand reads.
macro adapt_before_use_append(f:Fb<Binary>, x:Src, y:Src, op:Enum<Numeric>)
  cases(run(), changed(t:Ticket<Binary>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    let _:Unit = record_operands(f, use(x), use(y));
    branch int_binary_applies(op, use(x), use(y)) -> Chosen(), Other();
  Chosen():
    let c:Candidate<Binary> = candidate(Binary.Int);
    call install(site, f, c) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Other():
    branch float_binary_applies(op, use(x), use(y)) -> ChosenFloat(), TryText();
  ChosenFloat():
    let cf:Candidate<Binary> = candidate(Binary.Float);
    call install(site, f, cf) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryText():
    branch text_binary_applies(op, use(x), use(y)) -> ChosenText(), TryExtended();
  ChosenText():
    let ct:Candidate<Binary> = candidate(AppendText.Text);
    call install(site, f, ct) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryExtended():
    call find_extension(f, op, use(x), use(y)) {
      hit -> ChosenExtended();
      absent -> NoArm();
    }
  ChosenExtended():
    let ce:Candidate<Binary> = candidate(Binary.Extended);
    call install(site, f, ce) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoArm():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Binary>):
    exit changed(t);
  Run():
    exit run();
}
