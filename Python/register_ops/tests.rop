arm TestBranch.Generic shared
  effects(reads, runs_python, writes, releases, raises)
  feedback(read(entry), write(entry), write(handler))
  exits(next, branch, again, raise, redirect)
{
  entry():
    branch test_is_identity(test) -> Identical(), Adapt();
  Identical():
    goto IdentityTest(same_value(use(x), use(y)));
  IdentityTest(same:Bool):
    branch same_bool(sense, same) -> IdentityTaken(), IdentityFall();
  IdentityTaken():
    publish [] retire [spent(y), spent(x)] at TestBranch.Jumped;
    exit branch(target);
  IdentityFall():
    publish [] retire [spent(y), spent(x)] at TestBranch.Fell;
    exit next();
  Adapt():
    call adapt_before_use_test(fb, x, y, test) {
      run -> Run();
      changed -> Retry();
    }
  Retry(tk:Ticket<Compare>):
    exit again(tk);
  Run():
    let a:Anchors = anchor_for_call([x, y]);
    branch test_is_contains(test) -> RunContains(), RunCompare();
  RunCompare():
    let rel:Enum<Relation> = relation_of(test);
    call compare_test_at_origin(rel, a) {
      yes -> Yes();
      no -> No();
      err -> Failed();
      redirected -> Gone();
    }
  RunContains():
    call contains_test_at_origin(a) {
      yes -> Yes();
      no -> No();
      err -> Failed();
      redirected -> Gone();
    }
  Yes():
    goto Test(true);
  No():
    goto Test(false);
  Test(hit:Bool):
    branch same_bool(sense, hit) -> Taken(), Fall();
  Taken():
    publish [] retire [roots(a), spent(y), spent(x)] at TestBranch.Jumped;
    exit branch(target);
  Fall():
    publish [] retire [roots(a), spent(y), spent(x)] at TestBranch.Fell;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(TestBranch.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

// The observed wrapper: the generic test of any kind, the retirement of the
// operands, then the branch event on the edge taken.  The event is the jump's:
// the word's range covers it, and instrumentation reports its offset.
arm TestBranch.Observed split observes
  effects(reads, runs_python, writes, releases, raises)
  feedback()
  exits(next, branch, raise, redirect)
{
  entry():
    branch test_is_identity(test) -> Identical(), Anchor();
  Identical():
    goto IdentityTest(same_value(use(x), use(y)));
  IdentityTest(same:Bool):
    branch same_bool(sense, same) -> IdentityTaken(), IdentityFall();
  IdentityTaken():
    publish [] retire [spent(y), spent(x)] at TestBranch.Jumped;
    call branch_event(thread, frame, site, true) {
      ok -> IdentityJump();
      moved -> IdentityMoved();
      err -> IdentityEventFailed();
    }
  IdentityJump():
    exit branch(target);
  IdentityFall():
    publish [] retire [spent(y), spent(x)] at TestBranch.Fell;
    call branch_event(thread, frame, site, false) {
      ok -> IdentityNext();
      moved -> IdentityMoved();
      err -> IdentityEventFailed();
    }
  IdentityNext():
    exit next();
  IdentityMoved(ir:Route):
    exit redirect(ir);
  IdentityEventFailed(ie:Err):
    exit raise(TestBranch.Event, ie);
  Anchor():
    let a:Anchors = anchor_for_call([x, y]);
    branch test_is_contains(test) -> RunContains(), RunCompare();
  RunCompare():
    let rel:Enum<Relation> = relation_of(test);
    call compare_test_at_origin(rel, a) {
      yes -> Yes();
      no -> No();
      err -> Failed();
      redirected -> Gone();
    }
  RunContains():
    call contains_test_at_origin(a) {
      yes -> Yes();
      no -> No();
      err -> Failed();
      redirected -> Gone();
    }
  Yes():
    goto Test(true);
  No():
    goto Test(false);
  Test(hit:Bool):
    branch same_bool(sense, hit) -> Taken(), Fall();
  Taken():
    publish [] retire [roots(a), spent(y), spent(x)] at TestBranch.Jumped;
    call branch_event(thread, frame, site, true) {
      ok -> Jump();
      moved -> Moved();
      err -> EventFailed();
    }
  Jump():
    exit branch(target);
  Fall():
    publish [] retire [roots(a), spent(y), spent(x)] at TestBranch.Fell;
    call branch_event(thread, frame, site, false) {
      ok -> Next();
      moved -> Moved();
      err -> EventFailed();
    }
  Next():
    exit next();
  Moved(r:Route):
    exit redirect(r);
  EventFailed(ee:Err):
    exit raise(TestBranch.Event, ee);
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(TestBranch.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}
