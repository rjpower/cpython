// Adaptation (addendum section 2)

// The kind of a container, from its type alone
extern helper classify_contains(c:B)
  cases(set(), dict(), sequence(), none())
  effects(reads)
  c _PyRop_ClassifyContains as case_index
  evidence(
    review: "Reviewed CP. specialize.c _Py_Specialize_ContainsOp: an exact dict, set or"
            "frozenset, or an exact str, tuple or list.",
    contract: "Reads the container's type. No memory, no Python, no failure.");

macro adapt_before_use_compare(f:Fb<Compare>, x:Src, y:Src, relation:Enum<Relation>)
  cases(run(), changed(t:Ticket<Compare>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    branch both_inline_int(use(x), use(y)) -> ChosenInt(), TryFloat();
  ChosenInt():
    let ci:Candidate<Compare> = candidate(Compare.Int);
    call install(site, f, ci) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryFloat():
    branch both_inline_float(use(x), use(y)) -> ChosenFloat(), TryStr();
  ChosenFloat():
    let cf:Candidate<Compare> = candidate(Compare.Float);
    call install(site, f, cf) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryStr():
    branch both_exact_str(use(x), use(y)) -> TryEquality(), NoArm();
  TryEquality():
    branch equality_relation(relation) -> ChosenStr(), NoArm();
  ChosenStr():
    let cs:Candidate<Compare> = candidate(Compare.Str);
    call install(site, f, cs) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoArm():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Compare>):
    exit changed(t);
  Run():
    exit run();
}

macro adapt_before_use_contains(f:Fb<Contains>, item:Src, container:Src)
  cases(run(), changed(t:Ticket<Contains>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    call classify_contains(use(container)) {
      set -> ChosenSet();
      dict -> ChosenDict();
      sequence -> NoArm();
      none -> NoArm();
    }
  ChosenSet():
    let cs:Candidate<Contains> = candidate(Contains.Set);
    call install(site, f, cs) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  ChosenDict():
    let cd:Candidate<Contains> = candidate(Contains.Dict);
    call install(site, f, cd) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoArm():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Contains>):
    exit changed(t);
  Run():
    exit run();
}

// A fused test chooses among the arms of either kind of test
macro adapt_before_use_test(f:Fb<Compare>, x:Src, y:Src, test:Enum<BranchTest>)
  cases(run(), changed(t:Ticket<Compare>))
  effects(reads, writes, allocates)
  feedback(read(entry), write(entry), write(handler))
{
  entry():
    call tick(f) {
      quiet -> Run();
      due -> Sample();
    }
  Sample():
    branch test_is_contains(test) -> Contained(), Compared();
  Contained():
    call classify_contains(use(y)) {
      set -> ChosenSet();
      dict -> ChosenDict();
      sequence -> ChosenSequence();
      none -> NoArm();
    }
  ChosenSet():
    let cs:Candidate<Compare> = candidate(TestBranch.Set);
    call install(site, f, cs) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  ChosenDict():
    let cd:Candidate<Compare> = candidate(TestBranch.Dict);
    call install(site, f, cd) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  ChosenSequence():
    let cq:Candidate<Compare> = candidate(TestBranch.Sequence);
    call install(site, f, cq) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  Compared():
    branch both_inline_int(use(x), use(y)) -> ChosenInt(), TryFloat();
  ChosenInt():
    let ci:Candidate<Compare> = candidate(TestBranch.Int);
    call install(site, f, ci) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryFloat():
    branch both_inline_float(use(x), use(y)) -> ChosenFloat(), TryStr();
  ChosenFloat():
    let cf:Candidate<Compare> = candidate(TestBranch.Float);
    call install(site, f, cf) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  TryStr():
    branch both_exact_str(use(x), use(y)) -> TryEquality(), NoArm();
  TryEquality():
    branch equality_relation(relation_of(test)) -> ChosenStr(), NoArm();
  ChosenStr():
    let cs2:Candidate<Compare> = candidate(TestBranch.Str);
    call install(site, f, cs2) {
      changed -> Changed();
      same -> Run();
      blocked -> Run();
    }
  NoArm():
    let _:Unit = backoff(f);
    exit run();
  Changed(t:Ticket<Compare>):
    exit changed(t);
  Run():
    exit run();
}

// Compare: an arm per relation (`over(relation: ...)`), the relation its
// constant

arm Compare.Int shared over(relation: LT, LE, EQ, NE, GT, GE)
  effects(writes, releases on (dst))
  feedback()
  exits(next, miss)
  ensures(next.exact<bool>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_inline_int(l, r) else miss;
    goto Finish(truth_object(compare_scaled(relation, int_scaled(l), int_scaled(r)), false));
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Compare.Done;
    exit next();
}

arm Compare.Float shared over(relation: LT, LE, EQ, NE, GT, GE)
  effects(writes, releases on (dst))
  feedback()
  exits(next, miss)
  ensures(next.exact<bool>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_inline_float(l, r) else miss;
    goto Finish(truth_object(compare_floats(relation, l, r), false));
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Compare.Done;
    exit next();
}

// Only the equality relations: the order of strings is the generic arm's
arm Compare.Str shared over(relation: EQ, NE)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next, miss)
  ensures(next.exact<bool>(dst))
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_exact_str(l, r) else miss;
    goto Finish(truth_object(equal_strings(relation, l, r), false));
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Compare.Done;
    exit next();
}

arm Compare.Generic shared
  effects(reads, runs_python, writes, releases on (dst), raises)
  feedback(read(entry), write(entry), write(handler))
  exits(next, again, raise, redirect)
{
  entry():
    call adapt_before_use_compare(fb, x, y, relation) {
      run -> Run();
      changed -> Retry();
    }
  Retry(tk:Ticket<Compare>):
    exit again(tk);
  Run():
    let a:Anchors = anchor_for_call([x, y]);
    call compare_at_origin(relation, result, a) {
      ok -> Finish();
      err -> Failed();
      redirected -> Gone();
    }
  Finish(z:O):
    publish [dst = z] retire [roots(a), spent(y), spent(x), old(dst)] at Compare.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [y, x], e);
    exit raise(Compare.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

// Identity

arm Identity.Test inline
  effects(reads, writes, releases on (dst), runs_python)
  feedback()
  exits(next)
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    goto Finish(truth_object(same_value(l, r), sense));
  Finish(z:O):
    publish [dst = z] retire [spent(y), spent(x), old(dst)] at Identity.Done;
    exit next();
}

// Contains

arm Contains.Set shared
  effects(reads, runs_python, writes, releases on (dst), raises)
  feedback()
  exits(next, miss, raise, redirect)
{
  entry():
    guard exact_any_set(use(container)) else miss;
    let a:Anchors = anchor_for_call([item, container]);
    call set_test_at_origin(a) {
      yes -> Yes();
      no -> No();
      err -> Failed();
      redirected -> Gone();
    }
  Yes():
    goto Finish(truth_object(true, sense));
  No():
    goto Finish(truth_object(false, sense));
  Finish(z:O):
    publish [dst = z] retire [roots(a), spent(container), spent(item), old(dst)] at Contains.Done;
    exit next();
  Failed(e:Err):
    let saved:Err = retire_failed_call(a, [container, item], e);
    exit raise(Contains.Failed, saved);
  Gone(route:Route):
    let current_route:Route = retire_abandoned(a, route);
    exit redirect(current_route);
}

