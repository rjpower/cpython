// TestBranch: the same tests, then the edge

arm TestBranch.Identity inline over(locals: TT; rest)
  effects(reads, writes, releases, runs_python)
  feedback()
  exits(next, branch)
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    goto Test(same_value(l, r));
  Test(hit:Bool):
    branch same_bool(sense, hit) -> Taken(), Fall();
  Taken():
    publish [] retire [spent(y), spent(x)] at TestBranch.Jumped;
    exit branch(target);
  Fall():
    publish [] retire [spent(y), spent(x)] at TestBranch.Fell;
    exit next();
}

// The compare tests: an arm per test (`over(test: ...)`), the test its
// constant; the sense stays the word's
arm TestBranch.Int shared over(test: TEST_LT, TEST_LE, TEST_EQ, TEST_NE, TEST_GT, TEST_GE)
  effects(reads, writes, releases)
  feedback()
  exits(next, branch, miss)
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_inline_int(l, r) else miss;
    goto Test(compare_scaled(relation_of(test), int_scaled(l), int_scaled(r)));
  Test(hit:Bool):
    branch same_bool(sense, hit) -> Taken(), Fall();
  Taken():
    publish [] retire [spent(y), spent(x)] at TestBranch.Jumped;
    exit branch(target);
  Fall():
    publish [] retire [spent(y), spent(x)] at TestBranch.Fell;
    exit next();
}

arm TestBranch.Float shared over(test: TEST_LT, TEST_LE, TEST_EQ, TEST_NE, TEST_GT,
                                  TEST_GE)
  effects(reads, writes, releases)
  feedback()
  exits(next, branch, miss)
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_inline_float(l, r) else miss;
    goto Test(compare_floats(relation_of(test), l, r));
  Test(hit:Bool):
    branch same_bool(sense, hit) -> Taken(), Fall();
  Taken():
    publish [] retire [spent(y), spent(x)] at TestBranch.Jumped;
    exit branch(target);
  Fall():
    publish [] retire [spent(y), spent(x)] at TestBranch.Fell;
    exit next();
}

// Only the equality tests: the order of strings is the generic arm's
arm TestBranch.Str shared over(test: TEST_EQ, TEST_NE)
  effects(reads, writes, releases)
  feedback()
  exits(next, branch, miss)
{
  entry():
    let l:B = use(x);
    let r:B = use(y);
    guard both_exact_str(l, r) else miss;
    goto Test(equal_strings(relation_of(test), l, r));
  Test(hit:Bool):
    branch same_bool(sense, hit) -> Taken(), Fall();
  Taken():
    publish [] retire [spent(y), spent(x)] at TestBranch.Jumped;
    exit branch(target);
  Fall():
    publish [] retire [spent(y), spent(x)] at TestBranch.Fell;
    exit next();
}

