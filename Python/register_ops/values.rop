// Family interfaces of Appendix A, "Values, control, arithmetic, and
// lookup" (Add is in add.rop, GetAttr in getattr.rop).  Arms come with
// their batches.  Every instruction has the implicit `site`; no family
// takes its origin as an operand.

enum ConstKind(POOL, SMALL, COMMON);
enum PollMode(POLL, NO_POLL);
// The four conditional jumps of the old bytecode: the sense of the test and
// whether the jump edge keeps the tested owner (JUMP_IF_x_OR_POP)
enum BranchMode(BRANCH_IF_FALSE, BRANCH_IF_TRUE, BRANCH_KEEP_IF_FALSE, BRANCH_KEEP_IF_TRUE);
enum UnaryOp(NEGATIVE, POSITIVE, INVERT);
enum Relation(LT, LE, EQ, NE, GT, GE);
enum CompareResult(RICH, TRUTH);
enum BranchTest(IDENTITY, CONTAINS, TEST_LT, TEST_LE, TEST_EQ, TEST_NE, TEST_GT,
                TEST_GE);
enum WriteMode(SET, DELETE);
enum SuperMode(SUPER_ATTR, SUPER_METHOD);
enum Special(ENTER, EXIT, AENTER, AEXIT);

// P1: constants, local bindings, saved locals, residual moves, origins

// An origin or legal-entry boundary
family Nop()
  exits(next) ops(NOP);

// Pool: the code's constant `index`; Small: the immediate int `index`;
// Common: the interpreter root `index`
family Const(dst:Dst, kind:Enum<ConstKind>, index:U16)
  exits(next) ops(LOAD_CONST, LOAD_SMALL_INT, LOAD_COMMON_CONSTANT);

family LocalRead(dst:Dst, local:Local)
  exits(next, raise) ops(LOAD_FAST, LOAD_FAST_CHECK, LOAD_FAST_BORROW);

family LocalWrite(local:Local, value:Src)
  exits(next) ops(STORE_FAST);

family SaveLocal(dst:Dst, local:Local)
  exits(next) ops(LOAD_FAST_AND_CLEAR);

family LocalDelete(local:Local)
  exits(next, raise) ops(DELETE_FAST);

// A parallel assignment of homes: what translation could not make a
// rename (an edge's residual bindings, staging, a second owner, a
// retirement at its own origin).  The arm is the mode, chosen by the
// lowering through its `select`.  Element i of `srcs` goes to element i of
// `dsts`; `srcs` may be longer, by the sources that Retire closes.
family Move(dsts:Span<Dst>, srcs:Span<Src>)
  exits(next) ops(SWAP, COPY, POP_TOP);

// Every source's owner goes to its destination as if all moved at once: a
// destination is vacant or another pair's source.  The sources that no
// pair writes are left vacant.  A cycle turns through one rooted local.
extern helper parallel_move(d:Span<Dst>, s:Span<Src>) -> Unit
  effects(reads, writes)
  c _PyRop_ParallelMove as unit
  evidence(
    review: "ceval.c _PyFrame_ParallelMove: the unwinder's recipe routine, which"
            "swaps each pair whose home no pending pair reads and turns each"
            "cycle through one C local.",
    contract: "Moves owners between homes of the frame. Destinations are vacant or"
              "sources of the set (the verifier's rule), so nothing is closed: no"
              "Python, no failure.");

// Closes the sources after the first len(d), which a parallel move left
// in place, after every home of the set is written
extern helper close_rest(d:Span<Dst>, s:Span<Src>) -> Unit
  effects(writes, releases, runs_python)
  c _PyRop_CloseRest as unit
  evidence(
    review: "pycore_rop_rows.h: takes each source past the pairs out of its home,"
            "then closes it.",
    contract: "The homes are vacant before any close, so a finalizer finds the frame"
              "as the instruction leaves it. A close may run Python; it cannot fail.");

// Each destination takes a second owner of its source, which keeps its own
extern helper copy_homes(d:Span<Dst>, s:Span<Src>) -> Unit
  effects(reads, writes)
  c _PyRop_CopyHomes as unit
  evidence(
    review: "pycore_rop_rows.h: PyValue_DUP of each source into its vacant destination.",
    contract: "Counts only; destinations are vacant, so nothing is closed: no Python,"
              "no failure.");

arm Move.Transfer shared select(transfer)
  effects(reads, writes)
  feedback()
  exits(next)
{
  entry():
    let _:Unit = parallel_move(dsts, srcs);
    exit next();
}

arm Move.Retire shared select(retire)
  effects(reads, writes, releases, runs_python)
  feedback()
  exits(next)
{
  entry():
    let _:Unit = parallel_move(dsts, srcs);
    let _:Unit = close_rest(dsts, srcs);
    exit next();
}

arm Move.Copy shared select(copy)
  effects(reads, writes)
  feedback()
  exits(next)
{
  entry():
    let _:Unit = copy_homes(dsts, srcs);
    exit next();
}

// P5: truth, jumps, conditional retention, None branches

family Truth(dst:Dst, value:Src, invert:Bool, fb:Fb<Truth>)
  exits(next, raise, miss, again, redirect) ops(TO_BOOL, UNARY_NOT);

// Covers backward jumps, so its target is far.  The arm says whether it
// polls: Direct is JUMP_FORWARD and the jumps that must not poll, Poll is
// JUMP_BACKWARD, Warm is JUMP_BACKWARD with the JIT's warm-up event
family Jump(target:FarHead)
  exits(jump, raise, redirect, exit)
  ops(JUMP_FORWARD, JUMP_BACKWARD, JUMP_BACKWARD_NO_INTERRUPT);

// The operands are in the order of the old conditional jump words: the
// value in A, the entry in B, the mode in C and the target in D
family BranchTruth(value:Src, fb:Fb<Truth>, mode:Enum<BranchMode>, target:NearHead)
  exits(next, branch, raise, miss, again, redirect)
  ops(POP_JUMP_IF_TRUE, POP_JUMP_IF_FALSE, JUMP_IF_TRUE_OR_POP, JUMP_IF_FALSE_OR_POP)
  events(BRANCH_LEFT, BRANCH_RIGHT);

family BranchNone(value:Src, sense:Bool, target:NearHead)
  exits(next, branch, raise, redirect)
  ops(POP_JUMP_IF_NONE, POP_JUMP_IF_NOT_NONE)
  events(BRANCH_LEFT, BRANCH_RIGHT);

// 1A: numeric and in-place operations, unary protocols

family Binary(dst:Dst, x:Src, y:Src, op:Enum<Numeric>, fb:Fb<Binary>)
  exits(next, raise, miss, again) ops(BINARY_OP);

family Unary(dst:Dst, value:Src, op:Enum<UnaryOp>)
  exits(next, raise) ops(UNARY_NEGATIVE, UNARY_INVERT);

// 1B: value tests and their fused branch consumers

family Compare(dst:Dst, x:Src, y:Src, relation:Enum<Relation>,
               result:Enum<CompareResult>, fb:Fb<Compare>)
  exits(next, raise, miss, again) ops(COMPARE_OP);

family Identity(dst:Dst, x:Src, y:Src, sense:Bool)
  exits(next) ops(IS_OP);

family Contains(dst:Dst, item:Src, container:Src, sense:Bool, fb:Fb<Contains>)
  exits(next, raise, miss, again) ops(CONTAINS_OP);

family TestBranch(x:Src, y:Src, test:Enum<BranchTest>, target:NearHead, sense:Bool,
                  fb:Fb<Compare>)
  exits(next, branch, raise, miss, again) ops(COMPARE_OP, IS_OP, CONTAINS_OP);

// 1D: attribute writes, super and special-method resolution

family AttrWrite(obj:Src, name:Name, value:Maybe<Src>, mode:Enum<WriteMode>,
                 fb:Fb<Attr>)
  exits(next, raise, miss, again) ops(STORE_ATTR);

family SuperLookup(dst:Dst, self_dst:Maybe<Dst>, sup:Src, cls:Src, self:Src,
                   name:Name, mode:Enum<SuperMode>, fb:Fb<Super>)
  exits(next, raise, miss, again) ops(LOAD_SUPER_ATTR);

family SpecialLookup(fn:Dst, self_dst:Maybe<Dst>, obj:Src, which:Enum<Special>)
  exits(next, raise) ops(LOAD_SPECIAL);
