// Family interfaces of Appendix A, "Values, control, arithmetic, and
// lookup" (Add is in add.rop, GetAttr in getattr.rop).  Arms come with
// their batches.  Every instruction has the implicit `site`; no family
// takes its origin as an operand.

enum PollMode(POLL, NO_POLL);
// The four conditional jumps of the old bytecode: the sense of the test and
// whether the jump edge keeps the tested owner (JUMP_IF_x_OR_POP)
enum BranchMode(BRANCH_IF_FALSE, BRANCH_IF_TRUE, BRANCH_KEEP_IF_FALSE, BRANCH_KEEP_IF_TRUE);
enum Relation(LT, LE, EQ, NE, GT, GE);
enum CompareResult(RICH, TRUTH);
enum BranchTest(IDENTITY, CONTAINS, TEST_LT, TEST_LE, TEST_EQ, TEST_NE, TEST_GT,
                TEST_GE);
enum WriteMode(SET, DELETE);
enum SuperMode(SUPER_ATTR, SUPER_METHOD);
enum Special(ENTER, EXIT, AENTER, AEXIT);

// P1: constants, local bindings, saved locals, residual moves, origins

// An origin or legal-entry boundary
family Nop()
  exits(next) ops(NOP);

// The arm is the kind of constant, chosen by the lowering: Pool, the
// code's constant `index`; Small, the immediate int `index`; Common, the
// interpreter root `index`
family Const(dst:Dst, index:U16)
  exits(next) ops(LOAD_CONST, LOAD_SMALL_INT, LOAD_COMMON_CONSTANT);

point Const.Done(current, next_head, clear) keep() spent() defs(dst);

extern helper code_constant(fr:Frame, i:U16) -> O
  effects(reads)
  c _PyRop_CodeConstant as value
  evidence(
    review: "pycore_rop_rows.h: a new owner of the code object's constant i.",
    contract: "The index is in range (the compiler's). A count, no memory, no Python,"
              "no failure.");

extern helper small_int(i:U16) -> O
  effects()
  ensures(result.inline_int(result))
  c _PyRop_SmallInt as value
  evidence(
    review: "pycore_rop_rows.h: the inline int i (LOAD_SMALL_INT's oparg).",
    contract: "Bit arithmetic: no memory, no count, no failure.");

extern helper common_constant(i:U16) -> O
  effects(reads)
  c _PyRop_CommonConstant as value
  evidence(
    review: "pycore_rop_rows.h: a new owner of _PyInterpreterState's common"
            "constant i (LOAD_COMMON_CONSTANT's oparg).",
    contract: "The index is in range. A count of an immortal object: no memory, no"
              "Python, no failure.");

arm Const.Pool inline select(pool)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next)
{
  entry():
    let v:O = code_constant(frame, index);
    publish [dst = v] retire [old(dst)] at Const.Done;
    exit next();
}

arm Const.Small inline select(small)
  effects(writes, releases on (dst))
  feedback()
  exits(next)
  ensures(next.inline_int(dst))
{
  entry():
    let v:O = small_int(index);
    publish [dst = v] retire [old(dst)] at Const.Done;
    exit next();
}

arm Const.Common inline select(common)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next)
{
  entry():
    let v:O = common_constant(index);
    publish [dst = v] retire [old(dst)] at Const.Done;
    exit next();
}

// Locals are homes: a read's source and a write's destination name the
// local's slot, as any operand may.
// A local's binding.  Bound: the compiler proved the local bound.  Checked:
// it may be unbound, which raises UnboundLocalError.
family LocalRead(dst:Dst, local:Src)
  exits(next, raise) ops(LOAD_FAST, LOAD_FAST_CHECK, LOAD_FAST_BORROW);

point LocalRead.Unbound(current, site, pending) keep(local) spent() defs();
point LocalRead.Done(current, next_head, clear) keep(local) spent() defs(dst);

// The local's binding, absent when it is unbound
extern helper local_view(x:Src) -> Maybe<B>
  effects(reads)
  c _PyRop_LocalView as borrow
  evidence(
    review: "pycore_rop_rows.h: the word in the local's home.",
    contract: "One load: no memory, no count, no failure.");

// Whether an optional source operand holds a value: its true edge grants
// present(x), which use, acquire and spends of x require
extern helper present_src(x:Maybe<Src>) -> Bool
  effects(reads)
  test(present(x))
  c _PyRop_SrcPresent as bool
  evidence(
    review: "pycore_rop_rows.h: the word in the operand's home is not NULL.",
    contract: "One load and a comparison: no count, no failure.");

extern helper unbound_local(fr:Frame, x:Src)
  cases(err(e:Err))
  effects(allocates, raises)
  c _PyRop_UnboundLocal as raised
  evidence(
    review: "pycore_rop_rows.h: _PyEval_FormatExcCheckArg(UnboundLocalError) with"
            "the local's name, as LOAD_FAST_CHECK and DELETE_FAST raise it.",
    contract: "Always sets the exception. It allocates the message; no Python.");

arm LocalRead.Bound inline select(bound)
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next)
{
  entry():
    let v:O = dup(use(local));
    publish [dst = v] retire [old(dst)] at LocalRead.Done;
    exit next();
}

arm LocalRead.Checked shared select(checked)
  effects(reads, writes, allocates, raises, releases on (dst))
  feedback()
  exits(next, raise)
{
  entry():
    let m:Maybe<B> = local_view(local);
    branch present(m) -> Bound(), Unbound();
  Bound():
    let v:O = dup(unwrap(m));
    publish [dst = v] retire [old(dst)] at LocalRead.Done;
    exit next();
  Unbound():
    call unbound_local(frame, local) {
      err -> Failed();
    }
  Failed(e:Err):
    exit raise(LocalRead.Unbound, e);
}

// A store.  Store: the value is present.  Restore: the value is a binding
// that SaveLocal took, which may be absent.
family LocalWrite(local:Local, value:Src)
  exits(next) ops(STORE_FAST);

point LocalWrite.Done(current, next_head, clear) keep() spent(value, local) defs(local);

// The saved binding in the value's home, absent or not, taken out of it:
// the home is left vacant
extern helper restore_local(v:Src) -> Maybe<O>
  effects(reads, writes)
  spends(v)
  c _PyRop_RestoreLocal as value
  evidence(
    review: "pycore_rop_rows.h: LOAD_FAST_AND_CLEAR's restore takes the saved"
            "binding out of its temporary.",
    contract: "The value's home is a temporary. Its owner or absence moves out and"
              "the home is left vacant. No count, no Python, no failure.");

arm LocalWrite.Store inline select(store)
  effects(reads, writes, releases on (local), runs_python)
  feedback()
  exits(next)
{
  entry():
    let v:O = acquire(value);
    publish [local = v] retire [spent(value), old(local)] at LocalWrite.Done;
    exit next();
}

arm LocalWrite.Restore shared select(restore)
  effects(reads, writes, releases on (local), runs_python)
  feedback()
  exits(next)
{
  entry():
    let v:Maybe<O> = restore_local(value);
    publish [local = v] retire [old(local)] at LocalWrite.Done;
    exit next();
}

// The comprehension's saved binding: the local's owner, or its absence,
// goes to dst, and the local is left vacant
family SaveLocal(dst:Dst, local:Src)
  exits(next) ops(LOAD_FAST_AND_CLEAR);

point SaveLocal.Done(current, next_head, clear) keep() spent(local) defs(dst);

// The local's binding, absent or not, taken out of its home: the local is
// left vacant
extern helper save_local(x:Src) -> Maybe<O>
  effects(reads, writes)
  spends(x)
  c _PyRop_SaveLocal as value
  evidence(
    review: "pycore_rop_rows.h: LOAD_FAST_AND_CLEAR's take.",
    contract: "The local's owner or absence moves out and the local is left vacant."
              "No count, no Python, no failure.");

arm SaveLocal.Take shared
  effects(reads, writes, releases on (dst))
  feedback()
  exits(next)
{
  entry():
    let v:Maybe<O> = save_local(local);
    publish [dst = v] retire [old(dst)] at SaveLocal.Done;
    exit next();
}

// The local is read for its binding and written vacant
family LocalDelete(local:Local)
  exits(next, raise) ops(DELETE_FAST);

point LocalDelete.Unbound(current, site, pending) keep() spent(local) defs();
point LocalDelete.Done(current, next_head, clear) keep() spent(local) defs(local);

// The local's binding taken out of its home, or UnboundLocalError when it
// is unbound (the home was vacant and stays so)
extern helper delete_local(fr:Frame, x:Local)
  cases(ok(old:O), err(e:Err))
  effects(reads, writes, allocates, raises)
  spends(x)
  c _PyRop_DeleteLocal as value_or_null
  evidence(
    review: "pycore_rop_rows.h: DELETE_FAST: the binding is taken out of the home;"
            "an unbound local raises UnboundLocalError.",
    contract: "The owner, or NULL with the exception set when the local is unbound."
              "It allocates the message; no Python.");

arm LocalDelete.Checked shared
  effects(reads, writes, allocates, raises, releases on (local), runs_python)
  feedback()
  exits(next, raise)
{
  entry():
    call delete_local(frame, local) {
      ok -> Done();
      err -> Failed();
    }
  Done(old:O):
    publish [local = null] retire [old(local), owned(old)] at LocalDelete.Done;
    exit next();
  Failed(e:Err):
    exit raise(LocalDelete.Unbound, e);
}

// A parallel assignment of homes: what translation could not make a
// rename (an edge's residual bindings, staging, a second owner, a
// retirement at its own origin).  The arm is the mode, chosen by the
// lowering through its `select`.  Element i of `srcs` goes to element i of
// `dsts`; `srcs` may be longer, by the sources that Retire closes.
family Move(dsts:Span<Dst>, srcs:Span<Src>)
  exits(next) ops(SWAP, COPY, POP_TOP);

point Move.Done(current, next_head, clear) keep() spent(srcs) defs(dsts);
point Move.Copied(current, next_head, clear) keep(srcs) spent() defs(dsts);

// Every source's owner goes to its destination as if all moved at once: a
// destination is vacant or another pair's source.  A cycle turns through
// one rooted local (_PyRop_ParallelMove).
arm Move.Transfer shared select(transfer)
  effects(reads, writes)
  feedback()
  exits(next)
{
  entry():
    publish [dsts[] = srcs[]] retire [] at Move.Done;
    exit next();
}

// The same, then the sources past the pairs, left vacant, are closed after
// every home is written
arm Move.Retire shared select(retire)
  effects(reads, writes, releases, runs_python)
  feedback()
  exits(next)
{
  entry():
    publish [dsts[] = srcs[]] retire [spent(srcs)] at Move.Done;
    exit next();
}

// Each destination takes a second owner of its source, which keeps its own
arm Move.Copy shared select(copy)
  effects(reads, writes)
  feedback()
  exits(next)
{
  entry():
    publish [dsts[] = dup(srcs[])] retire [] at Move.Copied;
    exit next();
}

// P5: truth, jumps, conditional retention, None branches

family Truth(dst:Dst, value:Src, invert:Bool, fb:Fb<Truth>)
  exits(next, raise, miss, again, redirect) generic(Generic) ops(TO_BOOL, UNARY_NOT);

// Covers backward jumps, so its target is far.  The arm says whether it
// polls: Direct is JUMP_FORWARD and the jumps that must not poll, Poll is
// JUMP_BACKWARD, Warm is JUMP_BACKWARD with the JIT's warm-up event
family Jump(target:FarHead)
  exits(jump, raise, redirect, exit)
  ops(JUMP_FORWARD, JUMP_BACKWARD, JUMP_BACKWARD_NO_INTERRUPT)
  events(JUMP);

// The operands are in the order of the old conditional jump words: the
// value in A, the entry in B, the mode in C and the target in D
family BranchTruth(value:Src, fb:Fb<Truth>, mode:Enum<BranchMode>, target:NearHead)
  exits(next, branch, raise, miss, again, redirect) generic(Generic)
  ops(POP_JUMP_IF_TRUE, POP_JUMP_IF_FALSE, JUMP_IF_TRUE_OR_POP, JUMP_IF_FALSE_OR_POP)
  events(BRANCH_LEFT, BRANCH_RIGHT);

family BranchNone(value:Src, sense:Bool, target:NearHead)
  exits(next, branch, raise, redirect)
  ops(POP_JUMP_IF_NONE, POP_JUMP_IF_NOT_NONE)
  events(BRANCH_LEFT, BRANCH_RIGHT);

// 1B: value tests and their fused branch consumers

family Compare(dst:Dst, x:Src, y:Src, relation:Enum<Relation>,
               result:Enum<CompareResult>, fb:Fb<Compare>)
  exits(next, raise, miss, again) ops(COMPARE_OP);

family Identity(dst:Dst, x:Src, y:Src, sense:Bool)
  exits(next) ops(IS_OP);

family Contains(dst:Dst, item:Src, container:Src, sense:Bool, fb:Fb<Contains>)
  exits(next, raise, miss, again) ops(CONTAINS_OP);

family TestBranch(x:Src, y:Src, test:Enum<BranchTest>, target:NearHead, sense:Bool,
                  fb:Fb<Compare>)
  exits(next, branch, raise, miss, again) ops(COMPARE_OP, IS_OP, CONTAINS_OP);

// 1D: attribute writes, super and special-method resolution

family AttrWrite(obj:Src, name:Name, value:Maybe<Src>, mode:Enum<WriteMode>,
                 fb:Fb<Attr>)
  exits(next, raise, miss, again) ops(STORE_ATTR);

family SuperLookup(dst:Dst, self_dst:Maybe<Dst>, sup:Src, cls:Src, self:Src,
                   name:Name, mode:Enum<SuperMode>, fb:Fb<Super>)
  exits(next, raise, miss, again) ops(LOAD_SUPER_ATTR);

family SpecialLookup(fn:Dst, self_dst:Maybe<Dst>, obj:Src, which:Enum<Special>)
  exits(next, raise) ops(LOAD_SPECIAL);
