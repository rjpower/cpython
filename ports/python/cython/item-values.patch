+/////////////// TupleFromValueArray.proto ///////////////
+//@substitute: tempita
+
+{{for Type in ['Tuple', 'List']}}
+CYTHON_UNUSED static PyObject *__Pyx_Py{{Type}}_FromValueArray(const PyValue *src, Py_ssize_t n); /* proto */
+{{endfor}}
+
+/////////////// TupleFromValueArray ///////////////
+//@substitute: tempita
+
+// A new tuple or list of the n canonical values at src, such as an argument
+// array or a slice of another tuple's or list's items.
+{{for Type in ['Tuple', 'List']}}
+CYTHON_UNUSED static PyObject *__Pyx_Py{{Type}}_FromValueArray(const PyValue *src, Py_ssize_t n) {
+    Py_ssize_t i;
+    PyObject *res = Py{{Type}}_New(n < 0 ? 0 : n);
+    if (unlikely(res == NULL)) return NULL;
+    for (i = 0; i < n; i++) {
+        Py{{Type}}_SET_VALUE(res, i, src[i]);
+    }
+    return res;
+}
+{{endfor}}
