 static PyObject *__Pyx_Coroutine_fail_reduce_ex(PyObject *self, PyObject *arg); /*proto*/
 
+// A method table's METH_O and METH_FASTCALL functions take and return values,
+// and so does tp_iternext.  These define such a function, name, around an
+// object function, impl, which takes self as self_type.
+#define __PYX_VALUE_METH_O(name, impl, self_type)                             \
+    static PyValue name(PyObject *self, PyValue arg) {                       \
+        PyObject *o = PyValue_Object(arg);                                   \
+        if (unlikely(!o)) return PyValue_NULL;                               \
+        return PyValue_FromResult(impl((self_type)self, o));                 \
+    }
+#define __PYX_VALUE_ITERNEXT(name, impl, self_type)                           \
+    static PyValue name(PyObject *self) {                                    \
+        return PyValue_FromResult(impl((self_type)self));                    \
+    }
+// throw(typ[, val[, tb]]): impl reads at most three arguments.
+#define __PYX_VALUE_METH_THROW(name, impl, self_type)                         \
+    static PyValue name(PyObject *self, const PyValue *args, Py_ssize_t nargs) { \
+        PyObject *objs[3];                                                   \
+        Py_ssize_t i;                                                        \
+        for (i = 0; i < nargs && i < 3; i++) {                               \
+            objs[i] = PyValue_Object(args[i]);                               \
+            if (unlikely(!objs[i])) return PyValue_NULL;                     \
+        }                                                                    \
+        return PyValue_FromResult(impl((self_type)self, objs, nargs));       \
+    }
+
