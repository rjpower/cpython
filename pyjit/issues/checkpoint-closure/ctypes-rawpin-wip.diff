+/* A foreign py_object slot stores a real PyObject pointer.  Keep its raw
+   owner separately from value dictionaries, which canonicalize numbers. */
+typedef struct {
+    PyObject_HEAD
+    PyObject *owner;
+} RawPin;
+
+static int
+rawpin_traverse(PyObject *op, visitproc visit, void *arg)
+{
+    Py_VISIT(((RawPin *)op)->owner);
+    return 0;
+}
+
+static int
+rawpin_clear(PyObject *op)
+{
+    Py_CLEAR(((RawPin *)op)->owner);
+    return 0;
+}
+
+static void
+rawpin_dealloc(PyObject *op)
+{
+    PyObject_GC_UnTrack(op);
+    rawpin_clear(op);
+    PyObject_GC_Del(op);
+}
+
+static PyTypeObject RawPin_Type = {
+    PyVarObject_HEAD_INIT(NULL, 0)
+    .tp_name = "_ctypes._RawPin",
+    .tp_basicsize = sizeof(RawPin),
+    .tp_flags = Py_TPFLAGS_DEFAULT | Py_TPFLAGS_HAVE_GC,
+    .tp_traverse = rawpin_traverse,
+    .tp_clear = rawpin_clear,
+    .tp_dealloc = rawpin_dealloc,
+};
+
+static PyObject *
+rawpin_anchor(CDataObject *dst)
+{
+    CDataObject *root = PyCData_GetContainer(dst);
+    if (root == NULL) {
+        return NULL;
+    }
+    if (root->b_raw_pins == NULL) {
+        PyObject *pins = PyDict_New();
+        if (pins == NULL) {
+            return NULL;
+        }
+        if (root->b_raw_pins == NULL) {
+            root->b_raw_pins = pins;
+        }
+        else {
+            Py_DECREF(pins);
+        }
+    }
+    return root->b_raw_pins;
+}
+
+static char *
+rawpin_address(CDataObject *dst, Py_ssize_t offset, int indirect)
+{
+    char *base = dst->b_ptr;
+    if (base == NULL) {
+        PyErr_SetString(PyExc_ValueError, "NULL pointer access");
+        return NULL;
+    }
+    if (indirect) {
+        base = *(char **)base;
+        if (base == NULL) {
+            PyErr_SetString(PyExc_ValueError, "NULL pointer access");
+            return NULL;
+        }
+    }
+    return base + offset;
+}
+
+static PyObject *
+rawpin_set(CDataObject *dst, SETFUNC setfunc, PyObject *value,
+           Py_ssize_t size, Py_ssize_t offset, int indirect)
+{
+    PyObject *pins = rawpin_anchor(dst);
+    if (pins == NULL) {
+        return NULL;
+    }
+    Py_INCREF(pins);
+    for (;;) {
+        char *addr = rawpin_address(dst, offset, indirect);
+        if (addr == NULL) {
+            Py_DECREF(pins);
+            return NULL;
+        }
+        PyObject *key = PyLong_FromVoidPtr(addr);
+        if (key == NULL) {
+            Py_DECREF(pins);
+            return NULL;
+        }
+        PyObject *item = NULL;
+        PyValue item_value;
+        int found = PyDict_GetValue(pins, PyValue_FromObjectBorrow(key),
+                                    &item_value);
+        if (found > 0) {
+            item = PyValue_AsKnownObjectSteal(item_value);
+        }
+        if (found < 0) {
+            Py_DECREF(key);
+            Py_DECREF(pins);
+            return NULL;
+        }
+        if (!found) {
+            RawPin *pin = PyObject_GC_New(RawPin, &RawPin_Type);
+            if (pin == NULL) {
+                Py_DECREF(key);
+                Py_DECREF(pins);
+                return NULL;
+            }
+            pin->owner = NULL;
+            PyObject_GC_Track(pin);
+            if (PyDict_SetValue(pins, PyValue_FromObjectBorrow(key),
+                                PyValue_FromObjectBorrow((PyObject *)pin)) < 0) {
+                Py_DECREF(pin);
+                Py_DECREF(key);
+                Py_DECREF(pins);
+                return NULL;
+            }
+            Py_DECREF(pin);
+            found = PyDict_GetValue(pins, PyValue_FromObjectBorrow(key),
+                                    &item_value);
+            if (found <= 0) {
+                Py_DECREF(key);
+                Py_DECREF(pins);
+                if (!PyErr_Occurred()) {
+                    PyErr_SetString(PyExc_RuntimeError, "raw pin disappeared");
+                }
+                return NULL;
+            }
+            item = PyValue_AsKnownObjectSteal(item_value);
+        }
+        Py_DECREF(key);
+        if (!Py_IS_TYPE(item, &RawPin_Type)) {
+            Py_DECREF(item);
+            Py_DECREF(pins);
+            PyErr_SetString(PyExc_RuntimeError, "invalid raw pin");
+            return NULL;
+        }
+        char *current = rawpin_address(dst, offset, indirect);
+        if (current == NULL) {
+            Py_DECREF(item);
+            Py_DECREF(pins);
+            return NULL;
+        }
+        if (current != addr) {
+            Py_DECREF(item);
+            continue;
+        }
+        PyObject *owner = Py_NewRef(value);
+        PyObject *result = setfunc(current, value, size);
+        assert(result != NULL); /* O_set cannot fail or call Python. */
+        RawPin *pin = (RawPin *)item;
+        PyObject *old = pin->owner;
+        pin->owner = owner;
+        Py_XDECREF(old);
+        Py_DECREF(item);
+        Py_DECREF(pins);
+        return result;
+    }
+}
