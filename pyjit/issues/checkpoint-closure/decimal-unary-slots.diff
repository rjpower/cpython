 #define Dec_UnaryNumberMethod(MPDFUNC) \
-static PyObject *                                           \
-nm_##MPDFUNC(PyObject *self)                                \
-{                                                           \
-    PyObject *result;                                       \
-    PyObject *context;                                      \
-    uint32_t status = 0;                                    \
-                                                            \
-    decimal_state *state = get_module_state_by_def(Py_TYPE(self));   \
-    CURRENT_CONTEXT(state, context);                        \
-    if ((result = dec_alloc(state)) == NULL) {              \
-        return NULL;                                        \
