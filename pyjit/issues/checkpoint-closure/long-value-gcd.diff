+/* Magnitude of a signed word without overflowing on INT64_MIN. */
+static uint64_t
+long_gcd_magnitude(int64_t value)
+{
+    return value < 0 ? 0 - (uint64_t)value : (uint64_t)value;
+}
+
+static PyValue
+long_gcd_words(uint64_t a, uint64_t b)
+{
+    while (b != 0) {
+        uint64_t remainder = a % b;
+        a = b;
+        b = remainder;
+    }
+    return PyValue_FromUInt64(a);
+}
