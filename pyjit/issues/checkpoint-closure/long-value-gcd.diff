+    digit right_digits[_PyLong_WORD_DIGITS];
+    int left_overflow, right_overflow;
+    int64_t left_word = _PyLong_SpanAsInt64AndOverflow(
+        _PyLong_SpanOfValue(left, left_digits), &left_overflow);
+    int64_t right_word = _PyLong_SpanAsInt64AndOverflow(
+        _PyLong_SpanOfValue(right, right_digits), &right_overflow);
+
+    if (!left_overflow && !right_overflow) {
+        return long_gcd_words(long_gcd_magnitude(left_word),
+                              long_gcd_magnitude(right_word));
+    }
+    if (left_overflow && right_overflow) {
+        return long_gcd_heap_values(PyValue_AsKnownObjectBorrow(left),
+                                    PyValue_AsKnownObjectBorrow(right));
+    }
