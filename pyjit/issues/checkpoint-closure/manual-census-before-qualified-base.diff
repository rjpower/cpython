diff --git a/Tools/build/value_ownership.toml b/Tools/build/value_ownership.toml
index cf8dde8ed78..8e731b1c29e 100644
--- a/Tools/build/value_ownership.toml
+++ b/Tools/build/value_ownership.toml
@@ -1135,3 +1135,39 @@ object = "PyObject_CallNoArgs"
 value = "_PyValue_CallNoArgs"
 family = "call"
 reason = "value twin adds PyThreadState * first parameter and returns owned PyValue"
+
+[[manual]]
+object = "PyMapping_GetOptionalItemString"
+value = "_PyValue_MappingGetOptionalItemString"
+family = "item"
+reason = "int plus PyObject ** output becomes _PyStatusValue; keep the C string and mapping alive across lookup"
+
+[[manual]]
+object = "PyIter_NextItem"
+value = "_PyValue_IterNext"
+family = "item"
+reason = "int plus PyObject ** output becomes _PyStatusValue; retain the non-iterator TypeError precheck"
+
+[[manual]]
+object = "_PyMapping_GetOptionalItem2"
+value = "_PyValue_GetOptionalItem"
+family = "item"
+reason = "PyObject * result plus int * status becomes _PyStatusValue; preserve both outputs and absent/error distinction"
+
+[[manual]]
+object = "_PyType_LookupRef"
+value = "_PyType_LookupValue"
+family = "attr"
+reason = "owned PyObject * or NULL becomes _PyStatusValue; own the value result until use or close"
+
+[[manual]]
+object = "_PySuper_Lookup"
+value = "_PySuper_LookupValue"
+family = "attr"
+reason = "owned PyObject * plus method out-flag becomes _PyStatusValue; preserve want_method and unbound-method flag"
+
+[[manual]]
+object = "_PyObject_Call"
+value = "_PyValue_Call"
+family = "call"
+reason = "owned PyObject * result becomes PyValue; preserve existing tstate, assertions and call accounting"
