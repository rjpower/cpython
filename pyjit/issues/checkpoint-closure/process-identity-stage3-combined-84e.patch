+static int
+receipt_write(int fd, const char *text, size_t length)
+{
+    while (length != 0) {
+        ssize_t written = write(fd, text, length);
+        if (written < 0 && errno == EINTR) {
+            continue;
+        }
+        if (written <= 0) {
+            return -1;
+        }
+        text += written;
+        length -= (size_t)written;
+    }
+    return 0;
+}
+
+#define RECEIPT_TEXT(FD, S) receipt_write((FD), (S), strlen(S))
