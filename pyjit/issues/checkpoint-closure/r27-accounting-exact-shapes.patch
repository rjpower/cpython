+/* Keep argv boundaries and control bytes on one marker line. */
+static void
+run_marker_argv(FILE *out, FILE *cmd)
+{
+    fputc('[', out);
+    int c;
+    int open = 0;
+    int first = 1;
+    while ((c = fgetc(cmd)) != EOF) {
+        if (!open) {
+            if (!first) {
+                fputc(',', out);
+            }
+            fputc('"', out);
+            open = 1;
+            first = 0;
+        }
+        if (c == '\0') {
+            fputc('"', out);
+            open = 0;
+        }
+        else if (c == '"' || c == '\\') {
+            fputc('\\', out);
+            fputc(c, out);
+        }
+        else if (c < 0x20 || c >= 0x7f) {
+            fprintf(out, "\\u%04x", c);
+        }
+        else {
+            fputc(c, out);
+        }
+    }
+    if (open) {
+        fputc('"', out);
+    }
+    fputc(']', out);
+}
