+def normalize_accounting_argv(argv, summary):
+    """Normalize the first build product and its explicit stats-dir option."""
+    words = list(argv)
+    build = summary.get("build")
+    executable = None
+    if build:
+        products = {f"{build}/{name}": f"{{BUILD}}/{name}"
+                    for name in ("python", "Programs/_testembed")}
+        for i, arg in enumerate(words):
+            if arg in products:
+                words[i] = products[arg]
+                executable = i
+                break
+    dumps = summary.get("dump_dir")
+    if dumps and executable is not None:
+        for i in range(executable + 1, len(argv)):
+            if argv[i] in ("-c", "-m", "--") or not argv[i].startswith("-"):
+                break
+            if (argv[i] == "-X" and i + 1 < len(argv) and
+                argv[i + 1] == f"pystats_dir={dumps}"):
+                words[i + 1] = "pystats_dir={DUMPS}"
+            elif argv[i] == f"-Xpystats_dir={dumps}":
+                words[i] = "-Xpystats_dir={DUMPS}"
+    return tuple(words)
 
 
