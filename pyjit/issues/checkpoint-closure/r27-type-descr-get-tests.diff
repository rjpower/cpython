+    def test_descriptor_get_inline_and_mutation(self):
+        for value in (17, 1.5):
+            class Descriptor:
+                __get__ = value
+
+            class C:
+                attr = Descriptor()
+
+            with self.subTest(value=value):
+                with self.assertRaisesRegex(TypeError, "object is not callable"):
+                    C().attr
+                del Descriptor.__get__
+                self.assertIsInstance(C().attr, Descriptor)
+
+        class Descriptor:
+            def __get__(self, obj, owner):
+                Descriptor.__get__ = lambda self, obj, owner: 23
+                return 19
+
+        class C:
+            attr = Descriptor()
+
+        self.assertEqual(C().attr, 19)
+        self.assertEqual(C().attr, 23)
+
