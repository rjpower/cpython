+    def test_long_iterator_crosses_integer_representations(self):
+        r = range(2**63, -1, -(2**63))
+        for iterator in (iter(r), reversed(r)):
+            with self.subTest(iterator=iterator):
+                restored = pickle.loads(pickle.dumps(iterator))
+                self.assertEqual(list(iterator), list(restored))
+        for state, expected in ((-4, [2**63, 0]), (1, [0]), (99, [])):
+            with self.subTest(state=state):
+                iterator = iter(r)
+                iterator.__setstate__(state)
+                self.assertEqual(list(iterator), expected)
+
