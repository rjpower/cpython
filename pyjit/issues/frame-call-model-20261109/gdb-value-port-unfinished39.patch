+def _is_pyvalue(gdbval):
+    """Match the owned and borrowed value typedefs, preserving their names."""
+    typ = gdbval.type.unqualified()
+    if typ.name not in ('PyValue', 'PyValueBorrow'):
+        return False
+    layout = typ.strip_typedefs()
+    fields = layout.fields()
+    return (layout.code == gdb.TYPE_CODE_STRUCT and len(fields) == 1
+            and fields[0].name == 'bits' and typ.sizeof == _sizeof_void_p())
+
