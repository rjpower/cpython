+
+        class Receiver:
+            def method(self, value=sentinel, *args, **kwargs):
+                return self, value, args, kwargs
+
+        receiver = Receiver()
+        receiver.method()  # Prepare the callee before checking the overlap path.
+        self.assertEqual(receiver.method(), (receiver, sentinel, (), {}))
