+            return first, second, args, kwargs
+
+        first = target(sentinel)
+        second = target(sentinel)
+        self.assertEqual(first[:3], (sentinel, sentinel, ()))
+        self.assertEqual(first[3], {})
+        self.assertIsNot(first[3], second[3])
